<!-- LIVE SEARCH -->
<!-- Chi su dung script nay, khong tai tour-live-search.js -->

<script>
(function () {
    "use strict";

    function initializeHappyTripLiveSearch() {
        const inputs = Array.from(
            document.querySelectorAll(
                "#happytripHeroSearch, #diadiemInputTop, #diadiemInput"
            )
        );

        const resultBox =
            document.getElementById("happytripSearchResults");

        if (!inputs.length || !resultBox) {
            return;
        }

        let currentInput = null;
        let timer = null;
        let abortController = null;
        let requestId = 0;

        inputs.forEach(input => {
            input.setAttribute("autocomplete", "off");
            input.setAttribute("aria-autocomplete", "list");
            input.setAttribute(
                "aria-controls",
                "happytripSearchResults"
            );
        });

        function positionResults() {
            if (!currentInput ||
                resultBox.style.display === "none") {
                return;
            }

            const rect = currentInput.getBoundingClientRect();

            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;

            const width = Math.min(
                Math.max(rect.width, 310),
                viewportWidth - 20
            );

            const left = Math.max(
                10,
                Math.min(
                    rect.left,
                    viewportWidth - width - 10
                )
            );

            const below = viewportHeight - rect.bottom;
            const openUpwards =
                below < 210 && rect.top > 230;

            resultBox.style.left = `${left}px`;
            resultBox.style.width = `${width}px`;

            if (openUpwards) {
                resultBox.style.top = "auto";
                resultBox.style.bottom =
                    `${viewportHeight - rect.top + 6}px`;

                resultBox.style.maxHeight =
                    `${Math.max(130, rect.top - 15)}px`;
            } else {
                resultBox.style.bottom = "auto";
                resultBox.style.top =
                    `${rect.bottom + 6}px`;

                resultBox.style.maxHeight =
                    `${Math.max(130, below - 15)}px`;
            }
        }

        function showResults() {
            resultBox.style.display = "block";
            positionResults();
        }

        function hideResults() {
            resultBox.style.display = "none";
        }

        function showMessage(message) {
            resultBox.replaceChildren();

            const item = document.createElement("div");
            item.className = "ht-search-message";
            item.textContent = message;

            resultBox.appendChild(item);
            showResults();
        }

        function renderResults(tours) {
            resultBox.replaceChildren();

            if (!Array.isArray(tours) || tours.length === 0) {
                showMessage("Không tìm thấy tour phù hợp.");
                return;
            }

            tours.forEach(tour => {
                const link = document.createElement("a");
                link.className = "ht-search-result";

                link.href = tour.url ||
                    `/Tour/ChiTiet?id=${encodeURIComponent(tour.idTour)}`;

                const imageWrap = document.createElement("span");
                imageWrap.className = "ht-search-result__icon";

                const image = document.createElement("img");
                image.src = tour.hinhAnh || "";
                image.alt = tour.tenTour || "Hình ảnh tour";
                image.loading = "lazy";

                image.onerror = function () {
                    this.onerror = null;
                    this.remove();

                    const fallback = document.createElement("i");
                    fallback.className = "fa-solid fa-image";

                    imageWrap.appendChild(fallback);
                };

                if (tour.hinhAnh) {
                    imageWrap.appendChild(image);
                } else {
                    const fallback = document.createElement("i");
                    fallback.className = "fa-solid fa-image";

                    imageWrap.appendChild(fallback);
                }

                const info = document.createElement("span");
                info.className = "ht-search-result__info";

                const title = document.createElement("strong");
                title.textContent =
                    tour.tenTour || "Tour du lịch";

                const destination = document.createElement("small");
                destination.textContent =
                    tour.diaDiem || "Chưa cập nhật điểm đến";

                info.appendChild(title);
                info.appendChild(destination);

                const price = document.createElement("span");
                price.className = "ht-search-result__price";
                price.textContent = tour.gia || "Liên hệ";

                link.appendChild(imageWrap);
                link.appendChild(info);
                link.appendChild(price);

                resultBox.appendChild(link);
            });

            const footer = document.createElement("div");
            footer.className = "ht-search-footer";
            footer.textContent =
                `${tours.length} gợi ý • Chọn tour để xem chi tiết`;

            resultBox.appendChild(footer);
            showResults();
        }

        async function fetchTours(input, keyword, sequence) {
            const controller = new AbortController();
            abortController = controller;

            try {
                const response = await fetch(
                    "/Tour/GoiYTour?keyword=" +
                    encodeURIComponent(keyword),
                    {
                        method: "GET",
                        signal: controller.signal,
                        cache: "no-store",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const tours = await response.json();

                if (
                    sequence !== requestId ||
                    currentInput !== input ||
                    input.value.trim() !== keyword
                ) {
                    return;
                }

                renderResults(tours);
            } catch (error) {
                if (error.name === "AbortError") {
                    return;
                }

                console.error(
                    "[HappyTrip] Lỗi tìm kiếm tour:",
                    error
                );

                if (sequence === requestId) {
                    showMessage(
                        "Không tải được gợi ý. Vui lòng thử lại."
                    );
                }
            }
        }

        function handleSearchInput(input) {
            currentInput = input;

            clearTimeout(timer);
            abortController?.abort();

            const keyword = input.value.trim();
            const sequence = ++requestId;

            if (!keyword) {
                hideResults();
                return;
            }

            showMessage("Đang tìm tour phù hợp...");

            timer = setTimeout(function () {
                fetchTours(input, keyword, sequence);
            }, 120);
        }

        inputs.forEach(input => {
            input.addEventListener("input", function () {
                handleSearchInput(input);
            });

            input.addEventListener("focus", function () {
                currentInput = input;

                if (input.value.trim()) {
                    handleSearchInput(input);
                }
            });

            input.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    hideResults();
                }
            });
        });

        document.addEventListener("pointerdown", function (event) {
            const clickedInput = inputs.includes(event.target);

            const clickedResults =
                resultBox.contains(event.target);

            if (!clickedInput && !clickedResults) {
                hideResults();
            }
        });

        window.addEventListener(
            "resize",
            positionResults
        );

        window.addEventListener(
            "scroll",
            positionResults,
            true
        );
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initializeHappyTripLiveSearch,
            { once: true }
        );
    } else {
        initializeHappyTripLiveSearch();
    }
})();
</script>
