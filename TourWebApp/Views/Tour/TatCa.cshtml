
@model List<TourWebApp.Data.Models.Tour>
@using TourWebApp.Data.Models
@using TourWebApp.Helpers

@{
    ViewData["Title"] = "Khám phá tour | HappyTrip";

    var lichGanNhat = ViewBag.LichGanNhat
        as Dictionary<int, LichKhoiHanh>;

    var loaiTours = ViewBag.LoaiTours
        as List<LoaiTour> ?? new List<LoaiTour>();

    var phuongTienList = ViewBag.PhuongTienList
        as List<string> ?? new List<string>();

    var wishlistIds = ViewBag.WishlistIds
        as HashSet<int> ?? new HashSet<int>();

    var q = Context.Request.Query;

    var chiConCho =
        q["concho"] == "true" ||
        q["concho"] == "on";

    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;

    var selectedSort = q["sort"].ToString();
    var selectedLoai = q["idLoaiTour"].ToString();

    var selectedChuDe = q["chuDe"]
        .ToString()
        .Trim()
        .ToLowerInvariant();

    var returnUrl =
        $"{Context.Request.Path}{Context.Request.QueryString}";

    var chuDeNames = new Dictionary<string, string>
    {
        ["bien"] = "Biển đảo",
        ["nui"] = "Núi",
        ["vanhoa"] = "Văn hóa",
        ["thanhpho"] = "Thành phố",
        ["khampha"] = "Khám phá"
    };

    var tenChuDe = chuDeNames.TryGetValue(
        selectedChuDe,
        out var tenDaChon
    )
        ? tenDaChon
        : "Tất cả tour";
}

<link rel="stylesheet"
      href="~/css/tour-filter.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/tour-compare.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/tour-listing-premium.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/tour-compare-selection.css"
      asp-append-version="true" />

<style>
    /* LIVE SEARCH */

    #happytripSearchResults {
        position: fixed;
        display: none;
        z-index: 2147483647;
        background: #ffffff;
        border: 1px solid #e0e8de;
        border-radius: 16px;
        box-shadow: 0 18px 48px rgba(25, 54, 35, .20);
        max-height: 380px;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 7px;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    .ht-search-result {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 88px;
        padding: 10px;
        text-decoration: none;
        border-radius: 10px;
        color: #254936;
        transition: background .15s ease;
    }

    .ht-search-result:hover,
    .ht-search-result:focus-visible {
        background: #edf5ec;
        color: #254936;
        text-decoration: none;
        outline: none;
    }

    .ht-search-result__icon {
        width: 88px;
        height: 66px;
        min-width: 88px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf4eb;
        color: #418458;
    }

    .ht-search-result__icon img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .25s ease;
    }

    .ht-search-result:hover .ht-search-result__icon img {
        transform: scale(1.06);
    }

    .ht-search-result__info {
        display: flex;
        flex: 1;
        min-width: 0;
        flex-direction: column;
        gap: 5px;
    }

    .ht-search-result__info strong {
        font-size: 13px;
        line-height: 1.45;
        font-weight: 700;
        white-space: normal;
    }

    .ht-search-result__info small {
        color: #7d8b80;
        font-size: 12px;
        line-height: 1.35;
    }

    .ht-search-result__price {
        flex-shrink: 0;
        color: #a77327;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .ht-search-message {
        padding: 16px 12px;
        color: #687a6e;
        font-size: 13px;
    }

    .ht-search-footer {
        padding: 10px 12px;
        border-top: 1px solid #eef1eb;
        color: #809084;
        font-size: 11px;
    }

    @@media (max-width: 600px) {
        .ht-search-result__icon {
            width: 70px;
            height: 57px;
            min-width: 70px;
        }

        .ht-search-result {
            flex-wrap: wrap;
            gap: 8px;
        }

        .ht-search-result__price {
            margin-left: 78px;
        }
    }
</style>

<div class="tours-container ht-explorer ht-travel-catalog">

    <!-- 01. HERO -->

    <section class="ht-catalog-hero"
             aria-labelledby="htCatalogTitle">

        <div class="ht-catalog-hero-overlay"></div>

        <div class="ht-catalog-hero-inner">

            <span class="ht-catalog-kicker">
                TOUR HAPPYTRIP
            </span>

            <h1 id="htCatalogTitle">
                Tìm chuyến đi dành cho bạn
            </h1>

            <p class="ht-catalog-description">
                Khám phá điểm đến và lựa chọn tour phù hợp
                với sở thích, thời gian và ngân sách.
            </p>

            <form asp-controller="Tour"
                  asp-action="TatCa"
                  method="get"
                  class="ht-catalog-search"
                  role="search">

                <i class="fa-solid fa-magnifying-glass"
                   aria-hidden="true"></i>

                <input type="search"
                       id="happytripHeroSearch"
                       name="diadiem"
                       value="@q["diadiem"]"
                       placeholder="Nhập tên tour hoặc điểm đến..."
                       aria-label="Tìm kiếm tour và điểm đến"
                       autocomplete="off" />

                @if (!string.IsNullOrWhiteSpace(selectedChuDe))
                {
                    <input type="hidden"
                           name="chuDe"
                           value="@selectedChuDe" />
                }

                <button type="submit">

                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Tìm kiếm</span>

                </button>

            </form>

        </div>

    </section>

    <!-- 02. CHU DE -->

    <section class="ht-catalog-categories"
             aria-label="Khám phá theo chủ đề">

        <div class="ht-category-heading">

            <i class="fa-regular fa-compass"></i>
            <strong>Khám phá theo chủ đề:</strong>

        </div>

        <div class="ht-category-list">

            <a href="@BuildCategoryUrl("")"
               class="ht-category-pill @(string.IsNullOrEmpty(selectedChuDe) ? "is-active" : "")">

                <i class="fa-solid fa-border-all"></i>
                Tất cả

            </a>

            <a href="@BuildCategoryUrl("bien")"
               class="ht-category-pill @(selectedChuDe == "bien" ? "is-active" : "")">

                <i class="fa-solid fa-water"></i>
                Biển đảo

            </a>

            <a href="@BuildCategoryUrl("nui")"
               class="ht-category-pill @(selectedChuDe == "nui" ? "is-active" : "")">

                <i class="fa-solid fa-mountain"></i>
                Núi

            </a>

            <a href="@BuildCategoryUrl("vanhoa")"
               class="ht-category-pill @(selectedChuDe == "vanhoa" ? "is-active" : "")">

                <i class="fa-solid fa-landmark"></i>
                Văn hóa

            </a>

            <!-- THANH PHO: DA HOAT DONG -->

            <a href="@BuildCategoryUrl("thanhpho")"
               class="ht-category-pill @(selectedChuDe == "thanhpho" ? "is-active" : "")">

                <i class="fa-solid fa-city"></i>
                Thành phố

            </a>

            <a href="@BuildCategoryUrl("khampha")"
               class="ht-category-pill @(selectedChuDe == "khampha" ? "is-active" : "")">

                <i class="fa-regular fa-compass"></i>
                Khám phá

            </a>

        </div>

    </section>

    <!-- 03. MAIN LAYOUT -->

    <div class="ht-explorer-layout ht-catalog-layout">

        <!-- 04. SIDEBAR FILTER -->

        <aside class="ht-filter-sidebar ht-catalog-sidebar">

            <div class="ht-filter-heading">

                <div>
                    <i class="fa-solid fa-sliders"></i>
                    <strong>Bộ lọc tour</strong>
                </div>

                <a asp-controller="Tour"
                   asp-action="TatCa"
                   class="ht-filter-reset">

                    Xóa lọc

                </a>

            </div>

            <form method="get"
                  asp-controller="Tour"
                  asp-action="TatCa"
                  id="quickFilterForm"
                  class="ht-filter-form">

                @if (!string.IsNullOrWhiteSpace(selectedChuDe))
                {
                    <input type="hidden"
                           name="chuDe"
                           value="@selectedChuDe" />
                }

                <!-- Diem den -->

                <div class="ht-filter-group planner-field planner-field-relative">

                    <label for="diadiemInputTop">

                        <i class="fa-solid fa-location-dot"></i>
                        Điểm đến

                    </label>

                    <input type="text"
                           name="diadiem"
                           id="diadiemInputTop"
                           placeholder="Nhập tên tour hoặc điểm đến..."
                           value="@q["diadiem"]"
                           autocomplete="off" />

                    <div class="autocomplete-box"
                         id="goiYBoxTop"
                         style="display:none"></div>

                </div>

                <!-- Ngay khoi hanh -->

                <div class="ht-filter-group planner-field">

                    <label for="ngaydiTop">

                        <i class="fa-regular fa-calendar-days"></i>
                        Ngày khởi hành

                    </label>

                    <input type="date"
                           id="ngaydiTop"
                           name="ngaydi"
                           value="@q["ngaydi"]" />

                </div>

                <!-- So ngay -->

                <div class="ht-filter-group planner-field">

                    <label for="songayTop">

                        <i class="fa-regular fa-clock"></i>
                        Số ngày

                    </label>

                    <input type="number"
                           id="songayTop"
                           name="songay"
                           min="1"
                           placeholder="Ví dụ: 3"
                           value="@q["songay"]" />

                </div>

                <!-- Loai tour -->

                <div class="ht-filter-group planner-field">

                    <label for="idLoaiTourTop">

                        <i class="fa-solid fa-layer-group"></i>
                        Loại tour

                    </label>

                    <select id="idLoaiTourTop"
                            name="idLoaiTour">

                        <option value="">
                            Tất cả loại tour
                        </option>

                        @foreach (var lt in loaiTours)
                        {
                            <option value="@lt.IdLoaiTour"
                                    selected="@(selectedLoai == lt.IdLoaiTour.ToString())">

                                @lt.TenLoai

                            </option>
                        }

                    </select>

                </div>

                <!-- Phuong tien -->

                <div class="ht-filter-group planner-field">

                    <label for="phuongTienTop">

                        <i class="fa-solid fa-bus-simple"></i>
                        Phương tiện

                    </label>

                    <select id="phuongTienTop"
                            name="phuongtien">

                        <option value="">
                            Tất cả phương tiện
                        </option>

                        @foreach (var pt in phuongTienList)
                        {
                            <option value="@pt"
                                    selected="@(q["phuongtien"] == pt)">

                                @pt

                            </option>
                        }

                    </select>

                </div>

                <!-- Con cho -->

                <div class="ht-filter-group ht-filter-check-group">

                    <label class="ht-filter-check"
                           for="conChoCheckTop">

                        <input type="checkbox"
                               id="conChoCheckTop"
                               name="concho"
                               value="true"
                               checked="@chiConCho" />

                        <span>
                            Chỉ hiển thị tour còn chỗ
                        </span>

                    </label>

                </div>

                <!-- Giu khoang gia -->

                @if (!string.IsNullOrWhiteSpace(q["giamin"]))
                {
                    <input type="hidden"
                           name="giamin"
                           value="@q["giamin"]" />
                }

                @if (!string.IsNullOrWhiteSpace(q["giamax"]))
                {
                    <input type="hidden"
                           name="giamax"
                           value="@q["giamax"]" />
                }

                @if (!string.IsNullOrWhiteSpace(selectedSort))
                {
                    <input type="hidden"
                           name="sort"
                           value="@selectedSort" />
                }

                <button type="submit"
                        class="ht-filter-submit">

                    <i class="fa-solid fa-filter"></i>
                    Lọc kết quả

                </button>

                <button type="button"
                        class="ht-filter-advanced"
                        data-bs-toggle="modal"
                        data-bs-target="#filterModal">

                    <i class="fa-solid fa-sliders"></i>
                    Lọc nâng cao

                </button>

            </form>

        </aside>

        <!-- 05. TOUR RESULTS -->

        <main class="ht-explorer-results ht-catalog-results">

            <div class="ht-results-toolbar">

                <div class="ht-results-title-wrap">

                    <h2>

                        @tenChuDe

                        <span class="ht-results-count">
                            @Model.Count
                        </span>

                    </h2>

                </div>

                <div class="ht-results-actions">

                    <span class="ht-results-page">
                        Trang @currentPage / @Math.Max(1, totalPages)
                    </span>

                    <form method="get"
                          asp-controller="Tour"
                          asp-action="TatCa"
                          class="ht-tour-sort-form"
                          id="tourSortForm">

                        @foreach (var parameter in Context.Request.Query)
                        {
                            if (!string.Equals(
                                    parameter.Key,
                                    "sort",
                                    StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(
                                    parameter.Key,
                                    "page",
                                    StringComparison.OrdinalIgnoreCase))
                            {
                                <input type="hidden"
                                       name="@parameter.Key"
                                       value="@parameter.Value.ToString()" />
                            }
                        }

                        <label for="tourSortSelect">
                            Sắp xếp:
                        </label>

                        <select id="tourSortSelect"
                                name="sort">

                            <option value=""
                                    selected="@(selectedSort == "")">
                                Mặc định
                            </option>

                            <option value="ten"
                                    selected="@(selectedSort == "ten")">
                                Tên tour A–Z
                            </option>

                            <option value="gia_tang"
                                    selected="@(selectedSort == "gia_tang")">
                                Giá thấp đến cao
                            </option>

                            <option value="gia_giam"
                                    selected="@(selectedSort == "gia_giam")">
                                Giá cao đến thấp
                            </option>

                        </select>

                        <button type="submit"
                                class="ht-sort-submit">

                            Áp dụng

                        </button>

                    </form>

                </div>

            </div>

            <!-- KHONG CO KET QUA -->

            @if (Model.Count == 0)
            {
                <div class="ht-results-empty">

                    <i class="fa-regular fa-compass"></i>

                    <h3>
                        Chưa tìm thấy tour phù hợp
                    </h3>

                    @if (selectedChuDe == "thanhpho")
                    {
                        <p>
                            Hiện chưa có tour được gắn
                            chủ đề Thành phố.
                            Bạn có thể khám phá những
                            chủ đề khác của HappyTrip.
                        </p>
                    }
                    else
                    {
                        <p>
                            Bạn thử thay đổi điểm đến,
                            ngày đi hoặc các điều kiện
                            lọc nhé.
                        </p>
                    }

                    <a asp-controller="Tour"
                       asp-action="TatCa">

                        Xem tất cả tour

                    </a>

                </div>
            }
            else
            {
                <!-- TOUR CARDS -->

                <section class="tours-showcase ht-ticket-list">

                    <div class="tour-listing-grid ht-ticket-grid">

                        @{
                            var tourIndex = 0;
                        }

                        @foreach (var t in Model)
                        {
                            var lich = lichGanNhat != null &&
                                lichGanNhat.TryGetValue(
                                    t.IdTour,
                                    out var lichTimDuoc
                                )
                                ? lichTimDuoc
                                : null;

                            var soCho = lich?.SoChoConLai ?? 0;

                            var trangThai = lich == null
                                ? "Chưa có lịch"
                                : soCho <= 0
                                    ? "Hết chỗ"
                                    : soCho <= 5
                                        ? "Sắp hết chỗ"
                                        : "Còn chỗ";

                            var statusClass = lich == null
                                ? "ht-status-pending"
                                : soCho <= 0
                                    ? "ht-status-full"
                                    : soCho <= 5
                                        ? "ht-status-low"
                                        : "ht-status-open";

                            var tenLoai = loaiTours
                                .FirstOrDefault(x =>
                                    x.IdLoaiTour == t.IdLoaiTour)
                                ?.TenLoai ?? "Tour du lịch";

                            var giaHienThi =
                                t.GiaKhuyenMai ?? t.GiaGoc;

                            <article class="tour-card-modern
                                            tour-list-card
                                            ht-tour-card
                                            ht-ticket-card"
                                     style="--stagger:@(tourIndex % 9)">

                                <!-- ANH -->

                                <div class="tour-list-image-wrap
                                            ht-tour-media
                                            ht-ticket-media">

                                    <img src="@TourImagePathHelper.ToTourImageSrc(t.HinhAnh)"
                                         class="tour-list-image"
                                         alt="Hình ảnh tour @t.TenTour"
                                         loading="lazy" />

                                    <form asp-controller="Wishlist"
                                          asp-action="Toggle"
                                          method="post"
                                          class="ht-tour-wishlist">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="idTour"
                                               value="@t.IdTour" />

                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@returnUrl" />

                                        <button type="submit"
                                                class="ht-tour-heart @(wishlistIds.Contains(t.IdTour) ? "is-favorite" : "")"
                                                title="@(wishlistIds.Contains(t.IdTour) ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")"
                                                aria-label="@(wishlistIds.Contains(t.IdTour) ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")">

                                            <i class="fa@(wishlistIds.Contains(t.IdTour) ? "s" : "r") fa-heart"></i>

                                        </button>

                                    </form>

                                    @if (t.PhanTramGiam > 0)
                                    {
                                        <span class="ht-tour-discount">

                                            -@t.PhanTramGiam%

                                        </span>
                                    }

                                </div>

                                <!-- THONG TIN -->

                                <div class="tour-list-body
                                            ht-tour-content
                                            ht-ticket-content">

                                    <div class="ht-ticket-tags">

                                        <span class="ht-ticket-category">

                                            <i class="fa-solid fa-compass"></i>
                                            @tenLoai

                                        </span>

                                        <span class="ht-tour-code">
                                            @t.MaTour
                                        </span>

                                    </div>

                                    <h3 class="tour-list-title ht-tour-title"
                                        title="@t.TenTour">

                                        @t.TenTour

                                    </h3>

                                    <div class="ht-tour-information
                                                ht-ticket-information">

                                        <div class="ht-tour-info">

                                            <i class="fa-solid fa-location-dot"></i>

                                            <span title="@t.DiaDiem">

                                                @(string.IsNullOrWhiteSpace(t.DiaDiem)
                                                    ? "Chưa cập nhật"
                                                    : t.DiaDiem)

                                            </span>

                                        </div>

                                        <div class="ht-tour-info">

                                            <i class="fa-regular fa-clock"></i>

                                            <span>

                                                @(string.IsNullOrWhiteSpace(t.ThoiGian)
                                                    ? "Theo lịch tour"
                                                    : t.ThoiGian)

                                            </span>

                                        </div>

                                        <div class="ht-tour-info">

                                            <i class="fa-solid fa-bus-simple"></i>

                                            <span>

                                                @(string.IsNullOrWhiteSpace(t.PhuongTien)
                                                    ? "Chưa cập nhật"
                                                    : t.PhuongTien)

                                            </span>

                                        </div>

                                    </div>

                                </div>

                                <!-- GIA VA HANH DONG -->

                                <div class="ht-ticket-booking">

                                    <span class="ht-tour-status @statusClass">

                                        @trangThai

                                    </span>

                                    <div class="ht-ticket-price">

                                        <span>
                                            Giá từ / khách
                                        </span>

                                        <strong>

                                            @(giaHienThi.HasValue
                                                ? string.Format(
                                                    "{0:N0}đ",
                                                    giaHienThi.Value)
                                                : "Liên hệ")

                                        </strong>

                                    </div>

                                    <div class="ht-ticket-actions">

                                        <a asp-controller="Tour"
                                           asp-action="ChiTiet"
                                           asp-route-id="@t.IdTour"
                                           class="tour-link-detail ht-tour-detail">

                                            Khám phá tour

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </a>

                                        <button type="button"
                                                class="compare-toggle-btn ht-tour-compare"
                                                data-tour-id="@t.IdTour"
                                                aria-pressed="false">

                                            <i class="fa-solid fa-code-compare"></i>

                                            <span>
                                                Thêm so sánh
                                            </span>

                                        </button>

                                    </div>

                                </div>

                            </article>

                            tourIndex++;
                        }

                    </div>

                </section>
            }

            <!-- 07. PHAN TRANG -->

            @if (totalPages > 1)
            {
                <nav class="ht-tour-pagination"
                     aria-label="Phân trang tour">

                    @if (currentPage > 1)
                    {
                        <a class="ht-page-button ht-page-arrow"
                           href="@BuildPageUrl(currentPage - 1)"
                           aria-label="Trang trước">

                            <i class="fa-solid fa-arrow-left"></i>

                        </a>
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a class="ht-page-button @(i == currentPage ? "ht-page-active" : "")"
                           href="@BuildPageUrl(i)"
                           aria-label="Trang @i"
                           aria-current="@(i == currentPage ? "page" : null)">

                            @i

                        </a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a class="ht-page-button ht-page-arrow"
                           href="@BuildPageUrl(currentPage + 1)"
                           aria-label="Trang tiếp theo">

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>
                    }

                </nav>
            }

        </main>

    </div>

    <!-- 08. MODAL LOC NANG CA -->

    <div class="modal fade"
         id="filterModal"
         tabindex="-1"
         aria-labelledby="filterModalTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content rounded-4 ht-filter-modal">

                <div class="modal-header">

                    <h5 id="filterModalTitle"
                        class="modal-title fw-bold">

                        <i class="fa-solid fa-sliders"></i>
                        Bộ lọc nâng cao

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>

                </div>

                <form method="get"
                      asp-controller="Tour"
                      asp-action="TatCa"
                      id="filterForm">

                    @if (!string.IsNullOrWhiteSpace(selectedChuDe))
                    {
                        <input type="hidden"
                               name="chuDe"
                               value="@selectedChuDe" />
                    }

                    <div class="modal-body">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label class="form-label fw-semibold"
                                       for="diadiemInput">

