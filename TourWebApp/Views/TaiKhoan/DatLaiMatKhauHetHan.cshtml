
@{
    ViewData["Title"] = "Liên kết không còn hiệu lực - HappyTrip";
}

<style>
    /* =============================================
       HAPPYTRIP - RESET LINK EXPIRED
       ============================================= */

    .ht-expired-page,
    .ht-expired-page *,
    .ht-expired-page *::before,
    .ht-expired-page *::after {
        box-sizing: border-box;
    }

    .ht-expired-page {
        width: 100%;
        min-height: calc(100vh - 80px);
        min-height: calc(100dvh - 80px);
        padding: 20px 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        isolation: isolate;
        overflow: hidden;

        background:
            radial-gradient(
                ellipse at 90% 5%,
                rgba(207, 232, 191, .55),
                transparent 38%
            ),
            linear-gradient(
                120deg,
                #fdfefb 0%,
                #f9fbf5 53%,
                #eef5e7 100%
            );

        font-family: "Be Vietnam Pro", Arial, sans-serif;
    }

    .ht-expired-shell {
        width: min(1010px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(30px, 6vw, 86px);
        align-items: center;
        position: relative;
        z-index: 1;
    }

    /* LEFT - TRAVEL INTRO */

    .ht-expired-story {
        min-width: 0;
        position: relative;
        padding: 20px 0 50px;
    }

    .ht-expired-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 46px;
        color: #09683c;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -1.2px;
        text-decoration: none;
    }

    .ht-expired-brand i {
        color: #efb82c;
        font-size: 24px;
        transform: rotate(-12deg);
    }

    .ht-expired-story h1 {
        margin: 0;
        color: #263f30;
        font-size: clamp(31px, 3.8vw, 48px);
        line-height: 1.32;
        font-weight: 500;
        letter-spacing: -1.2px;
    }

    .ht-expired-story h1 strong {
        display: block;
        margin-top: 4px;
        color: #097442;
        font-size: clamp(43px, 5vw, 64px);
        font-weight: 800;
        line-height: 1.14;
        letter-spacing: -2.5px;
    }

    .ht-expired-story h1 span {
        display: block;
        color: #164b35;
        font-size: clamp(27px, 3vw, 38px);
        font-weight: 650;
    }

    .ht-expired-story-line {
        width: 145px;
        height: 5px;
        margin: 15px 0 23px 88px;
        background: #efbd34;
        border-radius: 100%;
        transform: rotate(-6deg);
    }

    .ht-expired-description {
        margin: 0 0 25px;
        color: #54705a;
        font-size: 13px;
        line-height: 1.9;
    }

    .ht-expired-benefits {
        display: flex;
        align-items: flex-start;
        gap: 24px;
    }

    .ht-expired-benefit {
        color: #2e6144;
        text-align: center;
        font-size: 11px;
        line-height: 1.7;
        font-weight: 500;
    }

    .ht-expired-benefit i {
        display: block;
        margin-bottom: 9px;
        color: #13774a;
        font-size: 22px;
    }

    .ht-expired-landscape {
        position: absolute;
        z-index: -1;
        left: -5%;
        bottom: -65px;
        width: 108%;
        opacity: .55;
        pointer-events: none;
    }

    /* RIGHT - EXPIRED CARD */

    .ht-expired-card {
        width: 100%;
        min-width: 0;
        padding: 35px 35px 32px;
        border: 1px solid #e4ecdf;
        border-radius: 24px;
        background: #fffefa;
        box-shadow: 0 20px 60px rgba(25, 78, 44, .09);
        text-align: center;
    }

    .ht-expired-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 66px;
        height: 66px;
        margin: 0 auto 17px;
        border-radius: 20px;
        background: #fff2da;
        color: #c18b29;
        font-size: 29px;
    }

    .ht-expired-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 11px;
        color: #a47925;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .7px;
    }

    .ht-expired-card h2 {
        margin: 0 0 12px;
        color: #155239;
        font-size: 24px;
        font-weight: 800;
        line-height: 1.45;
    }

    .ht-expired-subtitle {
        margin: 0;
        color: #718574;
        font-size: 12px;
        line-height: 1.9;
    }

    .ht-expired-explanation {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin: 25px 0 22px;
        padding: 15px;
        border: 1px solid #e5eddc;
        border-radius: 12px;
        background: #f4f8ef;
        text-align: left;
        color: #48644d;
        font-size: 12px;
        line-height: 1.9;
    }

    .ht-expired-explanation i {
        flex-shrink: 0;
        margin-top: 5px;
        color: #27824d;
        font-size: 16px;
    }

    .ht-expired-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 47px;
        padding: 11px 17px;
        border: none;
        border-radius: 24px;
        background: linear-gradient(100deg, #1b854e, #096a3b);
        color: #ffffff;
        font: 800 12px "Be Vietnam Pro", Arial, sans-serif;
        text-decoration: none;
        box-shadow: 0 5px 13px rgba(21, 110, 65, .14);
        transition: transform .2s, box-shadow .2s;
    }

    .ht-expired-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 9px 18px rgba(21, 110, 65, .18);
        color: #ffffff;
        text-decoration: none;
    }

    .ht-expired-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 19px;
        color: #18734a;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
    }

    .ht-expired-back:hover {
        text-decoration: underline;
    }

    /* SHORT LAPTOP SCREENS */

    @@media (min-width: 901px) and (max-height: 720px) {
        .ht-expired-page {
            padding: 10px 20px;
        }

        .ht-expired-brand {
            margin-bottom: 22px;
        }

        .ht-expired-story {
            padding: 10px 0 28px;
        }

        .ht-expired-card {
            padding: 24px 29px;
        }

        .ht-expired-icon {
            width: 53px;
            height: 53px;
            margin-bottom: 11px;
            font-size: 23px;
        }

        .ht-expired-explanation {
            margin: 17px 0;
        }
    }

    /* TABLET */

    @@media (max-width: 900px) {
        .ht-expired-page {
            min-height: calc(100dvh - 75px);
            padding: 25px 15px;
            align-items: flex-start;
            overflow: visible;
        }

        .ht-expired-shell {
            display: block;
            max-width: 480px;
        }

        .ht-expired-story {
            display: none;
        }

        .ht-expired-card {
            padding: 28px 25px;
        }
    }

    /* MOBILE */

    @@media (max-width: 480px) {
        .ht-expired-page {
            padding: 14px 10px 28px;
        }

        .ht-expired-card {
            padding: 25px 19px;
            border-radius: 18px;
        }

        .ht-expired-card h2 {
            font-size: 21px;
        }
    }
</style>

<div class="ht-expired-page">

    <div class="ht-expired-shell">

        <!-- LEFT: HAPPYTRIP -->

        <section class="ht-expired-story">

            <a href="/" class="ht-expired-brand">
                <i class="fa-solid fa-paper-plane"></i>
                HappyTrip
            </a>

            <h1>
                Hành trình
                <strong>Việt Nam</strong>
                <span>luôn chờ bạn.</span>
            </h1>

            <div class="ht-expired-story-line"></div>

            <p class="ht-expired-description">
                Bảo vệ thông tin tài khoản để bạn
                luôn an tâm trên mỗi hành trình.<br>
                HappyTrip sẵn sàng đồng hành cùng bạn.
            </p>

            <div class="ht-expired-benefits">

                <div class="ht-expired-benefit">
                    <i class="fa-solid fa-shield-halved"></i>
                    Bảo mật tài khoản
                </div>

                <div class="ht-expired-benefit">
                    <i class="fa-regular fa-clock"></i>
                    Liên kết 15 phút
                </div>

                <div class="ht-expired-benefit">
                    <i class="fa-solid fa-route"></i>
                    Tiếp tục hành trình
                </div>

            </div>

            <svg class="ht-expired-landscape"
                 viewBox="0 0 550 160"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true">

                <path d="M0 120 L75 48 L115 82 L175 26
                         L248 105 L300 58 L353 102
                         L425 32 L505 92 L550 66
                         L550 160 L0 160 Z"
                      fill="#b5d5bf"
                      opacity=".45" />

                <path d="M0 137 L88 85 L158 115
                         L243 66 L308 123 L390 80
                         L458 120 L550 92
                         L550 160 L0 160 Z"
                      fill="#7db395"
                      opacity=".45" />

                <path d="M0 150 Q80 108 150 140
                         Q235 108 312 146
                         Q410 108 550 142
                         L550 160 L0 160 Z"
                      fill="#4c966b"
                      opacity=".37" />

            </svg>

        </section>

        <!-- RIGHT: EXPIRED MESSAGE -->

        <section class="ht-expired-card">

            <div class="ht-expired-icon">
                <i class="fa-solid fa-link-slash"></i>
            </div>

            <div class="ht-expired-label">
                <i class="fa-solid fa-circle-exclamation"></i>
                LIÊN KẾT KHÔNG HỢP LỆ
            </div>

            <h2>
                Liên kết không còn hiệu lực
            </h2>

            <p class="ht-expired-subtitle">
                Rất tiếc, liên kết đặt lại mật khẩu này
                không thể tiếp tục sử dụng.
            </p>

            <div class="ht-expired-explanation">

                <i class="fa-solid fa-circle-info"></i>

                <span>
                    Liên kết có thể đã <strong>hết hạn sau 15 phút</strong>,
                    đã được sử dụng hoặc không hợp lệ.
                    Để bảo vệ tài khoản, vui lòng yêu cầu
                    một liên kết khôi phục mới.
                </span>

            </div>

            <a asp-controller="TaiKhoan"
               asp-action="QuenMatKhau"
               class="ht-expired-submit">

                <i class="fa-solid fa-envelope"></i>
                YÊU CẦU LIÊN KẾT MỚI

            </a>

            <a asp-controller="TaiKhoan"
               asp-action="DangNhap"
               class="ht-expired-back">

                <i class="fa-solid fa-arrow-left"></i>
                Quay lại đăng nhập

            </a>

        </section>

    </div>

</div>
