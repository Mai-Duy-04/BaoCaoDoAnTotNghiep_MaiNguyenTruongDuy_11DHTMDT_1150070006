
@{
    ViewData["Title"] = "Đăng nhập - HappyTrip";

    string returnUrl = ViewBag.ReturnUrl as string ?? "";
    string thongBaoLoi = ViewBag.ThongBao as string ?? "";
}

<style>
    /* ============================================
       HAPPYTRIP - LOGIN
       ============================================ */

    .ht-login-page,
    .ht-login-page *,
    .ht-login-page *::before,
    .ht-login-page *::after {
        box-sizing: border-box;
    }

    .ht-login-page {
        width: 100%;
        min-height: calc(100vh - 80px);
        min-height: calc(100dvh - 80px);
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        isolation: isolate;
        overflow: hidden;

        background:
            radial-gradient(
                ellipse at 92% 5%,
                rgba(209, 234, 194, .58),
                transparent 37%
            ),
            linear-gradient(
                120deg,
                #fdfefa 0%,
                #fafbf5 53%,
                #edf5e7 100%
            );

        font-family: "Be Vietnam Pro", Arial, sans-serif;
    }

    .ht-login-shell {
        width: min(1020px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(28px, 6vw, 86px);
        align-items: center;
        position: relative;
        z-index: 1;
    }

    /* LEFT - HAPPYTRIP STORY */

    .ht-login-story {
        min-width: 0;
        position: relative;
        padding: 20px 0 50px;
    }

    .ht-login-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 48px;
        color: #09683c;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -1.2px;
        text-decoration: none;
    }

    .ht-login-brand i {
        color: #efb82c;
        font-size: 24px;
        transform: rotate(-12deg);
    }

    .ht-login-story h1 {
        margin: 0;
        color: #263f30;
        font-size: clamp(31px, 3.8vw, 49px);
        line-height: 1.32;
        font-weight: 500;
        letter-spacing: -1.2px;
    }

    .ht-login-story h1 strong {
        display: block;
        margin-top: 4px;
        color: #097442;
        font-size: clamp(43px, 5vw, 65px);
        font-weight: 800;
        line-height: 1.14;
        letter-spacing: -2.5px;
    }

    .ht-login-story h1 span {
        display: block;
        color: #164b35;
        font-size: clamp(27px, 3vw, 39px);
        font-weight: 650;
    }

    .ht-login-story-line {
        width: 148px;
        height: 5px;
        margin: 15px 0 23px 90px;
        border-radius: 100%;
        background: #f0bd33;
        transform: rotate(-6deg);
    }

    .ht-login-description {
        margin: 0 0 25px;
        color: #54705a;
        font-size: 13px;
        line-height: 1.9;
    }

    .ht-login-benefits {
        display: flex;
        align-items: flex-start;
        gap: 23px;
    }

    .ht-login-benefit {
        color: #2e6144;
        font-size: 11px;
        line-height: 1.7;
        text-align: center;
        font-weight: 500;
    }

    .ht-login-benefit i {
        display: block;
        margin-bottom: 9px;
        color: #13774a;
        font-size: 22px;
    }

    .ht-login-landscape {
        position: absolute;
        left: -5%;
        bottom: -65px;
        width: 108%;
        opacity: .55;
        z-index: -1;
        pointer-events: none;
    }

    /* RIGHT - LOGIN CARD */

    .ht-login-card {
        width: 100%;
        min-width: 0;
        padding: 34px 36px 31px;
        border: 1px solid #e4ecdf;
        border-radius: 24px;
        background: #fffefa;
        box-shadow: 0 20px 60px rgba(25, 78, 44, .09);
    }

    .ht-login-icon {
        width: 59px;
        height: 59px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 19px;
        background: #e8f3e6;
        color: #16804b;
        font-size: 25px;
    }

    .ht-login-card h2 {
        margin: 0 0 8px;
        color: #155239;
        font-size: 25px;
        font-weight: 800;
        text-align: center;
    }

    .ht-login-subtitle {
        margin: 0 0 23px;
        color: #728575;
        font-size: 12px;
        line-height: 1.8;
        text-align: center;
    }

    /* INPUT */

    .ht-login-field {
        margin-bottom: 17px;
    }

    .ht-login-field label {
        display: block;
        margin-bottom: 8px;
        color: #355741;
        font-size: 12px;
        font-weight: 700;
    }

    .ht-login-input-wrap {
        position: relative;
    }

    .ht-login-input-icon {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 46px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid #dce9d8;
        border-radius: 10px 0 0 10px;
        background: #eef5ea;
        color: #18754a;
        pointer-events: none;
        font-size: 15px;
    }

    .ht-login-input-wrap input {
        display: block;
        width: 100%;
        height: 47px;
        padding: 0 43px 0 57px;
        margin: 0;
        border: 1px solid #d9e4d8;
        border-radius: 10px;
        outline: none;
        background: #ffffff;
        color: #254c37;
        font: 12px "Be Vietnam Pro", Arial, sans-serif;
    }

    .ht-login-input-wrap input:focus {
        border-color: #268653;
        box-shadow: 0 0 0 3px rgba(38, 134, 83, .1);
    }

    .ht-login-input-wrap input::placeholder {
        color: #9ca99f;
    }

    .ht-login-eye {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        width: 34px;
        height: 34px;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: #8a9b8e;
        cursor: pointer;
        font-size: 14px;
    }

    .ht-login-eye:hover {
        background: #f0f5ef;
        color: #187546;
    }

    .ht-login-options {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        margin: 5px 0 21px;
    }

    .ht-login-options a {
        color: #187449;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    .ht-login-options a:hover {
        text-decoration: underline;
    }

    .ht-login-error {
        padding: 11px 13px;
        margin: 0 0 15px;
        border-radius: 9px;
        background: #fff0ec;
        color: #a53d38;
        font-size: 11px;
        line-height: 1.7;
    }

    /* SUBMIT */

    .ht-login-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        height: 46px;
        border: 0;
        border-radius: 24px;
        background: linear-gradient(100deg, #1b854e, #096a3b);
        color: #fff;
        font: 800 12px "Be Vietnam Pro", Arial, sans-serif;
        cursor: pointer;
        box-shadow: 0 5px 13px rgba(21, 110, 65, .14);
    }

    .ht-login-submit:hover {
        background: #086137;
    }

    .ht-login-submit:disabled {
        opacity: .65;
        cursor: wait;
    }

    .ht-login-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0 17px;
        color: #9ba99b;
        font-size: 11px;
        text-align: center;
    }

    .ht-login-divider::before,
    .ht-login-divider::after {
        content: "";
        height: 1px;
        flex: 1;
        background: #e0e8de;
    }

    .ht-login-register {
        color: #718574;
        font-size: 12px;
        text-align: center;
    }

    .ht-login-register a {
        color: #087140;
        font-weight: 800;
        text-decoration: none;
    }

    .ht-login-register a:hover {
        text-decoration: underline;
    }

    /* RESPONSIVE */

    @@media (min-width: 901px) and (max-height: 720px) {
        .ht-login-page {
            padding: 10px 20px;
        }

        .ht-login-story {
            padding: 10px 0 28px;
        }

        .ht-login-brand {
            margin-bottom: 25px;
        }

        .ht-login-card {
            padding: 23px 29px;
        }

        .ht-login-icon {
            width: 45px;
            height: 45px;
            margin-bottom: 9px;
            font-size: 20px;
        }

        .ht-login-subtitle {
            margin-bottom: 14px;
        }

        .ht-login-options {
            margin-bottom: 13px;
        }

        .ht-login-divider {
            margin: 14px 0;
        }
    }

    @@media (max-width: 900px) {
        .ht-login-page {
            min-height: calc(100dvh - 75px);
            padding: 24px 15px;
            align-items: flex-start;
            overflow: visible;
        }

        .ht-login-shell {
            display: block;
            max-width: 480px;
        }

        .ht-login-story {
            display: none;
        }

        .ht-login-card {
            padding: 28px 25px;
        }
    }

    @@media (max-width: 480px) {
        .ht-login-page {
            padding: 13px 10px 28px;
        }

        .ht-login-card {
            padding: 24px 18px;
            border-radius: 18px;
        }

        .ht-login-card h2 {
            font-size: 22px;
        }
    }
</style>

<div class="ht-login-page">

    <div class="ht-login-shell">

        <!-- LEFT: HAPPYTRIP -->

        <section class="ht-login-story">

            <a href="/" class="ht-login-brand">
                <i class="fa-solid fa-paper-plane"></i>
                HappyTrip
            </a>

            <h1>
                Khám phá
                <strong>Việt Nam</strong>
                <span>cùng HappyTrip</span>
            </h1>

            <div class="ht-login-story-line"></div>

            <p class="ht-login-description">
                Đăng nhập để tiếp tục khám phá,
                đặt tour và lưu giữ những chuyến đi đáng nhớ.
            </p>

            <div class="ht-login-benefits">

                <div class="ht-login-benefit">
                    <i class="fa-solid fa-suitcase-rolling"></i>
                    Tour đa dạng
                </div>

                <div class="ht-login-benefit">
                    <i class="fa-solid fa-tags"></i>
                    Ưu đãi hấp dẫn
                </div>

                <div class="ht-login-benefit">
                    <i class="fa-solid fa-shield-halved"></i>
                    An toàn &amp; tin cậy
                </div>

            </div>

            <svg class="ht-login-landscape"
                 viewBox="0 0 550 160"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true">

                <path d="M0 120 L75 48 L115 82 L175 26
                         L248 105 L300 58 L353 102
                         L425 32 L505 92 L550 66
                         L550 160 L0 160 Z"
                      fill="#b5d5bf" opacity=".45" />

                <path d="M0 137 L88 85 L158 115
                         L243 66 L308 123 L390 80
                         L458 120 L550 92
                         L550 160 L0 160 Z"
                      fill="#7db395" opacity=".45" />

                <path d="M0 150 Q80 108 150 140
                         Q235 108 312 146
                         Q410 108 550 142
                         L550 160 L0 160 Z"
                      fill="#4c966b" opacity=".37" />

            </svg>

        </section>

        <!-- RIGHT: LOGIN FORM -->

        <section class="ht-login-card">

            <div class="ht-login-icon">
                <i class="fa-solid fa-right-to-bracket"></i>
            </div>

            <h2>Chào mừng trở lại</h2>

            <p class="ht-login-subtitle">
                Đăng nhập để tiếp tục hành trình
                cùng HappyTrip.
            </p>

            @if (!string.IsNullOrWhiteSpace(thongBaoLoi))
            {
                <div class="ht-login-error" role="alert">
                    @thongBaoLoi
                </div>
            }

            <form id="htLoginForm"
                  asp-controller="TaiKhoan"
                  asp-action="DangNhap"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@returnUrl" />

                <!-- EMAIL -->
                <div class="ht-login-field">

                    <label for="Email">
                        Địa chỉ email
                    </label>

                    <div class="ht-login-input-wrap">

                        <span class="ht-login-input-icon">
                            <i class="fa-regular fa-envelope"></i>
                        </span>

                        <input type="email"
                               id="Email"
                               name="Email"
                               placeholder="Nhập email đăng nhập"
                               autocomplete="email"
                               maxlength="100"
                               required />

                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="ht-login-field">

                    <label for="MatKhau">
                        Mật khẩu
                    </label>

                    <div class="ht-login-input-wrap">

                        <span class="ht-login-input-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>

                        <input type="password"
                               id="MatKhau"
                               name="MatKhau"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                id="htLoginToggle"
                                class="ht-login-eye"
                                aria-label="Hiện mật khẩu">
                            <i class="fa-regular fa-eye"></i>
                        </button>

                    </div>
                </div>

                <!-- FORGOT PASSWORD -->
                <div class="ht-login-options">

                    <a asp-controller="TaiKhoan"
                       asp-action="QuenMatKhau">
                        Quên mật khẩu?
                    </a>

                </div>

                <!-- SUBMIT -->
                <button type="submit"
                        id="htLoginSubmit"
                        class="ht-login-submit">

                    <i class="fa-solid fa-right-to-bracket"></i>
                    ĐĂNG NHẬP

                </button>

                <div class="ht-login-divider">
                    Hoặc
                </div>

                <div class="ht-login-register">

                    Chưa có tài khoản?

                    <a asp-controller="TaiKhoan"
                       asp-action="DangKy">
                        Đăng ký ngay
                    </a>

                </div>

            </form>

        </section>

    </div>

</div>

<script>
    (function () {
        "use strict";

        const toggle = document.getElementById(
            "htLoginToggle"
        );

        const password = document.getElementById(
            "MatKhau"
        );

        const form = document.getElementById(
            "htLoginForm"
        );

        const submit = document.getElementById(
            "htLoginSubmit"
        );

        if (toggle && password) {
            toggle.addEventListener("click", function () {
                const show = password.type === "password";

                password.type = show
                    ? "text"
                    : "password";

                const icon = this.querySelector("i");

                if (icon) {
                    icon.className = show
                        ? "fa-regular fa-eye-slash"
                        : "fa-regular fa-eye";
                }

                this.setAttribute(
                    "aria-label",
                    show ? "Ẩn mật khẩu" : "Hiện mật khẩu"
                );
            });
        }

        if (form && submit) {
            form.addEventListener("submit", function () {
                if (!form.checkValidity()) return;

                submit.disabled = true;
                submit.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> ' +
                    'ĐANG ĐĂNG NHẬP...';
            });
        }
    })();
</script>
