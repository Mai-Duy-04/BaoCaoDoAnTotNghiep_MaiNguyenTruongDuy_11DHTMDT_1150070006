
@{
    ViewData["Title"] = "Quên mật khẩu - HappyTrip";

    bool daGuiYeuCau =
        ViewBag.ThongBaoThanhCong != null;

    string thongBaoLoi =
        ViewBag.ThongBao as string ?? "";

    string thongBaoThanhCong =
        ViewBag.ThongBaoThanhCong as string ?? "";
}

<style>
    /* =============================================
       HAPPYTRIP - FORGOT PASSWORD
       ============================================= */

    .ht-forgot-page,
    .ht-forgot-page *,
    .ht-forgot-page *::before,
    .ht-forgot-page *::after {
        box-sizing: border-box;
    }

    .ht-forgot-page {
        --ht-green: #09683c;
        --ht-deep: #164b35;
        --ht-muted: #748778;

        width: 100%;
        min-height: calc(100vh - 80px);
        min-height: calc(100dvh - 80px);
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        isolation: isolate;
        overflow: hidden;

        background:
            radial-gradient(
                ellipse at 90% 5%,
                rgba(209, 233, 192, .55),
                transparent 37%
            ),
            linear-gradient(
                120deg,
                #fdfefb 0%,
                #f9fbf5 53%,
                #edf5e8 100%
            );

        font-family: "Be Vietnam Pro", Arial, sans-serif;
    }

    .ht-forgot-page::before {
        content: "";
        position: absolute;
        top: -100px;
        right: -90px;
        width: 270px;
        height: 270px;
        background: #d9edc8;
        filter: blur(80px);
        opacity: .55;
        pointer-events: none;
    }

    .ht-forgot-shell {
        width: min(1020px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(28px, 6vw, 90px);
        align-items: center;
        position: relative;
        z-index: 1;
    }

    /* =============================================
       LEFT - TRAVEL STORY
       ============================================= */

    .ht-forgot-story {
        position: relative;
        min-width: 0;
        padding: 25px 0 55px;
    }

    .ht-forgot-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 54px;
        color: #09683c;
        text-decoration: none;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -1.2px;
    }

    .ht-forgot-brand i {
        color: #edb526;
        font-size: 25px;
        transform: rotate(-12deg);
    }

    .ht-forgot-story h1 {
        margin: 0;
        color: #263f30;
        font-size: clamp(32px, 3.8vw, 49px);
        line-height: 1.3;
        letter-spacing: -1.2px;
        font-weight: 500;
    }

    .ht-forgot-story h1 strong {
        display: block;
        margin-top: 4px;
        color: #097442;
        font-size: clamp(44px, 5vw, 66px);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -2.5px;
    }

    .ht-forgot-story h1 span {
        display: block;
        font-size: clamp(27px, 3vw, 39px);
        color: #164b35;
        font-weight: 650;
    }

    .ht-forgot-story-line {
        width: 150px;
        height: 5px;
        margin: 15px 0 25px 90px;
        border-radius: 100%;
        background: #f0bd33;
        transform: rotate(-6deg);
    }

    .ht-forgot-description {
        margin: 0 0 26px;
        color: #54705a;
        font-size: 13px;
        line-height: 1.9;
    }

    .ht-forgot-benefits {
        display: flex;
        gap: 25px;
    }

    .ht-forgot-benefit {
        color: #2e6144;
        font-size: 11px;
        text-align: center;
        line-height: 1.7;
        font-weight: 500;
    }

    .ht-forgot-benefit i {
        display: block;
        margin-bottom: 9px;
        color: #13774a;
        font-size: 22px;
    }

    .ht-forgot-landscape {
        position: absolute;
        z-index: -1;
        left: -5%;
        bottom: -70px;
        width: 107%;
        opacity: .58;
        pointer-events: none;
    }

    /* =============================================
       RIGHT - FORM CARD
       ============================================= */

    .ht-forgot-card {
        width: 100%;
        min-width: 0;
        padding: 38px 37px 34px;
        border: 1px solid #e4ecdf;
        border-radius: 24px;
        background: rgba(255, 254, 250, .98);
        box-shadow: 0 20px 60px rgba(25, 78, 44, .09);
        position: relative;
    }

    .ht-forgot-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        border-radius: 20px;
        background: #e8f3e6;
        color: #16804b;
        font-size: 28px;
    }

    .ht-forgot-icon.success {
        background: #ddf3e3;
        color: #16804b;
    }

    .ht-forgot-card h2 {
        margin: 0 0 12px;
        color: #155239;
        font-size: 26px;
        font-weight: 800;
        text-align: center;
        letter-spacing: -.5px;
    }

    .ht-forgot-subtitle {
        margin: 0 0 27px;
        color: #728575;
        font-size: 12px;
        line-height: 1.9;
        text-align: center;
    }

    .ht-forgot-field {
        margin-bottom: 18px;
    }

    .ht-forgot-field label {
        display: block;
        margin-bottom: 9px;
        color: #355741;
        font-size: 12px;
        font-weight: 700;
    }

    .ht-forgot-input-wrap {
        position: relative;
    }

    .ht-forgot-input-icon {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 49px;
        border: 1px solid #dce9d8;
        border-radius: 11px 0 0 11px;
        background: #eef5ea;
        color: #18754a;
        font-size: 16px;
        pointer-events: none;
    }

    .ht-forgot-input-wrap input {
        display: block;
        width: 100%;
        height: 49px;
        padding: 0 15px 0 61px;
        border: 1px solid #d9e4d8;
        border-radius: 11px;
        background: #ffffff;
        outline: none;
        color: #254c37;
        font: 12px "Be Vietnam Pro", Arial, sans-serif;
        transition: border-color .2s, box-shadow .2s;
    }

    .ht-forgot-input-wrap input:focus {
        border-color: #268653;
        box-shadow: 0 0 0 3px rgba(38, 134, 83, .1);
    }

    .ht-forgot-input-wrap input::placeholder {
        color: #9ca99f;
    }

    .ht-forgot-error {
        margin: 0 0 17px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fff0ec;
        color: #a53d38;
        font-size: 12px;
        line-height: 1.7;
    }

    .ht-forgot-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 48px;
        border: 0;
        border-radius: 25px;
        background: linear-gradient(
            100deg,
            #1b854e,
            #096a3b
        );
        color: #ffffff;
        font: 800 12px "Be Vietnam Pro", Arial, sans-serif;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
        box-shadow: 0 5px 13px rgba(21, 110, 65, .14);
    }

    .ht-forgot-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 9px 19px rgba(21, 110, 65, .19);
    }

    .ht-forgot-submit:disabled {
        opacity: .65;
        cursor: wait;
        transform: none;
    }

    .ht-forgot-back {
        display: flex;
        justify-content: center;
        gap: 8px;
        align-items: center;
        margin-top: 25px;
        color: #18734a;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
    }

    .ht-forgot-back:hover {
        text-decoration: underline;
    }

    /* SUCCESS */

    .ht-forgot-success-message {
        padding: 17px;
        background: #ebf6e9;
        border: 1px solid #d5e9d3;
        border-radius: 12px;
        color: #2c6142;
        font-size: 13px;
        line-height: 1.9;
        text-align: center;
    }

    .ht-forgot-success-message strong {
        color: #126842;
    }

    .ht-forgot-success-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-top: 21px;
        padding: 14px;
        background: #fff7e5;
        border-radius: 10px;
        color: #82642a;
        font-size: 11px;
        line-height: 1.8;
    }

    .ht-forgot-success-note i {
        margin-top: 4px;
        color: #c59629;
        font-size: 15px;
    }

    /* RESPONSIVE */

    @@media (min-width: 901px) and (max-height: 720px) {
        .ht-forgot-page {
            padding: 10px 22px;
        }

        .ht-forgot-brand {
            margin-bottom: 22px;
        }

        .ht-forgot-story {
            padding: 10px 0 25px;
        }

        .ht-forgot-story h1 {
            font-size: 37px;
        }

        .ht-forgot-story h1 strong {
            font-size: 53px;
        }

        .ht-forgot-card {
            padding: 25px 31px;
        }

        .ht-forgot-icon {
            width: 52px;
            height: 52px;
            margin-bottom: 12px;
            font-size: 23px;
        }

        .ht-forgot-subtitle {
            margin-bottom: 17px;
        }
    }

    @@media (max-width: 900px) {
        .ht-forgot-page {
            min-height: calc(100dvh - 75px);
            align-items: flex-start;
            padding: 30px 15px;
            overflow: visible;
        }

        .ht-forgot-shell {
            display: block;
            max-width: 490px;
        }

        .ht-forgot-story {
            display: none;
        }

        .ht-forgot-card {
            padding: 30px 25px;
        }
    }

    @@media (max-width: 480px) {
        .ht-forgot-page {
            padding: 17px 10px 30px;
        }

        .ht-forgot-card {
            padding: 25px 19px;
            border-radius: 18px;
        }

        .ht-forgot-card h2 {
            font-size: 23px;
        }
    }
</style>

<div class="ht-forgot-page">

    <div class="ht-forgot-shell">

        <!-- LEFT - HAPPYTRIP STORY -->

        <section class="ht-forgot-story">

            <a href="/" class="ht-forgot-brand">
                <i class="fa-solid fa-paper-plane"></i>
                HappyTrip
            </a>

            <h1>
                Hành trình
                <strong>Việt Nam</strong>
                <span>luôn chờ bạn.</span>
            </h1>

            <div class="ht-forgot-story-line"></div>

            <p class="ht-forgot-description">
                Đừng để việc quên mật khẩu làm gián đoạn
                hành trình khám phá của bạn.<br>
                HappyTrip sẽ giúp bạn trở lại thật dễ dàng.
            </p>

            <div class="ht-forgot-benefits">

                <div class="ht-forgot-benefit">
                    <i class="fa-solid fa-shield-halved"></i>
                    Bảo mật tài khoản
                </div>

                <div class="ht-forgot-benefit">
                    <i class="fa-regular fa-envelope"></i>
                    Xác minh qua email
                </div>

                <div class="ht-forgot-benefit">
                    <i class="fa-solid fa-route"></i>
                    Tiếp tục hành trình
                </div>

            </div>

            <svg class="ht-forgot-landscape"
                 viewBox="0 0 550 160"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true">

                <path d="M0 120 L75 48 L115 82 L175 26
                         L248 105 L300 58 L353 102
                         L425 32 L505 92 L550 66
                         L550 160 L0 160 Z"
                      fill="#b5d5bf"
                      opacity=".45" />

                <path d="M0 137 L88 85 L158 115
                         L243 66 L308 123 L390 80
                         L458 120 L550 92
                         L550 160 L0 160 Z"
                      fill="#7db395"
                      opacity=".45" />

                <path d="M0 150 Q80 108 150 140
                         Q235 108 312 146
                         Q410 108 550 142
                         L550 160 L0 160 Z"
                      fill="#4c966b"
                      opacity=".37" />

            </svg>

        </section>

        <!-- RIGHT - FORM -->

        <section class="ht-forgot-card">

            @if (daGuiYeuCau)
            {
                <!-- SUCCESS STATE -->

                <div class="ht-forgot-icon success">
                    <i class="fa-solid fa-envelope-circle-check"></i>
                </div>

                <h2>Kiểm tra email của bạn</h2>

                <p class="ht-forgot-subtitle">
                    Yêu cầu khôi phục tài khoản đã được ghi nhận.
                </p>

                <div class="ht-forgot-success-message"
                     role="status">

                    @thongBaoThanhCong

                </div>

                <div class="ht-forgot-success-note">
                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Nếu nhận được email,
                        hãy mở liên kết xác minh
                        trong vòng <strong>15 phút</strong>.
                        Liên kết chỉ được sử dụng một lần.
                    </span>
                </div>

                <a asp-controller="TaiKhoan"
                   asp-action="DangNhap"
                   class="ht-forgot-back">

                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại đăng nhập

                </a>
            }
            else
            {
                <!-- REQUEST STATE -->

                <div class="ht-forgot-icon">
                    <i class="fa-solid fa-lock-open"></i>
                </div>

                <h2>Quên mật khẩu?</h2>

                <p class="ht-forgot-subtitle">
                    Nhập địa chỉ email đã đăng ký với HappyTrip.<br>
                    Chúng mình sẽ gửi hướng dẫn đặt lại mật khẩu.
                </p>

                @if (!string.IsNullOrWhiteSpace(thongBaoLoi))
                {
                    <div class="ht-forgot-error"
                         role="alert">

                        @thongBaoLoi

                    </div>
                }

                <form id="htForgotForm"
                      asp-controller="TaiKhoan"
                      asp-action="QuenMatKhau"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="ht-forgot-field">

                        <label for="Email">
                            Địa chỉ email
                        </label>

                        <div class="ht-forgot-input-wrap">

                            <span class="ht-forgot-input-icon">
                                <i class="fa-regular fa-envelope"></i>
                            </span>

                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   placeholder="Nhập email của bạn"
                                   autocomplete="email"
                                   maxlength="100"
                                   required
                                   autofocus />

                        </div>

                    </div>

                    <button type="submit"
                            id="htForgotSubmit"
                            class="ht-forgot-submit">

                        <i class="fa-solid fa-paper-plane"></i>
                        GỬI LIÊN KẾT KHÔI PHỤC

                    </button>

                </form>

                <a asp-controller="TaiKhoan"
                   asp-action="DangNhap"
                   class="ht-forgot-back">

                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại đăng nhập

                </a>
            }

        </section>

    </div>

</div>

<script>
    (function () {
        "use strict";

        const form = document.getElementById("htForgotForm");
        const button = document.getElementById("htForgotSubmit");

        if (!form || !button) return;

        form.addEventListener("submit", function () {
            if (!form.checkValidity()) return;

            button.disabled = true;

            button.innerHTML =
                '<i class="fa-solid fa-spinner fa-spin"></i> ' +
                "ĐANG GỬI YÊU CẦU...";
        });
    })();
</script>
