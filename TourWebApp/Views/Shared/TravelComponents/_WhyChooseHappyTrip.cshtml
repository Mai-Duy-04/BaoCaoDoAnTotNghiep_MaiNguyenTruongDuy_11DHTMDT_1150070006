
@* =========================================================
   HAPPYTRIP - WHY CHOOSE US
   Phong cach Travel Scrapbook
   Doc lap voi CSS cac section khac
   ========================================================= *@

<section class="htwhy-section"
         aria-labelledby="htwhy-title">

    <div class="htwhy-container">

        <!-- HEADER -->
        <div class="htwhy-header">

            <div class="htwhy-eyebrow">
                <span class="htwhy-rays" aria-hidden="true">✦</span>
                VÌ SAO CHỌN HAPPYTRIP
                <span class="htwhy-rays" aria-hidden="true">✦</span>
            </div>

            <h2 id="htwhy-title">
                Du lịch nhẹ nhàng,
                <span>trải nghiệm trọn vẹn</span>
            </h2>

            <p>
                Từ tìm kiếm đến đặt tour, tất cả đều dễ dàng,
                tiện lợi và luôn có Tripi AI đồng hành.
            </p>

            <!-- DECORATIVE FLIGHT PATH -->
            <div class="htwhy-flight htwhy-flight-left"
                 aria-hidden="true">
                <i class="fa-solid fa-location-dot"></i>

                <svg viewBox="0 0 190 65"
                     fill="none">
                    <path d="M2 39 C45 7 67 68 110 34 S154 20 188 44"
                          stroke="#16816B"
                          stroke-width="2"
                          stroke-dasharray="6 8"
                          stroke-linecap="round" />
                </svg>
            </div>

            <div class="htwhy-flight htwhy-flight-right"
                 aria-hidden="true">

                <svg viewBox="0 0 190 65"
                     fill="none">
                    <path d="M2 40 C40 68 75 8 115 36 S150 55 188 15"
                          stroke="#16816B"
                          stroke-width="2"
                          stroke-dasharray="6 8"
                          stroke-linecap="round" />
                </svg>

                <i class="fa-solid fa-plane"></i>
            </div>

        </div>

        <!-- BENEFIT CARDS -->
        <div class="htwhy-grid">

            <!-- CARD 01 -->
            <article class="htwhy-card htwhy-card-one">

                <span class="htwhy-number">01</span>

                <div class="htwhy-icon htwhy-icon-green">
                    <i class="fa-regular fa-calendar-check"
                       aria-hidden="true"></i>
                </div>

                <h3>Lịch trình tối ưu</h3>

                <p>
                    Mỗi lịch trình được HappyTrip thiết kế rõ ràng,
                    cân bằng giữa tham quan, nghỉ ngơi
                    và trải nghiệm thực tế.
                </p>

                <div class="htwhy-landscape"
                     aria-hidden="true">

                    <svg viewBox="0 0 350 100"
                         preserveAspectRatio="none">

                        <path d="M0 78 Q65 34 132 82 T350 53 V100 H0Z"
                              fill="#E3EFD7"/>

                        <path d="M90 100 L175 25 L230 100Z"
                              fill="#7CB77B"/>

                        <path d="M150 100 L248 13 L350 100Z"
                              fill="#2F8966"/>

                        <path d="M218 39 L248 13 L276 43 L251 36 L239 45Z"
                              fill="#FFF6D9"/>

                        <path d="M139 56 L175 25 L202 60 L176 51 L166 61Z"
                              fill="#FCE6A2"/>

                    </svg>

                </div>

            </article>

            <!-- CARD 02 -->
            <article class="htwhy-card htwhy-card-two">

                <span class="htwhy-number">02</span>

                <div class="htwhy-icon htwhy-icon-yellow">
                    <i class="fa-solid fa-person-walking-luggage"
                       aria-hidden="true"></i>
                </div>

                <h3>Hướng dẫn viên bản địa</h3>

                <p>
                    Đội ngũ hướng dẫn viên giàu kinh nghiệm,
                    am hiểu địa phương và luôn đồng hành
                    xuyên suốt chuyến đi.
                </p>

                <div class="htwhy-landscape"
                     aria-hidden="true">

                    <svg viewBox="0 0 350 100"
                         preserveAspectRatio="none">

                        <path d="M0 72 Q80 45 150 78 T350 70 V100 H0Z"
                              fill="#FFF0CB"/>

                        <path d="M0 91 Q92 58 175 92 T350 79 V100 H0Z"
                              fill="#E4ECCB"/>

                        <path d="M245 28 V94"
                              stroke="#946B39"
                              stroke-width="7"
                              stroke-linecap="round"/>

                        <path d="M205 36 L292 29 L278 47 L205 53Z"
                              fill="#DE9A47"/>

                        <path d="M287 56 L212 57 L225 72 L287 70Z"
                              fill="#C67B38"/>

                        <path d="M250 28 V18"
                              stroke="#946B39"
                              stroke-width="6"/>

                    </svg>

                </div>

                <span class="htwhy-leaf-decoration"
                      aria-hidden="true">🌿</span>

            </article>

            <!-- CARD 03 -->
            <article class="htwhy-card htwhy-card-three">

                <span class="htwhy-number">03</span>

                <div class="htwhy-icon htwhy-icon-green">
                    <i class="fa-solid fa-ticket"
                       aria-hidden="true"></i>
                </div>

                <h3>Đặt tour linh hoạt</h3>

                <p>
                    Tư vấn theo nhu cầu thực tế,
                    hỗ trợ đổi lịch hợp lý và minh bạch
                    mọi chi phí trước khi xác nhận.
                </p>

                <div class="htwhy-landscape"
                     aria-hidden="true">

                    <svg viewBox="0 0 350 100"
                         preserveAspectRatio="none">

                        <path d="M0 80 Q73 38 139 74 T350 62 V100 H0Z"
                              fill="#E3EED8"/>

                        <path d="M0 94 Q76 67 150 89 T350 79 V100 H0Z"
                              fill="#CBDFAF"/>

                    </svg>

                </div>

                <span class="htwhy-card-sticker htwhy-camera"
                      aria-hidden="true">
                    <i class="fa-solid fa-camera"></i>
                </span>

            </article>

            <!-- CARD 04 -->
            <article class="htwhy-card htwhy-card-four">

                <span class="htwhy-number">04</span>

                <div class="htwhy-icon htwhy-icon-yellow">
                    <i class="fa-solid fa-headset"
                       aria-hidden="true"></i>
                </div>

                <h3>Hỗ trợ nhanh 24/7</h3>

                <p>
                    Từ lúc lên kế hoạch đến khi kết thúc
                    hành trình, HappyTrip luôn sẵn sàng
                    hỗ trợ khi bạn cần.
                </p>

                <div class="htwhy-landscape"
                     aria-hidden="true">

                    <svg viewBox="0 0 350 100"
                         preserveAspectRatio="none">

                        <path d="M0 83 Q85 51 155 80 T350 68 V100 H0Z"
                              fill="#E3EFD5"/>

                        <path d="M135 100 L245 30 L350 100Z"
                              fill="#65AB7A"/>

                        <path d="M211 100 L290 48 L350 100Z"
                              fill="#318965"/>

                        <path d="M221 45 L245 30 L265 46 L247 42 L240 49Z"
                              fill="#FFF5CE"/>

                    </svg>

                </div>

            </article>

        </div>

    </div>

</section>

<style>
    /* =========================================
       HAPPYTRIP - WHY CHOOSE US
       Scoped CSS
       ========================================= */

    .htwhy-section,
    .htwhy-section * {
        box-sizing: border-box;
    }

    .htwhy-section {
        position: relative;
        isolation: isolate;
        width: 100%;
        padding: 65px 0 75px;
        overflow: hidden;
        background:
            radial-gradient(
                circle at 3% 78%,
                rgba(222, 236, 207, .35),
                transparent 22%
            ),
            radial-gradient(
                circle at 96% 80%,
                rgba(226, 239, 208, .4),
                transparent 23%
            ),
            #fffaf3;
    }

    .htwhy-container {
        width: min(1340px, calc(100% - 64px));
        margin-inline: auto;
    }

    /* HEADER */

    .htwhy-header {
        position: relative;
        max-width: 1150px;
        margin: 0 auto 48px;
        text-align: center;
    }

    .htwhy-eyebrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        margin-bottom: 19px;
        color: #075947;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 14px;
        font-weight: 850;
        letter-spacing: .12em;
    }

    .htwhy-rays {
        color: #f0b52c;
        font-size: 21px;
    }

    .htwhy-header h2 {
        margin: 0;
        color: #183e34;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(31px, 3.4vw, 49px);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -.025em;
        text-wrap: balance;
    }

    .htwhy-header h2 span {
        display: inline;
        position: relative;
        white-space: normal;
    }

    .htwhy-header h2 span::after {
        position: absolute;
        right: 2%;
        bottom: -9px;
        width: 36%;
        height: 6px;
        border-radius: 50%;
        background: #f5bb34;
        transform: rotate(-2deg);
        content: "";
    }

    .htwhy-header > p {
        max-width: 750px;
        margin: 22px auto 0;
        color: #57675e;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.75;
    }

    /* FLIGHT DECORATIONS */

    .htwhy-flight {
        position: absolute;
        top: 74px;
        display: flex;
        align-items: center;
        color: #eeb52d;
        pointer-events: none;
    }

    .htwhy-flight svg {
        width: 145px;
        height: 55px;
    }

    .htwhy-flight-left {
        left: -72px;
    }

    .htwhy-flight-left i {
        font-size: 28px;
    }

    .htwhy-flight-right {
        right: -75px;
    }

    .htwhy-flight-right i {
        color: #26835e;
        font-size: 34px;
        transform: rotate(-28deg);
    }

    /* GRID */

    .htwhy-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        align-items: stretch;
        gap: 20px;
    }

    /* CARDS */

    .htwhy-card {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 330px;
        padding: 32px 25px 90px;
        overflow: hidden;

        border: 3px solid #fff;
        border-radius: 30px;

        background: linear-gradient(
            160deg,
            #fffefd 0%,
            #fffaf2 100%
        );

        box-shadow:
            0 14px 26px rgba(66, 59, 40, .09),
            0 3px 6px rgba(66, 59, 40, .03);

        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }

    .htwhy-card:hover {
        transform: translateY(-8px);
        box-shadow:
            0 22px 36px rgba(66, 59, 40, .14);
    }

    .htwhy-card-one {
        transform: rotate(-1deg);
    }

    .htwhy-card-two {
        transform: rotate(1deg);
    }

    .htwhy-card-three {
        transform: rotate(-.7deg);
    }

    .htwhy-card-four {
        transform: rotate(.8deg);
    }

    .htwhy-card:hover {
        transform: translateY(-8px) rotate(0deg);
    }

    /* NUMBER STICKERS */

    .htwhy-number {
        position: absolute;
        top: 23px;
        right: 23px;
        z-index: 3;

        display: grid;
        place-items: center;

        width: 48px;
        height: 40px;

        border-radius: 11px 12px 9px 12px;
        background: #ffe8a8;
        color: #435424;

        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 21px;
        font-weight: 850;

        transform: rotate(-12deg);
    }

    .htwhy-card-two .htwhy-number,
    .htwhy-card-four .htwhy-number {
        transform: rotate(9deg);
    }

    /* ICONS */

    .htwhy-icon {
        display: grid;
        place-items: center;
        width: 62px;
        height: 62px;
        margin-bottom: 18px;
        border-radius: 50%;
        color: #075d4a;
        font-size: 27px;
        line-height: 1;
    }
    .htwhy-icon-green {
        background: #e5f0d8;
    }

    .htwhy-icon-yellow {
        background: #ffe8aa;
    }

    /* TEXT */

    .htwhy-card h3 {
        position: relative;
        z-index: 2;

        margin: 0 0 13px;

        color: #114739;

        font-family: "Segoe UI", Arial, sans-serif;
        font-size: clamp(19px, 1.55vw, 23px);
        font-weight: 800;
        line-height: 1.3;
        letter-spacing: -.025em;
    }

    .htwhy-card p {
        position: relative;
        z-index: 2;

        margin: 0;

        color: #4f5d56;

        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.8;
    }

    /* LANDSCAPE */

    .htwhy-landscape {
        position: absolute;
        right: 0;
        bottom: -2px;
        left: 0;
        z-index: 1;

        height: 100px;
        overflow: hidden;
        pointer-events: none;
    }

    .htwhy-landscape svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .htwhy-leaf-decoration {
        position: absolute;
        top: -9px;
        right: 78px;
        z-index: 2;

        font-size: 29px;
        transform: rotate(-25deg);
        pointer-events: none;
    }

    .htwhy-card-sticker {
        position: absolute;
        z-index: 3;

        display: grid;
        place-items: center;

        color: #177c66;
        pointer-events: none;
    }

    .htwhy-camera {
        right: 24px;
        bottom: 22px;

        width: 58px;
        height: 53px;

        border: 4px solid #fff;
        border-radius: 13px;
        background: #f5c24f;
        color: #166d5a;

        font-size: 27px;

        box-shadow: 0 5px 11px rgba(45, 70, 47, .1);
        transform: rotate(13deg);
    }

    /* RESPONSIVE - LAPTOP */

    @@media (max-width: 285px) {
        .htwhy-grid {
            gap: 15px;
        }

        .htwhy-card {
            min-height: 330px;
            padding: 27px 20px 86px;
        }

        .htwhy-card h3 {
            font-size: 19px;
        }

        .htwhy-card p {
            font-size: 12px;
        }

        .htwhy-flight {
            opacity: .5;
        }
    }

    /* RESPONSIVE - TABLET */

    @@media (max-width: 270px) {
        .htwhy-section {
            padding: 52px 0 62px;
        }

        .htwhy-container {
            width: calc(100% - 40px);
        }

        .htwhy-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .htwhy-card {
            min-height: 305px;
        }

        .htwhy-card h3 {
            font-size: 22px;
        }

        .htwhy-card p {
            font-size: 14px;
        }

        .htwhy-flight {
            display: none;
        }
    }

    /* RESPONSIVE - MOBILE */

    @@media (max-width: 575px) {
        .htwhy-section {
            padding: 42px 0 50px;
        }

        .htwhy-container {
            width: calc(100% - 28px);
        }

        .htwhy-header {
            margin-bottom: 32px;
        }

        .htwhy-eyebrow {
            gap: 9px;
            font-size: 10px;
            letter-spacing: .08em;
        }

        .htwhy-rays {
            font-size: 16px;
        }

        .htwhy-header h2 {
            font-size: clamp(28px, 7vw, 36px);
            line-height: 1.26;
        }

        .htwhy-header > p {
            margin-top: 18px;
            font-size: 13px;
        }

        .htwhy-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .htwhy-card {
            min-height: 270px;
            padding: 27px 24px 85px;
            border-radius: 25px;
            transform: none !important;
        }

        .htwhy-card h3 {
            font-size: 21px;
        }

        .htwhy-card p {
            max-width: 350px;
            font-size: 13px;
        }

        .htwhy-icon {
            width: 65px;
            height: 65px;
            margin-bottom: 18px;
            font-size: 27px;
        }

        .htwhy-number {
            width: 43px;
            height: 36px;
            font-size: 18px;
        }

        .htwhy-card:hover {
            transform: translateY(-4px) !important;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .htwhy-card {
            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 285px;
            padding: 24px 20px 75px;
            overflow: hidden;

            border: 3px solid #fff;
            border-radius: 24px;

            background: linear-gradient(
                160deg,
                #fffefd 0%,
                #fffaf2 100%
            );

            box-shadow:
                0 12px 24px rgba(66, 59, 40, .09);

            transition:
                transform .3s ease,
                box-shadow .3s ease;
        }

        .htwhy-card:hover {
            transform: none;
        }
    }
</style>
