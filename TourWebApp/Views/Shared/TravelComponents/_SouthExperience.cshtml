        </div>

        <span class="htse-floating-star htse-floating-star-one"
              aria-hidden="true">✦</span>

        <span class="htse-floating-star htse-floating-star-two"
              aria-hidden="true">✧</span>

        <span class="htse-floating-star htse-floating-star-three"
              aria-hidden="true">✦</span>

    </div>

    <!-- TRANG TRÍ NỀN DƯỚI -->
    <div class="htse-bottom-wave"
         aria-hidden="true"></div>

</section>

<style>
    /* =============================================
       HAPPYTRIP - SOUTH EXPERIENCE
       ============================================= */

    .htse-section,
    .htse-section * {
        box-sizing: border-box;
    }

    .htse-section {
        position: relative;
        isolation: isolate;
        padding: 58px 0 72px;
        overflow: hidden;
        background:
            radial-gradient(
                ellipse at 3% 95%,
                rgba(209, 226, 177, .25),
                transparent 40%
            ),
            #fff9ef;
    }

    .htse-container {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 49%) minmax(0, 51%);
        align-items: center;
        gap: 16px;
        width: min(1320px, calc(100% - 60px));
        min-height: 390px;
        margin: 0 auto;
    }

    /* =============================================
       PHOTO COLLAGE
       ============================================= */

    .htse-collage {
        position: relative;
        width: 100%;
        height: 375px;
        min-width: 0;
    }

    .htse-photo {
        position: absolute;
        padding: 9px 9px 17px;
        border: 1px solid #eee7dc;
        border-radius: 17px;
        background: #fff;
        box-shadow:
            0 14px 25px rgba(43, 65, 42, .16);
        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }

    .htse-photo img {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 10px;
        object-fit: cover;
    }

    .htse-photo-back {
        z-index: 1;
        top: 36px;
        left: 5%;
        width: 44%;
        height: 268px;
        transform: rotate(-9deg);
    }

    .htse-photo-main {
        z-index: 2;
        top: 21px;
        left: 43%;
        width: 51%;
        height: 270px;
        transform: rotate(6deg);
    }

    .htse-photo-front {
        z-index: 3;
        left: 29%;
        bottom: 12px;
        width: 39%;
        height: 159px;
        padding: 7px 7px 13px;
        transform: rotate(9deg);
    }

    .htse-photo-back:hover {
        transform: translateY(-8px) rotate(-6deg);
    }

    .htse-photo-main:hover {
        transform: translateY(-8px) rotate(3deg);
    }

    .htse-photo-front:hover {
        transform: translateY(-8px) rotate(5deg);
    }

    /* BĂNG KEO GIẤY */

    .htse-tape {
        position: absolute;
        z-index: 5;
        top: -13px;
        left: 24%;
        width: 77px;
        height: 24px;
        background:
            repeating-linear-gradient(
                125deg,
                rgba(255,255,255,.14) 0 4px,
                transparent 4px 10px
            ),
            #F4C666;
        clip-path: polygon(
            0 9%, 100% 0,
            97% 91%, 3% 100%
        );
        transform: rotate(-8deg);
    }

    .htse-photo-main .htse-tape {
        left: auto;
        right: 12%;
        transform: rotate(8deg);
    }

    /* STICKER */

    .htse-leaves {
        position: absolute;
        top: 15px;
        left: 0;
        z-index: 4;
        font-size: 39px;
        transform: rotate(-24deg);
    }

    .htse-camera {
        position: absolute;
        right: 17%;
        bottom: 20px;
        z-index: 5;
        display: grid;
        place-items: center;
        width: 72px;
        height: 62px;
        border: 5px solid #fff;
        border-radius: 15px;
        background: #F8C551;
        color: #087159;
        font-size: 33px;
        box-shadow: 0 7px 14px rgba(0,0,0,.15);
        transform: rotate(-13deg);
    }

    .htse-collage-star {
        position: absolute;
        z-index: 5;
        color: #ECAA22;
        pointer-events: none;
        animation: htseTwinkle 3s ease-in-out infinite;
    }

    .htse-star-a {
        top: 42px;
        right: 1%;
        font-size: 28px;
    }

    .htse-star-b {
        left: 1%;
        bottom: 95px;
        font-size: 37px;
        animation-delay: 1.2s;
    }

    .htse-wave {
        position: absolute;
        bottom: 3px;
        left: 8%;
        z-index: 3;
        width: 135px;
        height: 35px;
        pointer-events: none;
    }

    /* =============================================
       CONTENT
       ============================================= */

    .htse-content {
        position: relative;
        z-index: 5;
        min-width: 0;
        padding: 5px 25px 0 15px;
    }

    .htse-ribbon {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        padding: 9px 24px;
        background: #F9C657;
        color: #173E32;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 14px;
        font-weight: 850;
        transform: rotate(-2deg);
        clip-path: polygon(
            0 0, 100% 0,
            96% 50%, 100% 100%,
            0 100%, 4% 50%
        );
    }

    .htse-ribbon i {
        color: #fff;
    }

    /* TIÊU ĐỀ 2 MÀU */

    .htse-content h2 {
        margin: 0 0 19px;
        color: #173C31;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: clamp(30px, 3.2vw, 46px);
        font-weight: 850;
        line-height: 1.12;
        letter-spacing: 0;
    }

    .htse-title-first,
    .htse-title-second {
        display: block;
    }

    .htse-title-accent {
        position: relative;
        display: inline-block;
        color: #D58127;
        white-space: normal;
    }

    .htse-title-accent::after {
        content: "";
        position: absolute;
        left: 12%;
        right: 2%;
        bottom: -8px;
        height: 6px;
        border-radius: 50%;
        background: #F0B52F;
        transform: rotate(-2deg);
    }

    .htse-description {
        max-width: 560px;
        margin: 0 0 24px;
        color: #53695D;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.7;
    }

    /* =============================================
       NÚT TRẢI NGHIỆM CÓ MÀU
       ============================================= */

    .htse-activities {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
        width: 100%;
    }

    .htse-activity {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
        min-height: 58px;
        padding: 9px 14px;
        border: 1px solid #E8DECA;
        border-radius: 999px;
        background: #fff;
        color: #1B493B;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 12px;
        font-weight: 800;
        line-height: 1.35;
        text-decoration: none;
        box-shadow:
            0 5px 12px rgba(58, 63, 45, .10);
        transition:
            transform .25s ease,
            box-shadow .25s ease,
            background .25s ease;
    }

    .htse-activity:hover {
        color: #164F3E;
        transform: translateY(-4px);
        box-shadow:
            0 10px 20px rgba(58,63,45,.15);
    }

    .htse-activity-icon {
        display: grid;
        place-items: center;
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        font-size: 20px;
    }

    /* CHỢ NỔI - XANH LÁ */

    .htse-activity-river {
        background: #F7FBEF;
    }

    .htse-activity-river .htse-activity-icon {
        background: #E1EFCB;
        color: #08715C;
    }

    /* ẨM THỰC - VÀNG CAM */

    .htse-activity-food {
        background: #FFFAF0;
    }

    .htse-activity-food .htse-activity-icon {
        background: #FFE6B9;
        color: #DA7B1E;
    }

    /* MIỆT VƯỜN - XANH NON */

    .htse-activity-garden {
        background: #F5FBF3;
    }

    .htse-activity-garden .htse-activity-icon {
        background: #E2F1D9;
        color: #21865A;
    }

    /* BIỂN - XANH DƯƠNG NHẠT */

    .htse-activity-sea {
        background: #F3FAFE;
    }

    .htse-activity-sea .htse-activity-icon {
        background: #D7F0FB;
        color: #15849C;
    }

    /* =============================================
       NÚT VÀNG NỔI BẬT
       ============================================= */

    .htse-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 22px;
    }

    .htse-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 22px;
        min-height: 51px;
        padding: 12px 26px;
        border: 2px solid #F1B628;
        border-radius: 999px;
        background: linear-gradient(
            180deg,
            #FFE99B 0%,
            #FFCE52 100%
        );
        color: #143D31;
        box-shadow: 0 5px 0 #DFA324;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 14px;
        font-weight: 850;
        text-decoration: none;
        transition:
            transform .25s ease,
            box-shadow .25s ease;
    }

    .htse-button i {
        font-size: 16px;
        transition: transform .25s ease;
    }

    .htse-button:hover {
        color: #143D31;
        transform: translateY(-3px);
        box-shadow: 0 8px 0 #DFA324;
    }

    .htse-button:hover i {
        transform: translateX(5px);
    }

    /* =============================================
       TRÁI DỪA VÀ HIỆU ỨNG LẤP LÁNH
       ============================================= */

    .htse-coconut {
        position: absolute;
        top: -27px;
        right: -18px;
        z-index: 3;
        width: 124px;
        height: 145px;
        filter: drop-shadow(
            0 7px 6px rgba(55, 87, 45, .12)
        );
        transform: rotate(8deg);
        pointer-events: none;
    }

    .htse-coconut svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .htse-floating-star {
        position: absolute;
        z-index: 4;
        color: #EFB025;
        pointer-events: none;
        animation: htseTwinkle 3.2s ease-in-out infinite;
    }

    .htse-floating-star-one {
        top: 20px;
        right: 12%;
        font-size: 26px;
    }

    .htse-floating-star-two {
        top: 100px;
        right: 1%;
        font-size: 18px;
        animation-delay: 1s;
    }

    .htse-floating-star-three {
        bottom: 3px;
        right: 24%;
        font-size: 24px;
        animation-delay: 1.8s;
    }

    @@keyframes htseTwinkle {
        0%, 100% {
            opacity: .4;
            transform: scale(.8) rotate(-10deg);
        }

        50% {
            opacity: 1;
            transform: scale(1.2) rotate(10deg);
        }
    }

    .htse-bottom-wave {
        position: absolute;
        left: -5%;
        right: -5%;
        bottom: -60px;
        height: 120px;
        z-index: 1;
        border-radius: 50% 50% 0 0;
        background: rgba(235, 225, 185, .16);
        pointer-events: none;
    }

    /* =============================================
       TABLET
       ============================================= */

    @@media (max-width: 1199px) {
        .htse-container {
            width: calc(100% - 40px);
        }

        .htse-content {
            padding-right: 5px;
        }

        .htse-content h2 {
            font-size: clamp(28px, 3.4vw, 40px);
        }

        .htse-activity {
            font-size: 11px;
            gap: 8px;
            padding: 8px 10px;
        }

        .htse-coconut {
            width: 103px;
            right: -14px;
        }
    }

    @@media (max-width: 991px) {
        .htse-section {
            padding: 45px 0 55px;
        }

        .htse-container {
            grid-template-columns: 46% 54%;
            gap: 10px;
            min-height: 330px;
        }

        .htse-collage {
            height: 295px;
        }

        .htse-photo-back {
            height: 215px;
        }

        .htse-photo-main {
            height: 220px;
        }

        .htse-photo-front {
            height: 125px;
        }

        .htse-camera {
            width: 56px;
            height: 51px;
            font-size: 25px;
        }

        .htse-content h2 {
            font-size: 31px;
        }

        .htse-description {
            font-size: 13px;
        }

        .htse-coconut {
            opacity: .7;
        }
    }

    /* =============================================
       MOBILE
       ============================================= */

    @@media (max-width: 700px) {
        .htse-section {
            padding: 42px 0 55px;
        }

        .htse-container {
            display: flex;
            flex-direction: column;
            gap: 22px;
            width: calc(100% - 30px);
        }

        .htse-content {
            order: 1;
            width: 100%;
            padding: 0;
        }

        .htse-content h2 {
            font-size: clamp(27px, 6.5vw, 37px);
        }

        .htse-description {
            max-width: 460px;
        }

        .htse-collage {
            order: 2;
            width: 100%;
            max-width: 460px;
            height: 310px;
            margin: 0 auto;
        }

        .htse-photo-back {
            top: 28px;
            left: 7%;
            width: 43%;
            height: 210px;
        }

        .htse-photo-main {
            top: 13px;
            left: 44%;
            width: 48%;
            height: 210px;
        }

        .htse-photo-front {
            left: 29%;
            bottom: 7px;
            width: 40%;
            height: 131px;
        }

        .htse-coconut {
            top: -28px;
            right: -6px;
            width: 85px;
            height: 100px;
            opacity: .9;
        }

        .htse-activities {
            gap: 10px;
        }

        .htse-activity {
            min-height: 52px;
            font-size: 11px;
        }

        .htse-activity-icon {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
            font-size: 17px;
        }
    }

    @@media (max-width: 420px) {
        .htse-ribbon {
            font-size: 11px;
            padding: 8px 16px;
        }

        .htse-activities {
            grid-template-columns: 1fr;
        }

        .htse-activity {
            min-height: 47px;
        }

        .htse-collage {
            height: 260px;
        }

        .htse-photo-back,
        .htse-photo-main {
            height: 180px;
        }

        .htse-photo-front {
            height: 115px;
        }

        .htse-camera {
            right: 12%;
            bottom: 3px;
        }

        .htse-button {
            font-size: 13px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .htse-collage-star,
        .htse-floating-star {
            animation: none;
        }

        .htse-photo,
        .htse-activity,
        .htse-button,
        .htse-button i {
            transition: none;
        }
    }

/* ========================================
   FIX MAU NUT + TRAI DUA HAPPYTRIP
   ======================================== */

/* TRAI DUA TRON, NOI BAT HON */
.htse-section .htse-coconut {
    position: absolute;
    top: -40px;
    right: -24px;
    z-index: 6;
    width: 165px;
    height: 173px;
    opacity: 1;
    transform: rotate(7deg);
    filter: drop-shadow(
        0 10px 8px rgba(39, 74, 40, .13)
    );
    pointer-events: none;
}

.htse-section .htse-coconut svg {
    display: block;
    width: 100%;
    height: 100%;
