
@model List<TourWebApp.Data.Models.WishlistTour>
@using System.Globalization

@{
    ViewData["Title"] = "Tour yêu thích";

    var danhSach = Model?
        .Where(x => x.IdTourNavigation != null)
        .ToList()
        ?? new List<TourWebApp.Data.Models.WishlistTour>();

    var soTour = danhSach.Count;

    var soTourText = soTour == 1
        ? "1 hành trình"
        : $"{soTour} hành trình";
}

<style>
    /* ===========================================
       HAPPYTRIP - PREMIUM WISHLIST
       =========================================== */

    .wishlist-premium {
        --wl-green: #173e2e;
        --wl-green-dark: #102d23;
        --wl-green-light: #285b43;
        --wl-gold: #d5bd96;
        --wl-cream: #f8f5ef;
        --wl-text: #233d30;
        --wl-muted: #778176;
        --wl-price: #ae4937;

        position: relative;
        min-height: 70vh;
        overflow: hidden;
        background: #faf8f4;
        color: var(--wl-text);
    }

    .wishlist-premium * {
        box-sizing: border-box;
    }

    .wishlist-premium-container {
        width: min(1370px, calc(100% - 56px));
        margin: 0 auto;
    }

    /* ===========================================
       HERO BANNER
       =========================================== */

    .wishlist-hero {
        position: relative;
        min-height: 258px;
        isolation: isolate;
        display: flex;
        align-items: center;
        overflow: hidden;

        background:
            linear-gradient(
                90deg,
                rgba(13, 48, 34, .94) 0%,
                rgba(17, 55, 38, .83) 42%,
                rgba(23, 66, 45, .42) 100%
            ),
            url("https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=2000&q=85")
            center 53% / cover no-repeat;
    }

    .wishlist-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            0deg,
            rgba(14, 41, 29, .12),
            transparent 65%
        );
    }

    .wishlist-hero-content {
        position: relative;
        z-index: 1;
        padding: 42px 0;
    }

    .wishlist-eyebrow {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 15px;
        color: #ead6b3;
        font-size: .87rem;
        font-weight: 700;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .wishlist-eyebrow::after {
        content: "";
        width: 75px;
        height: 1px;
        background: rgba(234, 214, 179, .7);
    }

    .wishlist-hero-title {
        max-width: 1000px;
        margin: 0 0 15px;
        color: #fff;
        font-family: "Tai Heritage Pro", Georgia, serif;
        font-size: clamp(2rem, 3.6vw, 3.3rem);
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -.025em;
    }

    .wishlist-hero-title i {
        display: inline-block;
        margin-left: 9px;
        color: #e4bd82;
        font-size: .66em;
        transform: rotate(-15deg);
    }

    .wishlist-hero-desc {
        max-width: 780px;
        margin: 0;
        color: rgba(255,255,255,.89);
        font-size: 1.06rem;
        line-height: 1.7;
    }

    /* ===========================================
       MAIN CONTENT
       =========================================== */

    .wishlist-main {
        position: relative;
        min-height: 570px;
        padding: 35px 0 75px;
        isolation: isolate;
    }

    .wishlist-main-content {
        position: relative;
        z-index: 2;
    }

    .wishlist-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 27px;
    }

    .wishlist-toolbar-heading {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .wishlist-heading-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        color: #284c3a;
        background: #e9d9c0;
        border-radius: 15px;
        font-size: 1.28rem;
    }

    .wishlist-section-title {
        margin: 0;
        color: var(--wl-green);
        font-family: "Tai Heritage Pro", Georgia, serif;
        font-size: clamp(1.55rem, 2.55vw, 2.25rem);
        font-weight: 700;
    }

    .wishlist-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .wishlist-sort {
        min-width: 160px;
        min-height: 46px;
        padding: 10px 35px 10px 16px;
        color: var(--wl-green);
        background-color: #fff;
        border: 1px solid #e6e0d6;
        border-radius: 14px;
        font-size: .89rem;
        font-weight: 600;
        cursor: pointer;
    }

    .wishlist-sort:focus {
        outline: 2px solid #abc4ab;
        outline-offset: 2px;
    }

    .wishlist-view-switch {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px;
        border: 1px solid #e4ded3;
        border-radius: 14px;
        background: #fff;
    }

    .wishlist-view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 38px;
        padding: 0;
        color: #486353;
        background: transparent;
        border: 0;
        border-radius: 10px;
        font-size: 1rem;
        cursor: pointer;
        transition: .2s ease;
    }

    .wishlist-view-btn:hover {
        background: #eef3ed;
    }

    .wishlist-view-btn.is-active {
        background: var(--wl-green);
        color: #fff;
        box-shadow: 0 4px 12px rgba(23,62,46,.16);
    }

    /* ===========================================
       TOUR CARDS
       =========================================== */

    .wishlist-tour-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        align-items: stretch;
    }

    .wishlist-tour-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid #ebe5db;
        border-radius: 21px;
        box-shadow: 0 13px 30px rgba(39, 48, 36, .095);
        transition:
            transform .25s ease,
            box-shadow .25s ease,
            border-color .25s ease;
    }

    .wishlist-tour-card:hover {
        transform: translateY(-5px);
        border-color: #d5dfd1;
        box-shadow: 0 22px 42px rgba(39,48,36,.15);
    }

    .wishlist-card-media {
        position: relative;
        height: 240px;
        overflow: hidden;
        background: #e9ede6;
    }

    .wishlist-card-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .5s ease;
    }

    .wishlist-tour-card:hover .wishlist-card-media img {
        transform: scale(1.04);
    }

    .wishlist-location-chip {
        position: absolute;
        bottom: 13px;
        left: 14px;
        max-width: calc(100% - 84px);
        padding: 8px 13px;
        color: #fff;
        background: rgba(19, 63, 43, .89);
        backdrop-filter: blur(8px);
        border-radius: 10px;
        font-size: .82rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .wishlist-location-chip i {
        margin-right: 5px;
    }

    .wishlist-heart-form {
        position: absolute;
        top: 13px;
        right: 13px;
        z-index: 3;
        margin: 0;
    }

    .wishlist-heart-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        padding: 0;
        background: rgba(255,255,255,.97);
        color: #e45457;
        border: 0;
        border-radius: 50%;
        font-size: 1.3rem;
        box-shadow: 0 4px 13px rgba(0,0,0,.13);
        cursor: pointer;
        transition: .2s ease;
    }

    .wishlist-heart-btn:hover {
        background: #fff4f3;
        transform: scale(1.08);
    }

    .wishlist-card-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 11px;
        min-height: 215px;
        padding: 18px 20px 20px;
    }

    .wishlist-card-title {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        overflow: hidden;
        min-height: 52px;
        margin: 0;
        color: var(--wl-green);
        font-family: "Tai Heritage Pro", Georgia, serif;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .wishlist-card-title a {
        color: inherit;
        text-decoration: none;
    }

    .wishlist-card-title a:hover {
        color: #357450;
    }

    .wishlist-card-location {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0;
        color: #788479;
        font-size: .92rem;
        line-height: 1.5;
    }

    .wishlist-card-location i {
        color: #486e55;
    }

    .wishlist-card-price {
        margin: 0 0 3px;
        color: var(--wl-price);
        font-size: 1.42rem;
        font-weight: 800;
        letter-spacing: -.02em;
    }

    .wishlist-card-actions {
        display: flex;
        align-items: stretch;
        gap: 11px;
        margin-top: auto;
    }

    .wishlist-card-detail-btn,
    .wishlist-card-remove-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 45px;
        padding: 11px 13px;
        border-radius: 12px;
        font-size: .88rem;
        font-weight: 700;
        text-decoration: none;
        text-align: center;
        transition: .2s ease;
    }

    .wishlist-card-detail-btn {
        flex: 1;
        color: #fff;
        background: linear-gradient(110deg,#174b34,#205c40);
        border: 1px solid #174b34;
    }

    .wishlist-card-detail-btn:hover {
        color: #fff;
        background: #286c49;
        transform: translateY(-1px);
    }

    .wishlist-card-remove-form {
        flex: 0 0 32%;
        margin: 0;
    }

    .wishlist-card-remove-btn {
        width: 100%;
        color: #b5493e;
        background: #fff;
        border: 1px solid #d78b80;
        cursor: pointer;
    }

    .wishlist-card-remove-btn:hover {
        background: #fff3f1;
        border-color: #c65b4e;
    }

    /* ===========================================
       LIST MODE
       =========================================== */

    .wishlist-tour-grid.is-list {
        grid-template-columns: 1fr;
        max-width: 1020px;
    }

    .wishlist-tour-grid.is-list .wishlist-tour-card {
        display: grid;
        grid-template-columns: 290px minmax(0,1fr);
    }

    .wishlist-tour-grid.is-list .wishlist-card-media {
        height: 100%;
        min-height: 235px;
    }

    .wishlist-tour-grid.is-list .wishlist-card-body {
        min-height: 235px;
        padding: 23px;
    }

    .wishlist-tour-grid.is-list .wishlist-card-title {
        min-height: 0;
    }

    /* ===========================================
       DECORATIVE FLIGHT PATH
       =========================================== */

    .wishlist-flight-decor {
        position: absolute;
        z-index: 0;
        right: 3%;
        top: 175px;
        width: 30%;
        max-width: 410px;
        pointer-events: none;
        color: #94ad8f;
        opacity: .75;
    }

    .wishlist-flight-decor svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .wishlist-flight-decor.is-hidden {
        display: none;
    }

    .wishlist-landscape {
        position: absolute;
        z-index: 0;
        left: 0;
        right: 0;
        bottom: 0;
        height: 235px;
        pointer-events: none;
        opacity: .7;
        background:
            radial-gradient(
                ellipse at 10% 100%,
                #e9ede3 0%,
                transparent 47%
            ),
            radial-gradient(
                ellipse at 85% 115%,
                #dfe8db 0%,
                transparent 48%
            );
    }

    /* ===========================================
       EMPTY STATE
       =========================================== */

    .wishlist-empty {
        position: relative;
        z-index: 2;
        max-width: 640px;
        margin: 55px auto 25px;
        padding: 40px 30px;
        text-align: center;
        background: rgba(255,255,255,.94);
        border: 1px solid #ece5da;
        border-radius: 22px;
        box-shadow: 0 14px 33px rgba(32,60,42,.075);
    }

    .wishlist-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 76px;
        height: 76px;
        margin: 0 auto 20px;
        color: #315b41;
        background: #edf1e8;
        border-radius: 22px;
        font-size: 1.8rem;
    }

    .wishlist-empty h3 {
        margin: 0 0 10px;
        font-family: "Tai Heritage Pro", Georgia, serif;
        color: var(--wl-green);
        font-size: 1.65rem;
    }

    .wishlist-empty p {
        color: #7b877a;
        line-height: 1.75;
    }

    .wishlist-empty a {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-top: 12px;
        padding: 12px 22px;
        color: #fff;
        background: var(--wl-green);
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
    }

    /* ===========================================
       RESPONSIVE
       =========================================== */

    @@media (max-width: 1199px) {
        .wishlist-tour-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .wishlist-flight-decor {
            right: 2%;
            width: 27%;
            opacity: .35;
        }
    }

    @@media (max-width: 767px) {
        .wishlist-premium-container {
            width: calc(100% - 30px);
        }

        .wishlist-hero {
            min-height: 230px;
        }

        .wishlist-hero-content {
            padding: 35px 0;
        }

        .wishlist-eyebrow {
            font-size: .72rem;
        }

        .wishlist-hero-title {
            font-size: clamp(1.85rem,6vw,2.5rem);
        }

        .wishlist-hero-desc {
            font-size: .93rem;
        }

        .wishlist-main {
            padding-top: 25px;
        }

        .wishlist-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .wishlist-toolbar-actions {
            width: 100%;
            justify-content: space-between;
        }

        .wishlist-tour-grid {
            grid-template-columns: 1fr;
            gap: 19px;
        }

        .wishlist-card-media {
            height: 220px;
        }

        .wishlist-flight-decor {
            display: none;
        }

        .wishlist-tour-grid.is-list .wishlist-tour-card {
            grid-template-columns: 1fr;
        }

        .wishlist-tour-grid.is-list .wishlist-card-media {
            height: 220px;
            min-height: 0;
        }

        .wishlist-tour-grid.is-list .wishlist-card-body {
            min-height: 0;
        }
    }

    @@media (max-width: 420px) {
        .wishlist-card-body {
            padding: 16px;
        }

        .wishlist-card-title {
            font-size: 1.18rem;
        }

        .wishlist-card-detail-btn,
        .wishlist-card-remove-btn {
            font-size: .8rem;
        }

        .wishlist-section-title {
            font-size: 1.5rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .wishlist-premium *,
        .wishlist-premium *::before,
        .wishlist-premium *::after {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<div class="wishlist-premium">

    <!-- ===========================================
         HERO BANNER
         =========================================== -->

    <section class="wishlist-hero">

        <div class="wishlist-premium-container wishlist-hero-content">

            <div class="wishlist-eyebrow">
                HAPPYTRIP · BỘ SƯU TẬP CỦA BẠN
            </div>

            <h1 class="wishlist-hero-title">
                Những hành trình bạn yêu thích
                <i class="fa-regular fa-heart" aria-hidden="true"></i>
            </h1>

            <p class="wishlist-hero-desc">
                @if (soTour > 0)
                {
                    <text>
                        Bạn đã lưu @soTourText.
                        Cùng lên kế hoạch cho chuyến đi tiếp theo nhé.
                    </text>
                }
                else
                {
                    <text>
                        Lưu lại những chuyến đi thú vị để khám phá
                        vào một ngày thật đẹp nhé.
                    </text>
                }
            </p>

        </div>

    </section>

    <!-- ===========================================
         MAIN
         =========================================== -->

    <main class="wishlist-main">

        <div class="wishlist-landscape"></div>

        <div id="wishlistFlightDecor"
             class="wishlist-flight-decor @(soTour > 2 ? "is-hidden" : "")"
             aria-hidden="true">

            <svg viewBox="0 0 460 320"
                 fill="none"
                 xmlns="http://www.w3.org/2000/svg">

                <path d="M30 250 C110 280 160 210 185 170 C215 115 125 75 130 160 C145 265 275 190 380 65"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-dasharray="8 9"
                      stroke-linecap="round" />

                <path d="M365 52 L415 20 L397 67 L382 55 L368 84 L362 81 L367 49 Z"
                      fill="currentColor" />

                <path d="M35 220 C19 220 9 232 9 246 C9 269 35 295 35 295 C35 295 61 269 61 246 C61 232 50 220 35 220 Z"
                      fill="currentColor" />

                <circle cx="35" cy="246" r="9" fill="#FAF8F4" />

            </svg>

        </div>

        <div class="wishlist-premium-container wishlist-main-content">

            <!-- TOOLBAR -->

            <div class="wishlist-toolbar">

                <div class="wishlist-toolbar-heading">

                    <div class="wishlist-heading-icon">
                        <i class="fa-solid fa-heart"></i>
                    </div>

                    <h2 class="wishlist-section-title">
                        Tour yêu thích (@soTour)
                    </h2>

                </div>

                @if (soTour > 0)
                {
                    <div class="wishlist-toolbar-actions">

                        <select id="wishlistSort"
                                class="wishlist-sort"
                                aria-label="Sắp xếp tour yêu thích">

                            <option value="default">
                                Mặc định
                            </option>

                            <option value="name">
                                Tên A–Z
                            </option>

                            <option value="price-asc">
                                Giá thấp nhất
                            </option>

                            <option value="price-desc">
                                Giá cao nhất
                            </option>

                        </select>

                        <div class="wishlist-view-switch"
                             role="group"
                             aria-label="Chế độ hiển thị">

                            <button type="button"
                                    id="wishlistGridBtn"
                                    class="wishlist-view-btn is-active"
                                    aria-label="Hiển thị dạng lưới"
                                    aria-pressed="true">

                                <i class="fa-solid fa-table-cells-large"></i>

                            </button>

                            <button type="button"
                                    id="wishlistListBtn"
                                    class="wishlist-view-btn"
                                    aria-label="Hiển thị dạng danh sách"
                                    aria-pressed="false">

                                <i class="fa-solid fa-list"></i>

                            </button>

                        </div>

                    </div>
                }

            </div>

            <!-- EMPTY STATE -->

            @if (soTour == 0)
            {
                <div class="wishlist-empty">

                    <div class="wishlist-empty-icon">
                        <i class="fa-regular fa-heart"></i>
                    </div>

                    <h3>Chưa có hành trình yêu thích</h3>

                    <p>
                        Bạn chưa lưu tour nào.
                        Hãy khám phá HappyTrip và đánh dấu
                        những chuyến đi khiến bạn muốn xách ba lô lên đường.
                    </p>

                    <a href="/tours">

                        Khám phá tour

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>
            }
            else
            {
                <!-- TOUR GRID -->

                <div id="wishlistTourGrid"
                     class="wishlist-tour-grid">

                    @for (var i = 0; i < danhSach.Count; i++)
                    {
                        var item = danhSach[i];
                        var tour = item.IdTourNavigation;

                        if (tour == null)
                        {
                            continue;
                        }

                        var gia = tour.GiaKhuyenMai ?? 0;

                        <article class="wishlist-tour-card"
                                 data-index="@i"
                                 data-name="@tour.TenTour"
                                 data-price="@gia.ToString(CultureInfo.InvariantCulture)">

                            <!-- IMAGE -->

                            <div class="wishlist-card-media">

                                <img src="@TourImagePathHelper.ToTourImageSrc(tour.HinhAnh)"
                                     alt="@tour.TenTour"
                                     loading="lazy" />

                                <span class="wishlist-location-chip">

                                    <i class="fa-solid fa-location-dot"></i>

                                    @tour.DiaDiem

                                </span>

                                <!-- REMOVE VIA HEART -->

                                <form asp-controller="Wishlist"
                                      asp-action="Remove"
                                      method="post"
                                      class="wishlist-heart-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idWishlist"
                                           value="@item.IdWishlist" />

                                    <button type="submit"
                                            class="wishlist-heart-btn"
                                            title="Bỏ yêu thích"
                                            aria-label="Bỏ yêu thích tour @tour.TenTour">

                                        <i class="fa-solid fa-heart"></i>

                                    </button>

                                </form>

                            </div>

                            <!-- CONTENT -->

                            <div class="wishlist-card-body">

                                <h3 class="wishlist-card-title">

                                    <a href="/Tour/ChiTiet/@item.IdTour">
                                        @tour.TenTour
                                    </a>

                                </h3>

                                <p class="wishlist-card-location">

                                    <i class="fa-solid fa-location-dot"></i>

                                    @tour.DiaDiem

                                </p>

                                <p class="wishlist-card-price">
                                    @string.Format("{0:N0} đ", gia)
                                </p>

                                <div class="wishlist-card-actions">

                                    <a href="/Tour/ChiTiet/@item.IdTour"
                                       class="wishlist-card-detail-btn">

                                        Xem chi tiết

                                        <i class="fa-solid fa-arrow-right"></i>

                                    </a>

                                    <form asp-controller="Wishlist"
                                          asp-action="Remove"
                                          method="post"
                                          class="wishlist-card-remove-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="idWishlist"
                                               value="@item.IdWishlist" />

                                        <button type="submit"
                                                class="wishlist-card-remove-btn">

                                            <i class="fa-regular fa-trash-can"></i>

                                            Xóa

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }

        </div>

    </main>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const grid = document.getElementById("wishlistTourGrid");
        const sort = document.getElementById("wishlistSort");

        const gridButton = document.getElementById("wishlistGridBtn");
        const listButton = document.getElementById("wishlistListBtn");

        const decor = document.getElementById("wishlistFlightDecor");

        if (!grid) return;

        const originalCards = Array.from(
            grid.querySelectorAll(".wishlist-tour-card")
        );

        // ========================================
        // SORT
        // ========================================

        if (sort) {
            sort.addEventListener("change", function () {

                const cards = [...originalCards];
                const mode = sort.value;

                cards.sort(function (a, b) {

                    const priceA =
                        Number(a.dataset.price || 0);

                    const priceB =
                        Number(b.dataset.price || 0);

                    const nameA =
                        a.dataset.name || "";

                    const nameB =
                        b.dataset.name || "";

                    if (mode === "price-asc") {
                        return priceA - priceB;
                    }

                    if (mode === "price-desc") {
                        return priceB - priceA;
                    }

                    if (mode === "name") {
                        return nameA.localeCompare(
                            nameB,
                            "vi",
                            { sensitivity: "base" }
                        );
                    }

                    return Number(a.dataset.index) -
                           Number(b.dataset.index);

                });

                cards.forEach(function (card) {
                    grid.appendChild(card);
                });

            });
        }

        // ========================================
        // GRID / LIST
        // ========================================

        function setView(mode) {

            const isList = mode === "list";

            grid.classList.toggle("is-list", isList);

            if (gridButton) {
                gridButton.classList.toggle(
                    "is-active",
                    !isList
                );

                gridButton.setAttribute(
                    "aria-pressed",
                    String(!isList)
                );
            }

            if (listButton) {
                listButton.classList.toggle(
                    "is-active",
                    isList
                );

                listButton.setAttribute(
                    "aria-pressed",
                    String(isList)
                );
            }

            if (decor) {
                decor.classList.toggle(
                    "is-hidden",
                    isList || originalCards.length > 2
                );
            }
        }

        gridButton?.addEventListener(
            "click",
            function () {
                setView("grid");
            }
        );

        listButton?.addEventListener(
            "click",
            function () {
                setView("list");
            }
        );

    });
</script>
