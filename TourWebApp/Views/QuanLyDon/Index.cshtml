
@model List<TourWebApp.Data.Models.DonDatTour>
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý đặt tour";

    var orders = Model ?? new List<TourWebApp.Data.Models.DonDatTour>();

    var filterStatus = Convert.ToString(ViewBag.TrangThai) ?? "TatCa";
    var filterMethod = Convert.ToString(ViewBag.PhuongThucTT) ?? "TatCa";
    var filterKeyword = Convert.ToString(ViewBag.TuKhoa) ?? "";
    var fromDate = Convert.ToString(ViewBag.NgayDatTu) ?? "";
    var toDate = Convert.ToString(ViewBag.NgayDatDen) ?? "";

    var pendingCashCount = Convert.ToInt32(ViewBag.PendingCashCount ?? 0);
    var now = DateTime.Now;

    var total = orders.Count;
    var paid = orders.Count(x => x.DaThanhToan && x.TrangThai != "DaHuy");
    var cancelled = orders.Count(x => x.TrangThai == "DaHuy");
    var pending = orders.Count(x =>
        !x.DaThanhToan &&
        x.TrangThai != "DaHuy" &&
        x.TrangThaiThanhToan != "HetHanThanhToan");

    var totalRevenue = orders
        .Where(x => x.DaThanhToan && x.TrangThai != "DaHuy")
        .Sum(x => Math.Max(0m,
            x.TongTienSauGiam ??
            (x.TongTien - (x.SoTienGiam ?? 0m))));
}

<div class="ht-orders" id="htOrdersPage">

    <div class="hto-hero">
        <div>
            <div class="hto-breadcrumb">
                <i class="fa-solid fa-house"></i>
                <span>Quản trị</span>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Quản lý đặt tour</span>
            </div>
            <h1>
                <i class="fa-regular fa-calendar-check"></i>
                Quản lý đặt tour
            </h1>
            <p>Theo dõi đơn đặt tour, thanh toán và tình trạng xử lý của khách hàng.</p>
        </div>
        <div class="hto-hero-decoration">
            <i class="fa-solid fa-plane-departure"></i>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="hto-notice success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="hto-notice error">@TempData["Error"]</div>
    }

    @if (pendingCashCount > 0)
    {
        <div class="hto-notice info">
            <div>
                <i class="fa-solid fa-circle-info"></i>
                Có <strong>@pendingCashCount</strong> đơn chờ xác nhận thanh toán tiền mặt.
            </div>
            <a href="@Url.Action("Index", "QuanLyDon", new { trangThai = "ChoXacNhanTienMat" })">
                Xem đơn
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    }

    <div class="hto-stats">
        <div class="hto-stat">
            <div class="hto-stat-icon green">
                <i class="fa-regular fa-calendar-check"></i>
            </div>
            <div>
                <span>Tổng đơn đặt tour</span>
                <strong>@total.ToString("N0")</strong>
                <small>Trong kết quả lọc</small>
            </div>
        </div>

        <div class="hto-stat">
            <div class="hto-stat-icon gold">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <span>Đã thanh toán</span>
                <strong>@paid.ToString("N0")</strong>
                <small>@totalRevenue.ToString("N0") đ</small>
            </div>
        </div>

        <div class="hto-stat">
            <div class="hto-stat-icon blue">
                <i class="fa-regular fa-clock"></i>
            </div>
            <div>
                <span>Chưa thanh toán</span>
                <strong>@pending.ToString("N0")</strong>
                <small>Chưa xác nhận thành công</small>
            </div>
        </div>

        <div class="hto-stat">
            <div class="hto-stat-icon red">
                <i class="fa-regular fa-circle-xmark"></i>
            </div>
            <div>
                <span>Đã hủy</span>
                <strong>@cancelled.ToString("N0")</strong>
                <small>Đơn đã hủy</small>
            </div>
        </div>
    </div>

    <section class="hto-panel hto-filter-panel">
        <div class="hto-panel-title">
            <h2>
                <i class="fa-solid fa-filter"></i>
                Bộ lọc đơn đặt tour
            </h2>
            <span>Tìm kiếm và quản lý</span>
        </div>

        <form method="get"
              action="@Url.Action("Index", "QuanLyDon")"
              id="htoFilterForm">

            <div class="hto-filter-grid">

                <div class="hto-field hto-search-field">
                    <label for="htoKeyword">Mã booking / Tên khách</label>
                    <div class="hto-input-icon">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input id="htoKeyword"
                               name="tuKhoa"
                               type="search"
                               value="@filterKeyword"
                               placeholder="Nhập mã đơn hoặc tên khách..." />
                    </div>
                </div>

                <div class="hto-field">
                    <label for="htoFromDate">Ngày đặt từ</label>
                    <input id="htoFromDate"
                           type="date"
                           name="ngayDatTu"
                           value="@fromDate" />
                </div>

                <div class="hto-field">
                    <label for="htoToDate">Đến ngày</label>
                    <input id="htoToDate"
                           type="date"
                           name="ngayDatDen"
                           value="@toDate" />
                </div>

                <div class="hto-field">
                    <label for="htoStatus">Trạng thái đơn</label>
                    <select id="htoStatus" name="trangThai">
                        <option value="TatCa" selected="@(filterStatus == "TatCa")">Tất cả trạng thái</option>
                        <option value="ChoDuyet" selected="@(filterStatus == "ChoDuyet")">Chờ duyệt</option>
                        <option value="DaDuyet" selected="@(filterStatus == "DaDuyet")">Đã duyệt</option>
                        <option value="DaThanhToan" selected="@(filterStatus == "DaThanhToan")">Đã thanh toán</option>
                        <option value="ChuaThanhToan" selected="@(filterStatus == "ChuaThanhToan")">Chưa thanh toán</option>
                        <option value="ChoXacNhanTienMat" selected="@(filterStatus == "ChoXacNhanTienMat")">Chờ xác nhận tiền mặt</option>
                        <option value="DaHuy" selected="@(filterStatus == "DaHuy")">Đã hủy</option>
                    </select>
                </div>

                <div class="hto-field">
                    <label for="htoPayment">Phương thức thanh toán</label>
                    <select id="htoPayment" name="phuongThucTT">
                        <option value="TatCa" selected="@(filterMethod == "TatCa")">Tất cả phương thức</option>
                        <option value="VNPAY" selected="@(filterMethod == "VNPAY")">VNPay</option>
                        <option value="ChuyenKhoanQR" selected="@(filterMethod == "ChuyenKhoanQR")">Chuyển khoản QR</option>
                        <option value="TienMat" selected="@(filterMethod == "TienMat")">Tiền mặt</option>
                        <option value="MienPhi" selected="@(filterMethod == "MienPhi")">Miễn phí</option>
                    </select>
                </div>

                <div class="hto-field hto-actions-field">
                    <label>Thao tác lọc</label>
                    <div class="hto-filter-actions">
                        <button type="submit" class="hto-btn primary">
                            <i class="fa-solid fa-filter"></i>
                            Lọc
                        </button>

                        <a class="hto-btn outline"
                           href="@Url.Action("Index", "QuanLyDon")">
                            <i class="fa-solid fa-rotate-right"></i>
                            Làm mới
                        </a>
                    </div>
                </div>
            </div>

            <div class="hto-filter-footer">
                <span>
                    <i class="fa-solid fa-circle-info"></i>
                    Bộ lọc sử dụng dữ liệu thực từ hệ thống.
                </span>

                <button type="submit"
                        class="hto-btn export"
                        formaction="@Url.Action("ExportExcel", "QuanLyDon")">
                    <i class="fa-solid fa-file-excel"></i>
                    Xuất Excel
                </button>
            </div>
        </form>
    </section>

    <section class="hto-panel hto-table-panel">

        <div class="hto-table-heading">
            <div>
                <h2>Danh sách đơn đặt tour</h2>
                <p>Kiểm tra tình trạng đặt chỗ và xử lý từng đơn hàng.</p>
            </div>
            <span class="hto-total-label">@total đơn trong kết quả lọc</span>
        </div>

        <div class="hto-tabs" role="group" aria-label="Lọc nhanh theo thanh toán">
            <button type="button" class="hto-tab active" data-tab="all">
                Tất cả <span>@total</span>
            </button>
            <button type="button" class="hto-tab" data-tab="paid">
                Đã thanh toán <span>@paid</span>
            </button>
            <button type="button" class="hto-tab" data-tab="pending">
                Chưa thanh toán <span>@pending</span>
            </button>
            <button type="button" class="hto-tab" data-tab="cancelled">
                Đã hủy <span>@cancelled</span>
            </button>
        </div>

        <div class="hto-table-scroll">
            <table class="hto-table" id="htoOrderTable">
                <thead>
                    <tr>
                        <th>Mã booking</th>
                        <th>Thông tin tour</th>
                        <th>Khách hàng</th>
                        <th>Ngày khởi hành</th>
                        <th>Số khách</th>
                        <th>Tổng thanh toán</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái đơn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in orders.OrderByDescending(x => x.NgayDat))
                    {
                        var amount = Math.Max(0m,
                            d.TongTienSauGiam ??
                            (d.TongTien - (d.SoTienGiam ?? 0m)));

                        var isCancelled = d.TrangThai == "DaHuy";
                        var isPaid = d.DaThanhToan && !isCancelled;
                        var isPending = !d.DaThanhToan
                            && !isCancelled
                            && d.TrangThaiThanhToan != "HetHanThanhToan";

                        var category = isCancelled
                            ? "cancelled"
                            : isPaid ? "paid" : isPending ? "pending" : "other";

                        var isExpired = !d.DaThanhToan
                            && d.HanThanhToan.HasValue
                            && d.HanThanhToan.Value < now;

                        var guestCount = d.NguoiLon + d.TreEm + d.TreNho;
                        var tourName = d.IdTourNavigation?.TenTour ?? "Tour không xác định";
                        var customerName = d.IdTaiKhoanNavigation?.HoTen ?? "Khách hàng";
                        var departure = d.IdLichNavigation?.NgayKhoiHanh;

                        var paymentText = isPaid
                            ? "Đã thanh toán"
                            : isCancelled ? "Đã hủy"
                            : isExpired ? "Hết hạn"
                            : "Chưa thanh toán";

                        var paymentClass = isPaid
                            ? "success"
                            : isCancelled || isExpired ? "danger" : "warning";

                        var orderText = d.TrangThai switch
                        {
                            "ChoThanhToan" => "Chờ thanh toán",
                            "ChoXacNhanTienMat" => "Chờ thu tiền mặt",
                            "ThanhToanThanhCong" => "Đã thanh toán",
                            "DaHuy" => "Đã hủy",
                            "HoanTat" => "Hoàn tất",
                            "ChoDuyet" => "Chờ duyệt",
                            "DaDuyet" => "Đã duyệt",
                            _ => d.TrangThai ?? "Chưa cập nhật"
                        };

                        var orderClass = isCancelled
                            ? "danger"
                            : d.TrangThai == "HoanTat" ? "success"
                            : isPaid ? "success" : "warning";

                        <tr class="hto-order-row" data-category="@category">
                            <td>
                                <strong class="hto-booking-code">@d.MaBooking</strong>
                                <span class="hto-subline">
                                    Đặt: @d.NgayDat.ToString("dd/MM/yyyy")
                                </span>
                            </td>

                            <td>
                                <div class="hto-tour-name" title="@tourName">
                                    @tourName
                                </div>
                                <span class="hto-subline">
                                    <i class="fa-solid fa-location-dot"></i>
                                    @(d.IdTourNavigation?.DiaDiem ?? "Chưa cập nhật")
                                </span>
                            </td>

                            <td>
                                <strong class="hto-customer-name">@customerName</strong>
                                <span class="hto-subline">
                                    @(d.IdTaiKhoanNavigation?.SoDienThoai ?? "")
                                </span>
                            </td>

                            <td>
                                <span class="hto-date">
                                    <i class="fa-regular fa-calendar"></i>
                                    @(departure?.ToString("dd/MM/yyyy") ?? "Chưa có")
                                </span>
                            </td>

                            <td>
                                <strong>@guestCount khách</strong>
                                <span class="hto-subline">
                                    @d.NguoiLon NL, @d.TreEm TE, @d.TreNho EB
                                </span>
                            </td>

                            <td>
                                <strong class="hto-money">
                                    @amount.ToString("N0") đ
                                </strong>
                                @if (!string.IsNullOrWhiteSpace(d.MaPhieuGiamGia))
                                {
                                    <span class="hto-subline hto-voucher">
                                        <i class="fa-solid fa-ticket"></i>
                                        @d.MaPhieuGiamGia
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="hto-status @paymentClass">
                                    @paymentText
                                </span>
                                <span class="hto-subline">
                                    @(d.PhuongThucTT ?? "Chưa chọn")
                                </span>
                            </td>

                            <td>
                                <span class="hto-status @orderClass">
                                    @orderText
                                </span>
                            </td>

                            <td>
                                <div class="hto-row-actions">
                                    <a asp-controller="QuanLyDon"
                                       asp-action="ChiTiet"
                                       asp-route-id="@d.IdDon"
                                       class="hto-icon-btn"
                                       title="Xem chi tiết"
                                       aria-label="Xem chi tiết đơn @d.MaBooking">
                                        <i class="fa-regular fa-eye"></i>
                                    </a>

                                    @if (!d.DaThanhToan && !isCancelled)
                                    {
                                        <form asp-controller="QuanLyDon"
                                              asp-action="Xoa"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa đơn chưa thanh toán này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.IdDon" />
                                            <button type="submit"
                                                    class="hto-icon-btn danger"
                                                    title="Xóa đơn chưa thanh toán"
                                                    aria-label="Xóa đơn @d.MaBooking">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="htoEmpty" class="hto-empty" hidden>
            <i class="fa-regular fa-folder-open"></i>
            <strong>Không tìm thấy đơn đặt tour</strong>
            <p>Hãy thử chọn trạng thái khác hoặc làm mới bộ lọc.</p>
        </div>

        <div class="hto-pagination">
            <span id="htoPageInfo">Đang tải danh sách...</span>
            <div class="hto-page-buttons" id="htoPageButtons"></div>
        </div>
    </section>
</div>

<style>
    .ht-orders {
        --hto-green: #16683d;
        --hto-dark: #174b32;
        --hto-text: #263b30;
        --hto-muted: #7a887f;
        --hto-border: #e4ebe4;
        --hto-bg: #f6f9f5;
        color: var(--hto-text);
        padding: 10px 4px 30px;
        font-family: "Be Vietnam Pro", Arial, sans-serif;
    }

    .ht-orders *,
    .ht-orders *::before,
    .ht-orders *::after {
        box-sizing: border-box;
    }

    .hto-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(105deg, #edf8ef, #f7faf6 60%, #e5f0e9);
        border-radius: 20px;
        padding: 24px 28px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .hto-breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        color: #68806f;
        margin-bottom: 13px;
    }

    .hto-breadcrumb .fa-chevron-right {
        font-size: 9px;
    }

    .hto-hero h1 {
        margin: 0 0 8px;
        font-size: clamp(22px, 2vw, 28px);
        font-weight: 800;
        color: #155336;
        letter-spacing: -.5px;
    }

    .hto-hero h1 i {
        margin-right: 9px;
    }

    .hto-hero p {
        color: #718277;
        font-size: 13px;
        margin: 0;
    }

    .hto-hero-decoration {
        font-size: 75px;
        color: #a5c8b0;
        transform: rotate(-17deg);
        padding-right: 35px;
        opacity: .65;
    }

    .hto-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .hto-stat {
        background: #fff;
        border: 1px solid var(--hto-border);
        border-radius: 17px;
        padding: 19px 17px;
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        box-shadow: 0 5px 18px rgba(30, 72, 44, .035);
    }

    .hto-stat-icon {
        width: 51px;
        height: 51px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 15px;
        font-size: 21px;
    }

    .hto-stat-icon.green { background: #e4f5e9; color: #17814c; }
    .hto-stat-icon.gold { background: #fff3d5; color: #c28a12; }
    .hto-stat-icon.blue { background: #e5f2ff; color: #2878c3; }
    .hto-stat-icon.red { background: #ffe9e9; color: #d85151; }

    .hto-stat span {
        display: block;
        font-size: 12px;
        color: #718077;
        margin-bottom: 5px;
    }

    .hto-stat strong {
        display: block;
        color: #1e4833;
        font-size: 23px;
        line-height: 1.3;
    }

    .hto-stat small {
        display: block;
        font-size: 10px;
        color: #97a299;
        margin-top: 4px;
        overflow-wrap: anywhere;
    }

    .hto-panel {
        background: #fff;
        border: 1px solid var(--hto-border);
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(30, 72, 44, .035);
        margin-bottom: 19px;
        overflow: hidden;
    }

    .hto-filter-panel {
        padding: 23px;
    }

    .hto-panel-title,
    .hto-table-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .hto-panel-title {
        margin-bottom: 18px;
    }

    .hto-panel-title h2,
    .hto-table-heading h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 800;
        color: #244934;
    }

    .hto-panel-title h2 i {
        color: #1e8551;
        margin-right: 6px;
    }

    .hto-panel-title > span,
    .hto-table-heading p {
        color: #93a096;
        font-size: 12px;
    }

    .hto-filter-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 16px;
    }

    .hto-field {
        min-width: 0;
    }

    .hto-field label {
        display: block;
        color: #52675a;
        font-weight: 600;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .hto-field input,
    .hto-field select {
        display: block;
        width: 100%;
        min-width: 0;
        height: 43px;
        padding: 0 12px;
        border-radius: 10px;
        border: 1px solid #dce6dc;
        background: #fff;
        color: #344b3c;
        font-size: 12px;
        outline: none;
    }

    .hto-field input:focus,
    .hto-field select:focus {
        border-color: #38845a;
        box-shadow: 0 0 0 3px rgba(43, 139, 82, .08);
    }

    .hto-input-icon {
        position: relative;
    }

    .hto-input-icon > i {
        position: absolute;
        left: 13px;
        top: 14px;
        color: #7e9986;
        font-size: 13px;
    }

    .hto-input-icon input {
        padding-left: 36px;
    }

    .hto-filter-actions {
        display: flex;
        gap: 8px;
    }

    .hto-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        min-height: 43px;
        border-radius: 10px;
        border: 1px solid transparent;
        text-decoration: none;
        font-weight: 700;
        font-size: 12px;
        white-space: nowrap;
        cursor: pointer;
        transition: .2s;
    }

    .hto-btn.primary {
        color: #fff;
        background: #177343;
    }

    .hto-btn.primary:hover { background: #115a33; color: #fff; }

    .hto-btn.outline {
        color: #246a43;
        border-color: #b9d7c2;
        background: #fff;
    }

    .hto-btn.outline:hover { background: #eaf5ed; }

    .hto-btn.export {
        color: #fff;
        background: #278352;
    }

    .hto-filter-footer {
        border-top: 1px solid #edf0eb;
        padding-top: 15px;
        margin-top: 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-size: 11px;
        color: #8b998d;
    }

    .hto-filter-footer i { margin-right: 4px; }

    .hto-notice {
        border-radius: 12px;
        padding: 13px 16px;
        margin-bottom: 14px;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .hto-notice.info { background: #eaf4ff; color: #23609d; }
    .hto-notice.success { background: #e9f7ee; color: #247447; }
    .hto-notice.error { background: #fff0eb; color: #ae4032; }
    .hto-notice a { color: inherit; font-weight: 700; }

    .hto-table-heading {
