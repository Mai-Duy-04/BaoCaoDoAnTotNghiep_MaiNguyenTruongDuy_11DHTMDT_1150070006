<script>
(function () {
    "use strict";

    function initOrdersPage() {
        const table = document.getElementById("htoOrderTable");
        const empty = document.getElementById("htoEmpty");
        const info = document.getElementById("htoPageInfo");
        const buttons = document.getElementById("htoPageButtons");
        const tabs = Array.from(document.querySelectorAll(".hto-tab"));
        const filterForm = document.getElementById("htoFilterForm");

        if (!table || !empty || !info || !buttons) return;

        const rows = Array.from(table.querySelectorAll("tbody .hto-order-row"));
        const perPage = 10;

        let currentTab = "all";
        let currentPage = 1;

        function getFilteredRows() {
            if (currentTab === "all") return rows;

            return rows.filter(row =>
                row.dataset.category === currentTab
            );
        }

        function createButton(label, page, disabled, active) {
            const button = document.createElement("button");

            button.type = "button";
            button.className = "hto-page-btn" + (active ? " active" : "");
            button.textContent = label;
            button.disabled = disabled;

            if (active) button.setAttribute("aria-current", "page");

            button.addEventListener("click", function () {
                currentPage = page;
                render();

                document.querySelector(".hto-table-panel")
                    ?.scrollIntoView({ behavior: "smooth", block: "start" });
            });

            return button;
        }

        function render() {
            const filtered = getFilteredRows();
            const count = filtered.length;
            const pages = Math.max(1, Math.ceil(count / perPage));

            currentPage = Math.max(1, Math.min(currentPage, pages));

            const start = (currentPage - 1) * perPage;
            const visible = filtered.slice(start, start + perPage);
            const visibleSet = new Set(visible);

            rows.forEach(row => {
                row.hidden = !visibleSet.has(row);
                row.style.display = visibleSet.has(row) ? "" : "none";
            });

            empty.hidden = count !== 0;
            table.style.display = count === 0 ? "none" : "";

            info.textContent = count === 0
                ? "Không có đơn phù hợp"
                : "Hiển thị " + (start + 1) + " – " +
                  Math.min(start + perPage, count) +
                  " trong " + count + " đơn";

            buttons.replaceChildren();

            if (count === 0 || pages <= 1) return;

            buttons.appendChild(
                createButton("‹", currentPage - 1, currentPage === 1, false)
            );

            const firstPage = Math.max(1, currentPage - 2);
            const lastPage = Math.min(pages, firstPage + 4);

            for (let page = Math.max(1, lastPage - 4); page <= lastPage; page++) {
                buttons.appendChild(
                    createButton(String(page), page, false, page === currentPage)
                );
            }

            buttons.appendChild(
                createButton("›", currentPage + 1, currentPage === pages, false)
            );
        }

        tabs.forEach(tab => {
            tab.addEventListener("click", function () {
                currentTab = tab.dataset.tab || "all";
                currentPage = 1;

                tabs.forEach(item => {
                    const selected = item === tab;
                    item.classList.toggle("active", selected);
                    item.setAttribute("aria-pressed", String(selected));
                });

                render();
            });
        });

        tabs.forEach(tab => {
            tab.setAttribute("aria-pressed",
                String(tab.classList.contains("active")));
        });

        if (filterForm) {
            filterForm.addEventListener("submit", function (event) {
                const from = document.getElementById("htoFromDate")?.value;
                const to = document.getElementById("htoToDate")?.value;

                if (from && to && from > to) {
                    event.preventDefault();
                    alert("Ngày bắt đầu không được lớn hơn ngày kết thúc.");
                }
            });
        }

        render();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initOrdersPage);
    } else {
        initOrdersPage();
    }
})();
</script>
