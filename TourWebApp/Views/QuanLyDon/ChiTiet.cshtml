
@model TourWebApp.Data.Models.DonDatTour
@using System

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chi tiết đơn đặt tour";

    var don = Model;
    var khach = don.IdTaiKhoanNavigation;
    var tour = don.IdTourNavigation;
    var lich = don.IdLichNavigation;

    var daHuy = don.TrangThai == "DaHuy";
    var daThanhToan = don.DaThanhToan;
    var hoanTat = don.TrangThai == "HoanTat";
    var choTienMat = !daThanhToan
        && !daHuy
        && don.TrangThai == "ChoXacNhanTienMat"
        && string.Equals(
            don.PhuongThucTT,
            "TienMat",
            StringComparison.OrdinalIgnoreCase);

    var hetHan = !daThanhToan
        && !daHuy
        && don.HanThanhToan.HasValue
        && don.HanThanhToan.Value < DateTime.Now;

    var tongTien = don.TongTien;
    var giamGia = don.SoTienGiam ?? 0m;
    var thanhToan = Math.Max(
        0m,
        don.TongTienSauGiam ?? (tongTien - giamGia));

    var tongKhach = don.NguoiLon + don.TreEm + don.TreNho;

    var trangThaiDon = don.TrangThai switch
    {
        "ChoThanhToan" => "Chờ thanh toán",
        "ChoXacNhanTienMat" => "Chờ xác nhận tiền mặt",
        "ThanhToanThanhCong" => "Đã thanh toán",
        "HoanTat" => "Hoàn tất",
        "DaHuy" => "Đã hủy",
        "ChoDuyet" => "Chờ duyệt",
        "DaDuyet" => "Đã duyệt",
        _ => don.TrangThai ?? "Chưa cập nhật"
    };

    var trangThaiTT = daThanhToan
        ? "Đã thanh toán"
        : daHuy ? "Đã hủy"
        : hetHan ? "Hết hạn thanh toán"
        : choTienMat ? "Chờ thu tiền mặt"
        : "Chưa thanh toán";

    var paymentClass = daThanhToan
        ? "success"
        : daHuy || hetHan ? "danger" : "warning";

    var bookingClass = daHuy
        ? "danger"
        : hoanTat || daThanhToan ? "success" : "warning";
}

<div class="ht-order-detail">

    <div class="htod-header">
        <div>
            <div class="htod-breadcrumb">
                <a asp-controller="QuanLyDon" asp-action="Index">
                    Quản lý đặt tour
                </a>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Chi tiết đơn</span>
            </div>

            <h1>
                <i class="fa-regular fa-file-lines"></i>
                Chi tiết đơn đặt tour
            </h1>

            <p>
                Kiểm tra thông tin đặt chỗ, giao dịch và tình trạng xử lý.
            </p>
        </div>

        <a asp-controller="QuanLyDon"
           asp-action="Index"
           class="htod-btn secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Quay lại danh sách
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="htod-alert success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="htod-alert info">
            <i class="fa-solid fa-circle-info"></i>
            @TempData["Info"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="htod-alert danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    <section class="htod-overview">
        <div class="htod-booking">
            <div class="htod-booking-icon">
                <i class="fa-solid fa-ticket"></i>
            </div>

            <div>
                <span>Mã booking</span>
                <h2>@don.MaBooking</h2>
                <p>
                    Ngày đặt:
                    @don.NgayDat.ToString("HH:mm - dd/MM/yyyy")
                </p>
            </div>
        </div>

        <div class="htod-overview-status">
            <div>
                <small>Trạng thái đơn</small>
                <span class="htod-badge @bookingClass">
                    @trangThaiDon
                </span>
            </div>

            <div>
                <small>Thanh toán</small>
                <span class="htod-badge @paymentClass">
                    @trangThaiTT
                </span>
            </div>
        </div>
    </section>

    <div class="htod-grid">

        <main class="htod-main">

            <section class="htod-card">
                <div class="htod-card-head">
                    <div class="htod-head-icon">
                        <i class="fa-regular fa-user"></i>
                    </div>
                    <div>
                        <h3>Thông tin khách hàng</h3>
                        <p>Thông tin tài khoản thực hiện đặt tour</p>
                    </div>
                </div>

                <div class="htod-fields">
                    <div class="htod-field">
                        <span>Họ và tên</span>
                        <strong>@(khach?.HoTen ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="htod-field">
                        <span>Số điện thoại</span>
                        <strong>@(khach?.SoDienThoai ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="htod-field full">
                        <span>Địa chỉ email</span>
                        <strong>@(khach?.Email ?? "Chưa cập nhật")</strong>
                    </div>
                </div>
            </section>

            <section class="htod-card">
                <div class="htod-card-head">
                    <div class="htod-head-icon">
                        <i class="fa-solid fa-route"></i>
                    </div>
                    <div>
                        <h3>Thông tin tour</h3>
                        <p>Hành trình khách hàng đã lựa chọn</p>
                    </div>
                </div>

                <div class="htod-tour-title">
                    <i class="fa-solid fa-location-dot"></i>
                    <strong>@(tour?.TenTour ?? "Tour không xác định")</strong>
                </div>

                <div class="htod-fields">
                    <div class="htod-field">
                        <span>Điểm đến</span>
                        <strong>@(tour?.DiaDiem ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="htod-field">
                        <span>Ngày khởi hành</span>
                        <strong>
                            @(lich?.NgayKhoiHanh.ToString("dd/MM/yyyy") ?? "Chưa có")
                        </strong>
                    </div>

                    <div class="htod-field">
                        <span>Tổng số khách</span>
                        <strong>@tongKhach khách</strong>
                    </div>

                    <div class="htod-field">
                        <span>Chi tiết hành khách</span>
                        <strong>
                            @don.NguoiLon NL · @don.TreEm TE · @don.TreNho EB
                        </strong>
                    </div>
                </div>
            </section>

            <section class="htod-card">
                <div class="htod-card-head">
                    <div class="htod-head-icon">
                        <i class="fa-regular fa-credit-card"></i>
                    </div>
                    <div>
                        <h3>Thông tin thanh toán</h3>
                        <p>Đối chiếu số tiền và phương thức giao dịch</p>
                    </div>
                </div>

                <div class="htod-fields">
                    <div class="htod-field">
                        <span>Phương thức thanh toán</span>
                        <strong>@(don.PhuongThucTT ?? "Chưa chọn")</strong>
                    </div>

                    <div class="htod-field">
                        <span>Trạng thái thanh toán</span>
                        <span class="htod-badge @paymentClass">
                            @trangThaiTT
                        </span>
                    </div>

                    <div class="htod-field">
                        <span>Thời hạn thanh toán</span>
                        <strong>
                            @(don.HanThanhToan?.ToString("HH:mm dd/MM/yyyy") ?? "Không có")
                        </strong>
                    </div>

                    <div class="htod-field">
                        <span>Ngày thanh toán</span>
                        <strong>
                            @(don.NgayThanhToan?.ToString("HH:mm dd/MM/yyyy") ?? "Chưa thanh toán")
                        </strong>
                    </div>

                    <div class="htod-field full">
                        <span>Mã giao dịch lưu tại hệ thống</span>
                        <strong class="htod-code">
                            @(string.IsNullOrWhiteSpace(don.MaGiaoDich)
                                ? "Chưa có"
                                : don.MaGiaoDich)
                        </strong>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(don.GhiChu))
            {
                <section class="htod-card">
                    <div class="htod-card-head">
                        <div class="htod-head-icon">
                            <i class="fa-regular fa-note-sticky"></i>
                        </div>
                        <div>
                            <h3>Ghi chú đơn hàng</h3>
                            <p>Thông tin bổ sung được lưu cùng đơn</p>
                        </div>
                    </div>

                    <p class="htod-notes">@don.GhiChu</p>
                </section>
            }

        </main>

        <aside class="htod-sidebar">

            <section class="htod-card">
                <div class="htod-card-head">
                    <div class="htod-head-icon">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <div>
                        <h3>Tổng kết thanh toán</h3>
                        <p>Chi tiết giá trị đơn đặt tour</p>
                    </div>
                </div>

                <div class="htod-money-row">
                    <span>Tổng tiền gốc</span>
                    <strong>@tongTien.ToString("N0") đ</strong>
                </div>

                <div class="htod-money-row">
                    <span>Giảm giá</span>
                    <strong class="discount">
                        -@giamGia.ToString("N0") đ
                    </strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(don.MaPhieuGiamGia))
                {
                    <div class="htod-voucher">
                        <i class="fa-solid fa-ticket"></i>
                        Mã ưu đãi: @don.MaPhieuGiamGia
                    </div>
                }

                <div class="htod-money-total">
                    <span>Tổng thanh toán</span>
                    <strong>@thanhToan.ToString("N0") đ</strong>
                </div>
            </section>

            <section class="htod-card">
                <div class="htod-card-head">
                    <div class="htod-head-icon">
                        <i class="fa-solid fa-gear"></i>
                    </div>
                    <div>
                        <h3>Xử lý đơn hàng</h3>
                        <p>Thao tác quản trị theo trạng thái</p>
                    </div>
                </div>

                <a class="htod-btn primary full"
                   asp-controller="QuanTri"
                   asp-action="ExportHoaDon"
                   asp-route-idDon="@don.IdDon">
                    <i class="fa-solid fa-file-pdf"></i>
                    Xuất hóa đơn PDF
                </a>

                @if (choTienMat && !hetHan)
                {
                    <div class="htod-action-note">
                        <i class="fa-solid fa-circle-info"></i>
                        Chỉ xác nhận khi nhân viên đã thực sự
                        thu đủ tiền mặt từ khách hàng.
                    </div>

                    <form asp-controller="QuanLyDon"
                          asp-action="XacNhanDonChoThuTienMat"
                          method="post"
                          onsubmit="return confirm('Xác nhận đã thu tiền mặt đầy đủ và hoàn tất thanh toán cho đơn này?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@don.IdDon" />

                        <button type="submit"
                                class="htod-btn confirm full">
                            <i class="fa-solid fa-check-double"></i>
                            Xác nhận đã thu tiền mặt
                        </button>
                    </form>
                }
                else if (daThanhToan)
                {
                    <div class="htod-action-note success">
                        <i class="fa-solid fa-circle-check"></i>
                        Đơn đã được xác nhận thanh toán.
                        Không cần xác nhận lại.
                    </div>
                }
                else if (daHuy)
                {
                    <div class="htod-action-note">
                        Đơn đã hủy, không thể xác nhận thu tiền.
                    </div>
                }
                else if (hetHan)
                {
                    <div class="htod-action-note">
                        Đơn đã vượt thời hạn thanh toán.
                        Vui lòng kiểm tra trạng thái hệ thống.
                    </div>
                }
                else
                {
                    <div class="htod-action-note">
                        Đơn chưa hoàn tất thanh toán.
                        Với VNPay, trạng thái phải được
                        xác thực từ kết quả giao dịch.
                    </div>
                }
            </section>

        </aside>
    </div>
</div>

<style>
    .ht-order-detail {
        --od-green: #17693e;
        --od-dark: #214936;
        --od-text: #293e32;
        --od-muted: #819184;
        --od-border: #e5eee6;
        font-family: "Be Vietnam Pro", Arial, sans-serif;
        color: var(--od-text);
        padding: 10px 4px 34px;
    }

    .ht-order-detail *,
    .ht-order-detail *::before,
    .ht-order-detail *::after {
        box-sizing: border-box;
    }

    .htod-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 23px 26px;
        background: linear-gradient(110deg, #edf7ef, #f8faf7);
        border-radius: 19px;
        margin-bottom: 20px;
    }

    .htod-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        font-size: 12px;
        color: #819385;
    }

    .htod-breadcrumb a {
        color: #2e7750;
        text-decoration: none;
    }

    .htod-breadcrumb i {
        font-size: 9px;
    }

    .htod-header h1 {
        margin: 0 0 7px;
        color: #165538;
        font-size: clamp(21px, 2.1vw, 27px);
        font-weight: 800;
    }

    .htod-header h1 i {
        margin-right: 9px;
    }

    .htod-header p {
        color: #809186;
        font-size: 12px;
        margin: 0;
    }

    .htod-overview {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 23px 26px;
        margin-bottom: 20px;
        background: #fff;
        border: 1px solid var(--od-border);
        border-radius: 19px;
        box-shadow: 0 5px 22px rgba(29, 71, 42, .04);
    }

    .htod-booking {
        display: flex;
        align-items: center;
        gap: 17px;
        min-width: 0;
    }

    .htod-booking-icon {
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 17px;
        color: #177644;
        background: #e5f5e9;
        font-size: 25px;
    }

    .htod-booking span,
    .htod-overview-status small {
        display: block;
        color: #829285;
        font-size: 12px;
    }

    .htod-booking h2 {
        color: #1d5837;
        font-size: 20px;
        font-weight: 800;
        margin: 5px 0;
        overflow-wrap: anywhere;
    }

    .htod-booking p {
        font-size: 11px;
        color: #92a095;
        margin: 0;
    }

    .htod-overview-status {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .htod-overview-status > div {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .htod-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr);
        gap: 20px;
        align-items: start;
    }

    .htod-main,
    .htod-sidebar {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .htod-card {
        padding: 24px;
        background: #fff;
        border: 1px solid var(--od-border);
        border-radius: 19px;
        box-shadow: 0 6px 22px rgba(29, 71, 42, .035);
    }

    .htod-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
        padding-bottom: 17px;
        border-bottom: 1px solid #edf1ed;
    }

    .htod-head-icon {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        color: #21814e;
        background: #eaf7ed;
        border-radius: 12px;
        font-size: 17px;
    }

    .htod-card-head h3 {
        color: #24503a;
        font-size: 15px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .htod-card-head p {
        color: #94a297;
        font-size: 11px;
        margin: 0;
    }

    .htod-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 23px 18px;
    }

    .htod-field {
        min-width: 0;
    }

    .htod-field.full {
        grid-column: 1 / -1;
    }

    .htod-field > span:first-child {
        display: block;
        margin-bottom: 7px;
        color: #8b9a90;
        font-size: 11px;
    }

    .htod-field strong {
        display: block;
        color: #32483a;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .htod-field .htod-badge {
        display: inline-flex;
    }

    .htod-tour-title {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 22px;
        padding: 15px;
        background: #f5faf6;
        border: 1px solid #e9f1e9;
        border-radius: 12px;
    }

    .htod-tour-title i {
        margin-top: 4px;
        color: #238150;
    }

    .htod-tour-title strong {
        line-height: 1.7;
        font-size: 13px;
        color: #234f38;
    }

    .htod-badge {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        border-radius: 30px;
        padding: 7px 12px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .htod-badge.success {
        color: #187743;
        background: #e0f5e7;
    }

    .htod-badge.warning {
        color: #aa7b17;
        background: #fff0c9;
    }

    .htod-badge.danger {
        color: #c84848;
        background: #ffeded;
    }

    .htod-money-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
        color: #78887d;
        font-size: 12px;
    }

    .htod-money-row strong {
        color: #334b3b;
        font-size: 13px;
    }

    .htod-money-row .discount {
        color: #2d9658;
    }

    .htod-money-total {
        margin-top: 14px;
        padding: 20px 15px;
        background: #eaf6ee;
        border-radius: 12px;
    }

    .htod-money-total span {
        display: block;
        margin-bottom: 8px;
        color: #50735b;
        font-size: 12px;
    }

    .htod-money-total strong {
        color: #156a3c;
        font-size: clamp(21px, 2vw, 27px);
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .htod-voucher {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        color: #287a4b;
        background: #f0faf2;
        border-radius: 9px;
        font-size: 11px;
        margin-top: 10px;
    }

    .htod-code {
        font-family: Consolas, monospace;
    }

    .htod-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 42px;
        padding: 11px 16px;
        border-radius: 10px;
        border: 1px solid transparent;
        text-decoration: none;
        text-align: center;
        font-weight: 700;
        font-size: 12px;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }

    .htod-btn:hover {
        transform: translateY(-1px);
    }

    .htod-btn.full {
        width: 100%;
    }

    .htod-btn.primary {
        background: #207747;
        color: #fff;
    }

    .htod-btn.primary:hover {
        background: #155f36;
        color: #fff;
    }

    .htod-btn.secondary {
        background: white;
        color: #2e7650;
        border-color: #cce4d2;
    }

    .htod-btn.confirm {
        background: #176b3d;
        color: #fff;
        margin-top: 13px;
    }

    .htod-btn.confirm:hover {
        background: #10542e;
    }

    .htod-action-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 13px;
        background: #fff6e6;
        border: 1px solid #f5e5c6;
        color: #876527;
        border-radius: 10px;
        font-size: 11px;
        line-height: 1.8;
        margin-top: 16px;
    }

    .htod-action-note.success {
        background: #e9f7ee;
        border-color: #d6eddd;
        color: #247548;
    }

    .htod-notes {
        color: #526a59;
        font-size: 12px;
        line-height: 1.9;
        white-space: pre-wrap;
        margin: 0;
    }

    .htod-alert {
        padding: 13px 16px;
        border-radius: 10px;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;
    }

    .htod-alert.success {
        color: #247448;
        background: #e9f7ee;
    }

    .htod-alert.info {
        color: #27639b;
        background: #eaf4ff;
    }

    .htod-alert.danger {
        color: #b34339;
        background: #fff0ed;
    }

    @@media (max-width: 1100px) {
        .htod-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .htod-header,
        .htod-overview {
            flex-direction: column;
            align-items: flex-start;
        }

        .htod-header,
        .htod-overview,
        .htod-card {
            padding: 18px;
        }

        .htod-overview-status {
            flex-wrap: wrap;
        }
    }

