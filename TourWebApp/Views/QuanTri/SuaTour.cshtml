<script src="~/js/upload-anh-tour.js"
        asp-append-version="true"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const form = document.getElementById("htEditTourForm");
    if (!form) return;

    /* ==========================================
       1. PRICE MODE AND CALCULATION
       ========================================== */

    const originalInput = document.getElementById("giaGoc");
    const discountInput = document.getElementById("phanTramGiam");
    const saleInput = document.getElementById("giaKhuyenMai");
    const salePreview = document.getElementById("htEditSalePreview");

    const adultInput = document.getElementById("htEditAdult");
    const childInput = document.getElementById("htEditChild");
    const infantInput = document.getElementById("htEditInfant");

    const priceModeValue = document.getElementById(
        "htEditPriceModeValue"
    );

    const modeRadios = Array.from(
        form.querySelectorAll(".ht-edit-mode-radio")
    );

    const modeBadge = document.getElementById(
        "htEditModeBadge"
    );

    const modeBadgeText = document.getElementById(
        "htEditModeBadgeText"
    );

    const modeHelp = document.getElementById(
        "htEditPriceModeHelp"
    );

    const formatter = new Intl.NumberFormat("vi-VN", {
        maximumFractionDigits: 0
    });

    function positiveNumber(value) {
        const number = Number(value);

        return Number.isFinite(number)
            ? Math.max(0, number)
            : 0;
    }

    function getDiscount() {
        return Math.min(
            100,
            positiveNumber(discountInput?.value)
        );
    }

    function getSalePrice() {
        const original = positiveNumber(
            originalInput?.value
        );

        return Math.round(
            original * (1 - getDiscount() / 100)
        );
    }

    function getPriceMode() {
        const selected = modeRadios.find(
            radio => radio.checked
        );

        return selected?.value === "TuyChinh"
            ? "TuyChinh"
            : "TuDong";
    }

    function syncPriceModeValue() {
        if (priceModeValue) {
            priceModeValue.value = getPriceMode();
        }
    }

    function calculateSalePreview() {
        const salePrice = getSalePrice();

        if (saleInput) {
            saleInput.value = salePrice;
        }

        if (salePreview) {
            salePreview.textContent =
                formatter.format(salePrice) + " đ";
        }

        return salePrice;
    }

    // Giá người lớn = giá sau giảm.
    // Giá trẻ em = 50% người lớn.
    // Giá em bé = 0.
    function applyAutomaticPrices() {
        const salePrice = calculateSalePreview();

        if (adultInput) {
            adultInput.value = salePrice;
        }

        if (childInput) {
            childInput.value = Math.round(
                salePrice * 0.5
            );
        }

        if (infantInput) {
            infantInput.value = 0;
        }
    }

    // Không dùng disabled vì các input vẫn cần
    // gửi giá trị trong POST lên Controller.
    function setPriceInputsReadOnly(readonly) {
        [adultInput, childInput, infantInput]
            .forEach(function (input) {

                if (input) {
                    input.readOnly = readonly;
                }
            });
    }

    function updatePriceModeVisual() {
        const isAuto = getPriceMode() === "TuDong";

        setPriceInputsReadOnly(isAuto);

        if (modeBadge) {
            modeBadge.classList.toggle(
                "custom",
                !isAuto
            );
        }

        if (modeBadgeText) {
            modeBadgeText.textContent = isAuto
                ? "Đang sử dụng giá tự động"
                : "Đang sử dụng giá tùy chỉnh";
        }

        if (modeHelp) {
            modeHelp.innerHTML = isAuto
                ? "<strong>Chế độ tự động:</strong> " +
                  "Người lớn bằng giá sau giảm, " +
                  "trẻ em bằng 50% người lớn, " +
                  "em bé bằng 0 đồng."
                : "<strong>Chế độ tùy chỉnh:</strong> " +
                  "Có thể nhập mức giá riêng cho " +
                  "người lớn, trẻ em và em bé. " +
                  "Thay đổi giảm giá không tự ghi đè " +
                  "các mức giá này.";
        }

        syncPriceModeValue();
    }

    function handlePriceChanged() {
        calculateSalePreview();

        if (getPriceMode() === "TuDong") {
            applyAutomaticPrices();
        }
    }

    function handleModeChanged() {
        updatePriceModeVisual();

        // Chỉ tự tính lại khi Admin chọn
        // chuyển sang chế độ tự động.
        if (getPriceMode() === "TuDong") {
            applyAutomaticPrices();
        } else {
            calculateSalePreview();
        }
    }

    originalInput?.addEventListener(
        "input",
        handlePriceChanged
    );

    discountInput?.addEventListener(
        "input",
        handlePriceChanged
    );

    modeRadios.forEach(function (radio) {
        radio.addEventListener(
            "change",
            handleModeChanged
        );
    });

    // Khi vừa mở trang:
    // giữ nguyên giá đang có nếu đang tùy chỉnh.
    updatePriceModeVisual();

    if (getPriceMode() === "TuDong") {
        applyAutomaticPrices();
    } else {
        calculateSalePreview();
    }

    /* ==========================================
       2. TOUR TOPICS
       ========================================== */

    const topicCheckboxes = Array.from(
        form.querySelectorAll(
            ".ht-edit-topic-checkbox"
        )
    );

    const selectedTopicCount = document.getElementById(
        "htEditSelectedTopicCount"
    );

    const topicError = document.getElementById(
        "htEditTopicError"
    );

    function updateTopicCount() {
        const count = topicCheckboxes.filter(
            checkbox => checkbox.checked
        ).length;

        if (selectedTopicCount) {
            selectedTopicCount.textContent = count;
        }

        if (topicError && count > 0) {
            topicError.style.display = "none";
        }

        return count;
    }

    topicCheckboxes.forEach(function (checkbox) {
        checkbox.addEventListener(
            "change",
            updateTopicCount
        );
    });

    updateTopicCount();

    /* ==========================================
       3. EXISTING IMAGES
       ========================================== */

    const imageItems = Array.from(
        form.querySelectorAll(
            "#htEditExistingPhotos .preview-item"
        )
    );

    function getRemainingImages() {
        return imageItems.filter(function (item) {

            const deleteCheckbox = item.querySelector(
                ".delete-image-checkbox"
            );

            return deleteCheckbox && !deleteCheckbox.checked;
        });
    }

    imageItems.forEach(function (item) {

        const removeButton = item.querySelector(
            ".remove-current-image"
        );

        const deleteCheckbox = item.querySelector(
            ".delete-image-checkbox"
        );

        const thumbnailRadio = item.querySelector(
            "input[name='Thumbnail']"
        );

        if (!removeButton || !deleteCheckbox) {
            return;
        }

        removeButton.addEventListener("click", function () {

            const willDelete = !deleteCheckbox.checked;

            deleteCheckbox.checked = willDelete;

            item.classList.toggle(
                "is-marked-delete",
                willDelete
            );

            if (willDelete && thumbnailRadio?.checked) {
                thumbnailRadio.checked = false;
            }

            if (thumbnailRadio) {
                thumbnailRadio.disabled = willDelete;
            }

            removeButton.title = willDelete
                ? "Bỏ đánh dấu xóa ảnh"
                : "Đánh dấu xóa ảnh";

            removeButton.setAttribute(
                "aria-label",
                removeButton.title
            );
        });
    });

    /* ==========================================
       4. UPLOAD IMAGE KEYBOARD SUPPORT
       ========================================== */

    const dropZone = document.getElementById(
        "drop-zone"
    );

    const fileInput = document.getElementById(
        "fileInput"
    );

    dropZone?.addEventListener(
        "keydown",
        function (event) {

            if (
                event.target === dropZone &&
                (
                    event.key === "Enter" ||
                    event.key === " "
                )
            ) {
                event.preventDefault();
                fileInput?.click();
            }
        }
    );

    /* ==========================================
       5. FORM SUBMIT
       ========================================== */

    form.addEventListener("submit", function (event) {

        // Đồng bộ dữ liệu giá ngay trước POST.
        syncPriceModeValue();

        calculateSalePreview();

        if (getPriceMode() === "TuDong") {
            applyAutomaticPrices();
        }

        // Phải chọn ít nhất một chủ đề.
        const selectedCount = updateTopicCount();

        if (selectedCount === 0) {
            event.preventDefault();

            if (topicError) {
                topicError.style.display = "block";
            }

            document.getElementById(
                "htEditTopicGrid"
            )?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

            return;
        }

        // Nếu ảnh đại diện đã bị đánh dấu xóa,
        // chọn ảnh cũ đầu tiên còn lại.
        const selectedThumbnail = form.querySelector(
            "input[name='Thumbnail']:checked"
        );

        if (!selectedThumbnail) {
            const availableImages = getRemainingImages();

            if (availableImages.length > 0) {
                const firstRadio = availableImages[0]
                    .querySelector(
                        "input[name='Thumbnail']"
                    );

                if (firstRadio) {
                    firstRadio.checked = true;
                }
            }
        }
    });

});
</script>
