
@model TourWebApp.Data.Models.Tour
@using System.Globalization
@using TourWebApp.Data.Models

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa tour";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var loaiTours = ViewBag.LoaiTours as List<LoaiTour> ?? new List<LoaiTour>();

    var existingImages = Model.HinhTours?
        .OrderBy(x => x.ThuTu)
        .ThenBy(x => x.IdHinh)
        .ToList() ?? new List<HinhTour>();

    var currentThumbnail = TourImagePathHelper.NormalizeTourImagePath(Model.HinhAnh);

    var coverImage = !string.IsNullOrWhiteSpace(Model.HinhAnh)
        ? TourImagePathHelper.ToTourImageSrc(Model.HinhAnh)
        : existingImages.Count > 0
            ? TourImagePathHelper.ToTourImageSrc(existingImages[0].UrlHinh)
            : Url.Content("~/img/no-image.png");

    var adultPrice = Convert.ToDecimal(ViewBag.GiaNguoiLon ?? 0m);
    var childPrice = Convert.ToDecimal(ViewBag.GiaTreEm ?? 0m);
    var infantPrice = Convert.ToDecimal(ViewBag.GiaEmBe ?? 0m);

    var originalPrice = Model.GiaGoc ?? 0m;
    var discountPercent = Model.PhanTramGiam ?? 0m;

    var salePrice = Math.Round(
        originalPrice * (100m - discountPercent) / 100m,
        0,
        MidpointRounding.AwayFromZero
    );

    var autoChildPrice = Math.Round(
        salePrice * 0.5m,
        0,
        MidpointRounding.AwayFromZero
    );

    // Giữ nguyên giá đang lưu khi mở trang.
    // Chỉ mặc định tự động nếu cả ba mức giá khớp công thức.
    var initialPriceMode =
        adultPrice == salePrice &&
        childPrice == autoChildPrice &&
        infantPrice == 0m
            ? "TuDong"
            : "TuyChinh";

    // Khi Controller trả lại form do lỗi, ưu tiên chế độ vừa gửi.
    var postedPriceMode = Context.Request.HasFormContentType
        ? Context.Request.Form["CheDoGia"].ToString()
        : "";

    if (postedPriceMode == "TuDong" || postedPriceMode == "TuyChinh")
    {
        initialPriceMode = postedPriceMode;
    }

    var savedTopicCodes =
        (ViewBag.SelectedMaSoThichs as IEnumerable<string>
            ?? Array.Empty<string>())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    var topicOptions = new[]
    {
        new { Code = "BIEN", Name = "Biển đảo", Icon = "fa-water" },
        new { Code = "NUI", Name = "Núi rừng", Icon = "fa-mountain" },
        new { Code = "VANHOA", Name = "Văn hóa", Icon = "fa-landmark" },
        new { Code = "LICHSU", Name = "Lịch sử", Icon = "fa-building-columns" },
        new { Code = "THANHPHO", Name = "Thành phố", Icon = "fa-city" },
        new { Code = "CHECKIN", Name = "Check-in", Icon = "fa-camera" },
        new { Code = "MAOHIEM", Name = "Mạo hiểm", Icon = "fa-person-hiking" },
        new { Code = "SINHTHAI", Name = "Sinh thái", Icon = "fa-leaf" },
        new { Code = "SONGNUOC", Name = "Sông nước", Icon = "fa-ship" },
        new { Code = "AMTHUC", Name = "Ẩm thực", Icon = "fa-utensils" }
    };
}

<style>
    .ht-edit {
        --ht-green: #248b55;
        --ht-dark: #1b5338;
        --ht-ink: #315a42;
        --ht-muted: #819688;
        --ht-border: #e0e9dc;
        --ht-soft: #f6faf3;

        width: min(100%, 1390px);
        min-width: 0;
        margin: 0 auto;
        padding: 8px 3px 34px;
        color: var(--ht-ink);
        font-family: "Plus Jakarta Sans", "Segoe UI", Arial, sans-serif;
    }

    .ht-edit *,
    .ht-edit *::before,
    .ht-edit *::after {
        box-sizing: border-box;
    }

    .ht-edit a {
        text-decoration: none;
    }

    .ht-edit input,
    .ht-edit select,
    .ht-edit textarea,
    .ht-edit button {
        font: inherit;
    }

    /* HEADER */

    .ht-edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 17px;
    }

    .ht-edit-eyebrow {
        display: block;
        margin-bottom: 7px;
        color: #439565;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .ht-edit-header h1 {
        margin: 0 0 5px;
        color: var(--ht-dark);
        font-size: clamp(23px, 2.2vw, 30px);
        font-weight: 800;
    }

    .ht-edit-header p {
        margin: 0;
        color: var(--ht-muted);
        font-size: 12px;
    }

    .ht-edit-back,
    .ht-edit-save,
    .ht-edit-cancel {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        min-height: 41px;
        padding: 10px 15px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .ht-edit .ht-edit-back,
    .ht-edit .ht-edit-cancel {
        background: #fff;
        border: 1px solid #dce8d9;
        color: #4d765c;
    }

    .ht-edit .ht-edit-save {
        background: #268d56;
        border: 1px solid #268d56;
        color: #fff;
    }

    .ht-edit .ht-edit-save:hover {
        background: #197345;
    }

    .ht-edit-validation {
        margin-bottom: 15px;
        padding: 12px 15px;
        border: 1px solid #efc5bb;
        border-radius: 11px;
        background: #fff2ef;
        color: #a74739;
        font-size: 12px;
    }

    .ht-edit-validation:empty {
        display: none;
    }

    /* TOUR IDENTITY */

    .ht-edit-identity {
        display: flex;
        align-items: center;
        gap: 19px;
        min-width: 0;
        margin-bottom: 18px;
        padding: 16px;
        border: 1px solid #dce9d9;
        border-radius: 17px;
        background: linear-gradient(115deg, #fff, #f1f8ec);
        box-shadow: 0 6px 19px rgba(30,77,45,.045);
    }

    .ht-edit-cover {
        flex: 0 0 155px;
        width: 155px;
        height: 112px;
        overflow: hidden;
        border-radius: 12px;
        background: #e9f4e5;
    }

    .ht-edit-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .ht-edit-identity-content {
        flex: 1;
        min-width: 0;
    }

    .ht-edit-identity-top {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 8px;
    }

    .ht-edit-code {
        padding: 6px 9px;
        border-radius: 7px;
        background: #e6f3e6;
        color: #347c51;
        font-size: 10px;
        font-weight: 800;
    }

    .ht-edit-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
    }

    .ht-edit-status.selling {
        color: #20834b;
        background: #dbf3df;
    }

    .ht-edit-status.stopped {
        color: #b47946;
        background: #fff0de;
    }

    .ht-edit-identity h2 {
        margin: 0 0 7px;
        color: #1e563b;
        font-size: 19px;
        font-weight: 800;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .ht-edit-identity p {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin: 0;
        color: #6f8974;
        font-size: 11px;
        line-height: 1.65;
    }

    .ht-edit-identity p i {
        margin-top: 3px;
        color: #dca936;
    }

    /* PANELS */

    .ht-edit-workspace {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
        align-items: start;
        gap: 17px;
    }

    .ht-edit-column {
        display: flex;
        flex-direction: column;
        gap: 17px;
        min-width: 0;
    }

    .ht-edit-panel {
        min-width: 0;
        padding: 20px;
        border: 1px solid var(--ht-border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 5px 17px rgba(29,76,45,.045);
    }

    .ht-edit-wide-panel {
        margin-top: 17px;
    }

    .ht-edit-panel-header {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 18px;
        padding-bottom: 13px;
        border-bottom: 1px solid #eaf0e6;
    }

    .ht-edit-panel-icon {
        display: grid;
        place-items: center;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #e8f5e9;
        color: #2b9259;
        font-size: 15px;
    }

    .ht-edit-panel-icon.yellow {
        color: #be8924;
        background: #fff4d9;
    }

    .ht-edit-panel-header > div {
        flex: 1;
        min-width: 0;
    }

    .ht-edit-panel-header h3 {
        margin: 0 0 3px;
        color: #21573b;
        font-size: 15px;
        font-weight: 800;
    }

    .ht-edit-panel-header p {
        margin: 0;
        color: #87998a;
        font-size: 10px;
        line-height: 1.6;
    }

    /* FORM FIELDS */

    .ht-edit-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 15px 13px;
    }

    .ht-edit-field {
        min-width: 0;
    }

    .ht-edit-field.full {
        grid-column: 1 / -1;
    }

    .ht-edit-field label {
        display: block;
        margin-bottom: 7px;
        color: #3b634a;
        font-size: 11px;
        font-weight: 800;
    }

    .ht-edit-field input,
    .ht-edit-field select,
    .ht-edit-field textarea {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 42px;
        padding: 10px 11px;
        border: 1px solid #dce8db;
        border-radius: 9px;
        outline: none;
        background: #fbfdfa;
        color: #315a42;
        font-size: 12px;
        font-weight: 600;
    }

    .ht-edit-field textarea {
        min-height: 160px;
        line-height: 1.7;
        resize: vertical;
    }

    .ht-edit-field input:focus,
    .ht-edit-field select:focus,
    .ht-edit-field textarea:focus {
        border-color: #62b582;
        box-shadow: 0 0 0 3px rgba(42,153,89,.09);
    }

    .ht-edit-field input[readonly] {
        background: #f0f4ef;
        color: #748b7b;
    }

    .ht-edit-field small {
        display: block;
        margin-top: 6px;
        color: #8b9c8e;
        font-size: 10px;
        line-height: 1.55;
    }

    .ht-edit-error {
        display: block;
        color: #c45c50;
        font-size: 10px;
        margin-top: 5px;
    }

    .ht-edit-money-wrap {
        position: relative;
    }

    .ht-edit-money-wrap input {
        padding-right: 37px;
    }

    .ht-edit-money-wrap > span {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%);
        color: #829a86;
        font-size: 11px;
        font-weight: 800;
        pointer-events: none;
    }

    .ht-edit-price-preview {
        margin-top: 16px;
        padding: 14px 15px;
        border: 1px solid #d7e9d4;
        border-radius: 11px;
        background: linear-gradient(110deg, #edf8e9, #fff9e9);
    }

    .ht-edit-price-preview small {
        display: block;
        margin-bottom: 5px;
        color: #6b9074;
        font-size: 10px;
        font-weight: 800;
    }

    .ht-edit-price-preview strong {
        display: block;
        color: #1f8c52;
        font-size: 24px;
        font-weight: 800;
    }

    .ht-edit-help {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 13px;
        padding: 11px 12px;
        border-radius: 9px;
        background: #fff9e9;
        color: #8d7853;
        font-size: 10px;
        line-height: 1.65;
    }

    .ht-edit-help i {
        margin-top: 2px;
        color: #d4a439;
    }

    /* PRICE MODE - NEW */

    .ht-edit-price-mode {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 16px;
    }

    .ht-edit-mode-option {
        position: relative;
        display: block;
        min-width: 0;
        cursor: pointer;
    }

    .ht-edit-mode-option > input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .ht-edit-mode-card {
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 10px 11px;
        border: 1.5px solid #e0eadc;
        border-radius: 11px;
        background: #fbfdfa;
        color: #668071;
        transition: background .2s, border-color .2s;
    }

    .ht-edit-mode-card > i {
        display: grid;
        place-items: center;
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: #edf4e9;
        color: #579369;
        font-size: 14px;
    }

    .ht-edit-mode-card strong {
        display: block;
        margin-bottom: 3px;
        color: #315b43;
        font-size: 11px;
        font-weight: 800;
    }

    .ht-edit-mode-card small {
        display: block;
        color: #8b9d8e;
        font-size: 9px;
        line-height: 1.5;
    }

    .ht-edit-mode-option > input:checked + .ht-edit-mode-card {
        border-color: #36a267;
        background: #eaf8ec;
    }

    .ht-edit-mode-option > input:focus-visible + .ht-edit-mode-card {
        outline: 3px solid #9ad7af;
        outline-offset: 2px;
    }

    .ht-edit-mode-option > input:checked + .ht-edit-mode-card > i {
        background: #d4efdc;
        color: #238751;
    }

    .ht-edit-price-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        margin: 0 0 12px;
        border-radius: 7px;
        background: #e9f7e8;
        color: #318558;
        font-size: 10px;
        font-weight: 800;
    }

    .ht-edit-price-tag.custom {
        background: #fff3df;
        color: #a77c30;
    }

    .ht-edit-price-mode-note {
        margin-top: 12px;
        color: #87978a;
        font-size: 10px;
        line-height: 1.7;
    }

    .ht-edit-price-mode-note strong {
        color: #367451;
    }

    /* TOPICS */

    .ht-edit-topic-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        color: #257b4b;
        background: #e9f6e9;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .ht-edit-topic-intro {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 15px;
    }

    .ht-edit-topic-intro p {
        margin: 0;
        color: #789180;
        font-size: 11px;
        line-height: 1.6;
    }

    .ht-edit-topic-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0,1fr));
        gap: 11px;
    }

    .ht-edit-topic-option {
        position: relative;
        display: block;
        min-width: 0;
        margin: 0;
        cursor: pointer;
    }

    .ht-edit-topic-option input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .ht-edit-topic-content {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 99px;
        padding: 14px 9px;
        border: 1.5px solid #dfebdd;
        border-radius: 13px;
        color: #496c54;
        background: #fbfdf9;
