        transition: border-color .2s, background .2s, transform .2s;
    }

    .ht-edit-topic-main-icon {
        display: grid;
        place-items: center;
        width: 39px;
        height: 39px;
        border-radius: 11px;
        color: #348e5b;
        background: #eaf5e9;
        font-size: 17px;
    }

    .ht-edit-topic-name {
        font-size: 11px;
        font-weight: 800;
        line-height: 1.45;
    }

    .ht-edit-topic-check {
        display: none;
        position: absolute;
        top: 8px;
        right: 9px;
        color: #268b55;
        font-size: 12px;
    }

    .ht-edit-topic-option:hover .ht-edit-topic-content {
        border-color: #a8d4ae;
        background: #f3faf0;
        transform: translateY(-2px);
    }

    .ht-edit-topic-option input:checked + .ht-edit-topic-content {
        border-color: #2c9b60;
        background: #e9f7e9;
        color: #176e42;
    }

    .ht-edit-topic-option input:checked
    + .ht-edit-topic-content
    .ht-edit-topic-check {
        display: block;
    }

    .ht-edit-topic-option input:focus-visible + .ht-edit-topic-content {
        outline: 3px solid #95d4a8;
        outline-offset: 3px;
    }

    .ht-edit-topic-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 15px;
        padding: 12px 13px;
        border-radius: 10px;
        background: #f4f9f0;
        color: #64816c;
        font-size: 11px;
        line-height: 1.7;
    }

    .ht-edit-topic-note i {
        margin-top: 3px;
        color: #30965f;
    }

    /* IMAGE LIBRARY */

    .ht-edit-drop {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 130px;
        padding: 18px;
        border: 2px dashed #b7d8bc;
        border-radius: 13px;
        background: #f8fcf7;
        cursor: pointer;
        text-align: center;
    }

    .ht-edit-drop:hover {
        background: #eff8ed;
        border-color: #6caf85;
    }

    .ht-edit-drop > i {
        font-size: 23px;
        color: #32935d;
    }

    .ht-edit-drop > strong {
        color: #3e7652;
        font-size: 12px;
    }

    .ht-edit-drop > p {
        margin: 0;
        color: #87998a;
        font-size: 10px;
    }

    .ht-edit-gallery-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin: 18px 0 11px;
    }

    .ht-edit-gallery-title strong {
        color: #315e42;
        font-size: 12px;
    }

    .ht-edit-gallery-title span {
        color: #879b8b;
        font-size: 10px;
    }

    .ht-edit .preview-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 11px;
        margin-top: 0;
    }

    .ht-edit .preview-item {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border: 1px solid #dfebdc;
        border-radius: 11px;
        background: #fff;
    }

    .ht-edit .preview-image {
        height: 112px;
    }

    .ht-edit .preview-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ht-edit .thumbnail-radio {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 34px;
        margin: 0;
        padding: 7px 5px;
        color: #55745e;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
    }

    .ht-edit .thumbnail-radio input {
        accent-color: #2e945d;
    }

    .ht-edit .remove-current-image {
        position: absolute;
        z-index: 3;
        top: 6px;
        right: 6px;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: #dd6254;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
    }

    .ht-edit .preview-item.is-marked-delete {
        opacity: .6;
        border-color: #df7b6d;
    }

    .ht-edit .preview-item.is-marked-delete::after {
        content: "Sẽ xóa khi lưu";
        position: absolute;
        inset: 0;
        z-index: 1;
        display: grid;
        place-items: center;
        background: rgba(112,42,34,.5);
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        pointer-events: none;
    }

    .ht-edit .preview-item.is-marked-delete
    .remove-current-image {
        background: #218d55;
    }

    .ht-edit .preview-box {
        position: relative;
        display: inline-block;
        width: 98px;
        height: 98px;
        margin: 5px;
        cursor: move;
    }

    .ht-edit .preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 9px;
    }

    .ht-edit .preview-box .remove-btn {
        position: absolute;
        top: -7px;
        right: -7px;
        display: grid;
        place-items: center;
        width: 23px;
        height: 23px;
        border-radius: 50%;
        background: #d75f54;
        color: #fff;
        font-size: 11px;
        cursor: pointer;
    }

    /* FOOTER */

    .ht-edit-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 18px;
        padding: 16px 18px;
        border: 1px solid #dce9d9;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 5px 17px rgba(30,76,44,.04);
    }

    .ht-edit-footer p {
        margin: 0;
