</style>

<div class="ht-edit">

    <header class="ht-edit-header">
        <div>
            <span class="ht-edit-eyebrow">
                HAPPYTRIP · TOUR EDITOR
            </span>

            <h1>
                <i class="fa-solid fa-pen-to-square"></i>
                Chỉnh sửa tour
            </h1>

            <p>
                Cập nhật thông tin, giá bán, chủ đề
                và hình ảnh của hành trình.
            </p>
        </div>

        <a asp-controller="QuanTri"
           asp-action="QuanLyTour"
           class="ht-edit-back">
            <i class="fa-solid fa-arrow-left"></i>
            Danh sách tour
        </a>
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="ht-edit-validation"
             role="alert"></div>
    }

    <form asp-controller="QuanTri"
          asp-action="SuaTour"
          method="post"
          enctype="multipart/form-data"
          id="htEditTourForm">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="IdTour" />
        <input type="hidden" asp-for="TrangThai" />

        <!-- CURRENT TOUR -->

        <section class="ht-edit-identity">

            <div class="ht-edit-cover">
                <img src="@coverImage"
                     alt="Ảnh đại diện tour @Model.TenTour" />
            </div>

            <div class="ht-edit-identity-content">
                <div class="ht-edit-identity-top">

                    <span class="ht-edit-code">
                        @Model.MaTour
                    </span>

                    @if (Model.TrangThai)
                    {
                        <span class="ht-edit-status selling">
                            <i class="fa-solid fa-circle"></i>
                            Đang bán
                        </span>
                    }
                    else
                    {
                        <span class="ht-edit-status stopped">
                            <i class="fa-solid fa-circle"></i>
                            Ngưng bán
                        </span>
                    }
                </div>

                <h2>@Model.TenTour</h2>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    <span>@Model.DiaDiem</span>
                </p>
            </div>
        </section>

        <!-- MAIN EDITOR -->

        <div class="ht-edit-workspace">

            <div class="ht-edit-column">

                <!-- BASIC INFORMATION -->

                <section class="ht-edit-panel">

                    <div class="ht-edit-panel-header">
                        <span class="ht-edit-panel-icon">
                            <i class="fa-solid fa-route"></i>
                        </span>

                        <div>
                            <h3>Thông tin hành trình</h3>
                            <p>Điều chỉnh tên, loại và thông tin tour.</p>
                        </div>
                    </div>

                    <div class="ht-edit-form-grid">

                        <div class="ht-edit-field">
                            <label asp-for="MaTour">Mã tour</label>

                            <input asp-for="MaTour" readonly />

                            <small>
                                Mã tour được giữ nguyên khi chỉnh sửa.
                            </small>
                        </div>

                        <div class="ht-edit-field">
                            <label asp-for="IdLoaiTour">Loại tour</label>

                            <select asp-for="IdLoaiTour" required>
                                <option value="">
                                    -- Chọn loại tour --
                                </option>

                                @foreach (var item in loaiTours)
                                {
                                    <option value="@item.IdLoaiTour">
                                        @item.TenLoai
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="IdLoaiTour"
                                  class="ht-edit-error"></span>
                        </div>

                        <div class="ht-edit-field full">
                            <label asp-for="TenTour">Tên tour</label>

                            <input asp-for="TenTour"
                                   maxlength="200"
                                   required />

                            <span asp-validation-for="TenTour"
                                  class="ht-edit-error"></span>
                        </div>

                        <div class="ht-edit-field full">
                            <label asp-for="DiaDiem">
                                Tuyến điểm / Địa điểm
                            </label>

                            <input asp-for="DiaDiem"
                                   maxlength="200"
                                   placeholder="TP.HCM → Phú Quốc" />
                        </div>

                        <div class="ht-edit-field">
                            <label asp-for="ThoiGian">Thời gian</label>

                            <input asp-for="ThoiGian"
                                   maxlength="50"
                                   placeholder="3 ngày 2 đêm" />
                        </div>

                        <div class="ht-edit-field">
                            <label asp-for="PhuongTien">Phương tiện</label>

                            <select asp-for="PhuongTien" required>
                                <option value="">
                                    -- Chọn phương tiện --
                                </option>
                                <option value="Xe du lịch">Xe du lịch</option>
                                <option value="Máy bay">Máy bay</option>
                                <option value="Tàu hỏa">Tàu hỏa</option>
                                <option value="Ca nô">Ca nô</option>
                                <option value="Xe máy">Xe máy</option>
                            </select>
                        </div>

                    </div>
                </section>

                <!-- DESCRIPTION -->

                <section class="ht-edit-panel">

                    <div class="ht-edit-panel-header">
                        <span class="ht-edit-panel-icon">
                            <i class="fa-solid fa-book-open"></i>
                        </span>

                        <div>
                            <h3>Mô tả & nội dung tour</h3>
                            <p>Cập nhật giới thiệu và lịch trình.</p>
