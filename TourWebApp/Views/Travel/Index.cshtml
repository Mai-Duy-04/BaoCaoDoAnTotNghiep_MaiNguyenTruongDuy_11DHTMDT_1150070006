
@model TravelHomeViewModel

@{
    ViewData["Title"] = "Trang chủ";

    var hero = new HeroModel
    {
        Title = "Khám phá hành trình đáng nhớ cùng HappyTrip",
        Subtitle = "Tour chọn lọc, điểm đến nổi bật và trải nghiệm du lịch trọn vẹn trên khắp Việt Nam.",
        PrimaryButtonText = "Khám phá tour",
        PrimaryButtonUrl = "/tours",
        SecondaryButtonText = "Gợi ý tour cho tôi",
        SecondaryButtonUrl = "/goi-y-tour",
        BackgroundImageUrl = "/img/tours/dalat_city.jpg"
    };

    var finalCta = new CtaSectionModel
    {
        Title = "Sẵn sàng cho chuyến đi tiếp theo?",
        Subtitle = "Chọn điểm đến, sở thích và ngân sách để HappyTrip tìm hành trình phù hợp với bạn.",
        PrimaryButtonText = "Gợi ý tour cho tôi",
        PrimaryButtonUrl = "/goi-y-tour",
        SecondaryButtonText = "Xem danh sách tour",
        SecondaryButtonUrl = "/tours",
        BackgroundImageUrl = "/img/home/cta-bg.jpg"
    };
}

<link rel="stylesheet" href="~/css/tour-showcase.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/destination-arc.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home-ai-recommendation.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/happytrip-ai-theme.css" asp-append-version="true" />

<main>
    <partial name="~/Views/Shared/TravelComponents/_Hero.cshtml"
             model="hero" />

    <partial name="~/Views/Shared/TravelComponents/_SearchBar.cshtml" />

    <section class="ht-home-ai-section" aria-labelledby="htHomeAiTitle">
        <div class="container travel-container">

            <div class="ht-home-ai-banner">

                <div class="ht-home-ai-decor ht-home-ai-decor-one"></div>
                <div class="ht-home-ai-decor ht-home-ai-decor-two"></div>

                <div class="ht-home-ai-content">
                    <span class="ht-home-ai-kicker">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        TRỢ LÝ GỢI Ý TOUR HAPPYTRIP
                    </span>

                    <h2 id="htHomeAiTitle">
                        Chưa biết đi đâu?
                        <span>Để Tripi giúp bạn!</span>
                    </h2>

                    <p class="ht-home-ai-description">
                        Không cần tìm kiếm giữa hàng trăm chuyến đi.
                        Chọn điểm đến, sở thích, ngân sách và thời gian
                        để HappyTrip tìm những tour phù hợp với bạn.
                    </p>

                    <div class="ht-home-ai-actions">
                        <a href="/goi-y-tour" class="ht-home-ai-button">
                            Bắt đầu gợi ý tour
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                        <a href="/tours" class="ht-home-ai-secondary">
                            Khám phá tất cả tour
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    </div>

                    <div class="ht-home-ai-benefits">
                        <span>
                            <i class="fa-solid fa-heart"></i>
                            Theo sở thích
                        </span>
                        <span>
                            <i class="fa-solid fa-wallet"></i>
                            Theo ngân sách
                        </span>
                        <span>
                            <i class="fa-solid fa-chart-simple"></i>
                            Xếp hạng phù hợp
                        </span>
                    </div>
                </div>

                <div class="ht-home-ai-visual">
                    <div class="ht-home-ai-orbit ht-home-ai-orbit-one"></div>
                    <div class="ht-home-ai-orbit ht-home-ai-orbit-two"></div>

                    <span class="ht-home-ai-star ht-home-ai-star-one">
                        <i class="fa-solid fa-star"></i>
                    </span>

                    <span class="ht-home-ai-star ht-home-ai-star-two">
                        <i class="fa-solid fa-sparkles"></i>
                    </span>

                    <div class="ht-home-ai-fox">
                        <img src="/img/tripi/tripi-fox.png"
                             alt="Tripi, linh vật cáo cam của HappyTrip"
                             loading="lazy" />
                    </div>

                    <div class="ht-home-ai-shadow"></div>

                    <div class="ht-home-ai-float ht-home-ai-float-one">
                        <i class="fa-solid fa-location-dot"></i>
                        Đúng điểm đến
                    </div>

                    <div class="ht-home-ai-float ht-home-ai-float-two">
                        <i class="fa-solid fa-suitcase-rolling"></i>
                        Chuyến đi của bạn
                    </div>
                </div>

            </div>

        </div>
    </section>

    <partial name="~/Views/Shared/TravelComponents/_DealHot.cshtml" />

    <section class="travel-section">
        <div class="container travel-container">

            <partial name="~/Views/Shared/TravelComponents/_SectionHeading.cshtml"
                     model='new SectionHeadingModel { Kicker = "Vì sao chọn HappyTrip", Title = "Du lịch nhẹ nhàng, trải nghiệm trọn vẹn", Description = "Từ khâu tư vấn đến vận hành tour, mọi thứ đều được thiết kế để bạn chỉ cần tận hưởng chuyến đi.", AlignClass = "text-center" }' />

            <div class="row g-4 mt-1">
                @foreach (var feature in Model.WhyTravelWithUs)
                {
                    <div class="col-lg-3 col-md-6">
                        <article class="feature-card reveal">
                            <i class="@feature.IconClass"></i>
                            <h3>@feature.Title</h3>
                            <p>@feature.Description</p>
                        </article>
                    </div>
                }
            </div>

        </div>
    </section>

    <partial name="~/Views/Shared/TravelComponents/_DestinationArc.cshtml"
             model="Model.FeaturedDestinations" />

    <partial name="~/Views/Shared/TravelComponents/_TourShowcase.cshtml"
             model="Model.PopularTours" />

    <section class="travel-section experience-section">
        <div class="container travel-container">

            <div class="row g-4 align-items-center">

                <div class="col-lg-6">
                    <span class="section-kicker">Trải nghiệm</span>

                    <h2>
                        Đi sâu trải nghiệm, không chỉ đi cho đủ điểm.
                    </h2>

                    <p>
                        HappyTrip ưu tiên trải nghiệm địa phương: food tour,
                        chợ nổi, làng nghề, cung đường thiên nhiên và
                        các hoạt động gắn với văn hóa bản xứ.
                    </p>

                    <a href="/destinations"
                       class="btn travel-btn travel-btn-primary mt-3">
                        Khám phá trải nghiệm
                    </a>
                </div>

                <div class="col-lg-6">
                    <div class="experience-media reveal">
                        <img src="/img/home/biendao.jpg"
                             alt="Trải nghiệm du lịch biển đảo cùng HappyTrip"
                             loading="lazy" />
                    </div>
                </div>

            </div>

        </div>
    </section>

    <section class="travel-section section-cream">
        <div class="container travel-container">

            <partial name="~/Views/Shared/TravelComponents/_SectionHeading.cshtml"
                     model='new SectionHeadingModel { Kicker = "Cẩm nang du lịch", Title = "Mẹo nhanh trước khi lên đường", Description = "Tổng hợp kinh nghiệm thực tế để bạn chuẩn bị tốt hơn cho từng hành trình.", AlignClass = "text-center" }' />

            <div class="guide-grid mt-4">
                @foreach (var post in Model.GuidePosts)
                {
                    <article class="guide-card reveal">

                        <img src="@post.ImageUrl"
                             alt="@post.Title"
                             loading="lazy" />

                        <div class="guide-body">
                            <span class="guide-date">@post.DateLabel</span>
                            <h3>@post.Title</h3>
                            <p>@post.Summary</p>
                            <a href="/">Xem thêm</a>
                        </div>

                    </article>
                }
            </div>

        </div>
    </section>

    <section class="travel-section">
        <div class="container travel-container">

            <partial name="~/Views/Shared/TravelComponents/_SectionHeading.cshtml"
                     model='new SectionHeadingModel { Kicker = "Khách hàng nói gì", Title = "Đánh giá thực tế từ khách đi tour", Description = "Phản hồi từ khách hàng đã trải nghiệm dịch vụ cùng HappyTrip.", AlignClass = "text-center" }' />

            <div class="testimonial-grid mt-4">
                @foreach (var testimonial in Model.Testimonials)
                {
                    <partial name="~/Views/Shared/TravelComponents/_TestimonialCard.cshtml"
                             model="testimonial" />
                }
            </div>

        </div>
    </section>

    <partial name="~/Views/Shared/TravelComponents/_CTASection.cshtml"
             model="finalCta" />
</main>

<script src="~/js/destination-arc.js"
        asp-append-version="true"
        defer></script>

<script src="~/js/tour-showcase.js"
        asp-append-version="true"
        defer></script>
