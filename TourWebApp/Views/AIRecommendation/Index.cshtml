
@model TourWebApp.Controllers.AIRecommendationPageViewModel

@{
    ViewData["Title"] = "Gợi ý tour AI";
    var selectedInterests = (Model.Request.IdSoThich ?? new List<int>()).ToHashSet();
    var hasResults = Model.DaTimKiem && Model.KetQua.Count > 0;
    var hasNoResults = Model.DaTimKiem && Model.KetQua.Count == 0;
}

<link rel="stylesheet" href="~/css/ai-recommendation.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/happytrip-ai-theme.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/gemini-travel.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/gemini-confirm.css" asp-append-version="true" />

<main class="ht-ai-page">
    <div class="ht-ai-container">

        <section class="ht-ai-hero">
            <div class="ht-ai-hero-glow ht-ai-hero-glow-one"></div>
            <div class="ht-ai-hero-glow ht-ai-hero-glow-two"></div>

            <div class="ht-ai-hero-content">
                <span class="ht-ai-hero-kicker">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    HAPPYTRIP AI · TRỢ LÝ DU LỊCH
                </span>

                <h1>
                    Đi đâu cũng vui.
                    <span>Để Tripi giúp bạn!</span>
                </h1>

                <p class="ht-ai-hero-description">
                    Chia sẻ mong muốn bằng tiếng Việt.
                    Gemini sẽ giúp bạn xác định nhu cầu,
                    sau đó HappyTrip tìm những tour phù hợp.
                </p>

                <div class="ht-ai-hero-actions">
                    <a href="#htAiNaturalLanguage" class="ht-ai-hero-primary">
                        Trò chuyện với Tripi
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <a href="#htAiHowItWorks" class="ht-ai-hero-secondary">
                        <i class="fa-solid fa-circle-info"></i>
                        Cách gợi ý hoạt động
                    </a>
                </div>

                <div class="ht-ai-hero-trust">
                    <span>
                        <i class="fa-solid fa-check"></i>
                        Hiểu tiếng Việt
                    </span>

                    <span>
                        <i class="fa-solid fa-check"></i>
                        Theo ngân sách
                    </span>

                    <span>
                        <i class="fa-solid fa-check"></i>
                        Tour trong hệ thống
                    </span>
                </div>
            </div>

            <div class="ht-ai-hero-visual">
                <span class="ht-ai-orbit ht-ai-orbit-one"></span>
                <span class="ht-ai-orbit ht-ai-orbit-two"></span>

                <span class="ht-ai-visual-star ht-ai-visual-star-one">
                    <i class="fa-solid fa-sparkles"></i>
                </span>

                <span class="ht-ai-visual-star ht-ai-visual-star-two">
                    <i class="fa-solid fa-star"></i>
                </span>

                <div class="ht-ai-hero-mascot">
                    <img src="/img/tripi/tripi-fox.png"
                         alt="Tripi, linh vật cáo cam HappyTrip" />
                </div>

                <div class="ht-ai-mascot-shadow"></div>

                <span class="ht-ai-mascot-label">
                    <i class="fa-solid fa-heart"></i>
                    Xin chào! Mình là Tripi
                </span>

                <span class="ht-ai-visual-chip ht-ai-visual-chip-one">
                    <i class="fa-solid fa-location-dot"></i>
                    Khám phá điểm đến
                </span>

                <span class="ht-ai-visual-chip ht-ai-visual-chip-two">
                    <i class="fa-solid fa-route"></i>
                    Hành trình của bạn
                </span>
            </div>
        </section>

        <section class="ht-ai-steps" id="htAiHowItWorks">
            <div class="ht-ai-step">
                <span class="ht-ai-step-icon ht-ai-step-purple">
                    <i class="fa-solid fa-comment-dots"></i>
                </span>

                <div>
                    <h3>Chia sẻ mong muốn</h3>
                    <p>Nhập câu tiếng Việt hoặc chọn tiêu chí thủ công.</p>
                </div>
            </div>

            <div class="ht-ai-step">
                <span class="ht-ai-step-icon ht-ai-step-peach">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </span>

                <div>
                    <h3>Gemini phân tích</h3>
                    <p>Xác định điểm đến, sở thích, ngân sách và thời gian.</p>
                </div>
            </div>

            <div class="ht-ai-step">
                <span class="ht-ai-step-icon ht-ai-step-blue">
                    <i class="fa-solid fa-suitcase-rolling"></i>
                </span>

                <div>
                    <h3>Matching Score</h3>
                    <p>Tính điểm, xếp hạng và giải thích tour phù hợp.</p>
                </div>
            </div>
        </section>

        <section class="ht-ai-natural" id="htAiNaturalLanguage">
            <div class="ht-ai-natural-heading">
                <span class="ht-ai-section-kicker">
                    <i class="fa-solid fa-sparkles"></i>
                    GEMINI AI
                </span>

                <h2>Hãy kể Tripi nghe chuyến đi bạn muốn</h2>

                <p>
                    Không cần điền từng tiêu chí.
                    Gemini sẽ hỗ trợ phân tích yêu cầu trước khi tìm tour.
                </p>
            </div>

            <div class="ht-ai-natural-card">
                @Html.AntiForgeryToken()

                <label for="htAiNaturalInput">
                    Bạn đang muốn trải nghiệm chuyến đi như thế nào?
                </label>

                <textarea id="htAiNaturalInput"
                          rows="3"
                          maxlength="1000"
                          placeholder="Ví dụ: Mình muốn đi Tây Ninh 3 ngày, thích văn hóa, ngân sách khoảng 3 triệu."></textarea>

                <div class="ht-ai-natural-bottom">
                    <span>
                        <i class="fa-solid fa-shield-heart"></i>
                        Chỉ gửi nội dung yêu cầu du lịch để phân tích.
                    </span>

                    <button type="button"
                            id="htAiNaturalSubmit"
                            class="ht-ai-natural-submit">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        Phân tích với Gemini
                    </button>
                </div>

                <div class="ht-ai-natural-examples">
                    <span>Thử nhanh:</span>

                    <button type="button"
                            class="ht-ai-example"
                            data-example="Mình muốn đi Tây Ninh 3 ngày, thích văn hóa, ngân sách 3 triệu.">
                        Tây Ninh · Văn hóa · 3 triệu
                    </button>

                    <button type="button"
                            class="ht-ai-example"
                            data-example="Tôi muốn du lịch Côn Đảo, thích biển đảo, khoảng 3 ngày, chi tối đa 3 triệu đồng.">
                        Côn Đảo · Biển đảo
                    </button>
                </div>

                <div id="htAiNaturalMessage"
                     class="ht-ai-natural-message"
                     aria-live="polite"
                     hidden></div>

                <section id="htAiConfirm"
                         class="ht-ai-confirm"
                         aria-labelledby="htAiConfirmTitle"
                         hidden>

                    <div class="ht-ai-confirm-header">
                        <div class="ht-ai-confirm-icon">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </div>

                        <div class="ht-ai-confirm-heading">
                            <span>TRIPI ĐÃ PHÂN TÍCH XONG</span>

                            <h3 id="htAiConfirmTitle">
                                Đây có phải chuyến đi bạn đang tìm?
                            </h3>

                            <p>
                                Kiểm tra các thông tin trước khi
                                xem tour phù hợp nhé!
                            </p>
                        </div>
                    </div>

                    <div class="ht-ai-confirm-grid">
                        <div class="ht-ai-confirm-item">
                            <span class="ht-ai-confirm-item-icon">
                                <i class="fa-solid fa-location-dot"></i>
                            </span>

                            <div>
                                <span class="ht-ai-confirm-label">
                                    Điểm đến
                                </span>

                                <strong id="htAiConfirmDestination">
                                    Chưa lựa chọn
                                </strong>
                            </div>
                        </div>

                        <div class="ht-ai-confirm-item">
                            <span class="ht-ai-confirm-item-icon">
                                <i class="fa-solid fa-heart"></i>
                            </span>

                            <div>
                                <span class="ht-ai-confirm-label">
                                    Sở thích
                                </span>

                                <strong id="htAiConfirmInterests">
                                    Chưa lựa chọn
                                </strong>
                            </div>
                        </div>

                        <div class="ht-ai-confirm-item">
                            <span class="ht-ai-confirm-item-icon">
                                <i class="fa-solid fa-wallet"></i>
                            </span>

                            <div>
                                <span class="ht-ai-confirm-label">
                                    Ngân sách tối đa
                                </span>

                                <strong id="htAiConfirmBudget">
                                    Không giới hạn
                                </strong>
                            </div>
                        </div>

                        <div class="ht-ai-confirm-item">
                            <span class="ht-ai-confirm-item-icon">
                                <i class="fa-regular fa-calendar-days"></i>
                            </span>

                            <div>
                                <span class="ht-ai-confirm-label">
                                    Thời gian
                                </span>

                                <strong id="htAiConfirmDays">
                                    Không giới hạn
                                </strong>
                            </div>
                        </div>
                    </div>

                    <div class="ht-ai-confirm-actions">
                        <button type="button"
                                id="htAiConfirmSearch"
                                class="ht-ai-confirm-primary">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Xem tour phù hợp
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>

                        <button type="button"
                                id="htAiConfirmEdit"
                                class="ht-ai-confirm-secondary">
                            <i class="fa-solid fa-sliders"></i>
                            Điều chỉnh tiêu chí
                        </button>
                    </div>

                    <p class="ht-ai-confirm-note">
                        <i class="fa-solid fa-circle-info"></i>
                        Gemini hỗ trợ nhận diện nhu cầu.
                        Kết quả tour sẽ được tính bằng Matching Score
                        từ dữ liệu HappyTrip.
                    </p>
                </section>
            </div>
        </section>

        <section class="ht-ai-workspace">
            <div class="ht-ai-workspace-heading">
                <span class="ht-ai-section-kicker">
                    <i class="fa-solid fa-sliders"></i>
                    XÁC NHẬN NHU CẦU
                </span>

                <h2>Chuyến đi của bạn, lựa chọn của bạn.</h2>

                <p>
                    Kiểm tra hoặc điều chỉnh các tiêu chí trước khi tìm tour.
                </p>
            </div>

            <div class="ht-ai-layout">
                <aside class="ht-ai-sidebar" id="htAiForm">
                    <form method="get"
                          action="/goi-y-tour"
                          class="ht-ai-form"
                          id="htAiRecommendationForm">

                        <div class="ht-ai-form-heading">
                            <span class="ht-ai-form-icon">
                                <i class="fa-solid fa-compass"></i>
                            </span>

                            <div>
                                <h3>Thiết kế chuyến đi</h3>
                                <p>Thông tin dùng để tính Matching Score.</p>
                            </div>
                        </div>

                        <div class="ht-ai-field">
                            <label for="IdDiemDen">
                                <i class="fa-solid fa-location-dot"></i>
                                Điểm đến mong muốn
                            </label>

                            <select id="IdDiemDen" name="IdDiemDen">
                                <option value="">Khám phá mọi điểm đến</option>

                                @foreach (var dd in Model.DiemDens)
                                {
                                    <option value="@dd.Id"
                                            selected="@(Model.Request.IdDiemDen == dd.Id)">
                                        @dd.Ten
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="ht-ai-field">
                            <label>
                                <i class="fa-solid fa-heart"></i>
                                Bạn thích trải nghiệm gì?
                            </label>

                            <p class="ht-ai-field-hint">
                                Có thể chọn nhiều sở thích.
                            </p>

                            <div class="ht-ai-interests">
                                @foreach (var st in Model.SoThichs)
                                {
                                    <label class="ht-ai-interest">
                                        <input type="checkbox"
                                               name="IdSoThich"
                                               value="@st.Id"
                                               checked="@selectedInterests.Contains(st.Id)" />

                                        <span>@st.Ten</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="ht-ai-field">
                            <label for="NganSachToiDa">
                                <i class="fa-solid fa-wallet"></i>
                                Ngân sách tối đa (VNĐ)
                            </label>

                            <input type="number"
                                   id="NganSachToiDa"
                                   name="NganSachToiDa"
                                   min="1"
                                   step="1"
                                   placeholder="Ví dụ: 3000000"
                                   value="@Model.Request.NganSachToiDa" />
                        </div>

                        <div class="ht-ai-field">
                            <label for="SoNgayToiDa">
                                <i class="fa-regular fa-calendar"></i>
                                Số ngày tối đa
                            </label>

                            <input type="number"
                                   id="SoNgayToiDa"
                                   name="SoNgayToiDa"
                                   min="1"
                                   max="365"
                                   placeholder="Ví dụ: 3"
                                   value="@Model.Request.SoNgayToiDa" />
                        </div>

                        <div class="ht-ai-field">
                            <label for="TopN">
                                <i class="fa-solid fa-list-ol"></i>
                                Số tour muốn xem
                            </label>

                            <select id="TopN" name="TopN">
                                <option value="3"
                                        selected="@(Model.Request.TopN == 3)">
                                    Top 3 tour
                                </option>

                                <option value="5"
                                        selected="@(Model.Request.TopN == 5)">
                                    Top 5 tour
                                </option>

                                <option value="10"
                                        selected="@(Model.Request.TopN == 10)">
                                    Top 10 tour
                                </option>
                            </select>
                        </div>

                        <button type="submit"
                                name="tim"
                                value="1"
                                id="htAiSubmit"
                                class="ht-ai-submit">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Tìm hành trình của tôi
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>

                        <a href="/goi-y-tour" class="ht-ai-reset">
                            <i class="fa-solid fa-rotate-left"></i>
                            Làm mới lựa chọn
                        </a>
                    </form>
                </aside>

                <section class="ht-ai-results"
                         aria-label="Kết quả gợi ý tour">

                    <div class="ht-ai-results-header">
                        <div>
                            <span class="ht-ai-results-kicker">
                                <i class="fa-solid fa-sparkles"></i>
                                DÀNH RIÊNG CHO BẠN
                            </span>

                            <h2>Hành trình phù hợp</h2>
                        </div>

                        @if (Model.DaTimKiem)
                        {
                            <span class="ht-ai-results-count">
                                @Model.KetQua.Count tour
                            </span>
                        }
                    </div>

                    <div id="htAiLoading"
                         class="ht-ai-loading"
                         hidden
                         role="status"
                         aria-live="polite">

                        <div class="ht-ai-state-mascot">
                            <img src="/img/tripi/tripi-fox.png"
                                 alt="Tripi đang tìm kiếm tour" />
                        </div>

                        <div class="ht-ai-thinking-dots"
                             aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <h3>Tripi đang tìm tour cho bạn...</h3>

                        <p>
                            Đang đối chiếu với dữ liệu tour HappyTrip.
                        </p>
                    </div>

                    <div id="htAiResultContent">

                        @if (!string.IsNullOrWhiteSpace(Model.ThongBao))
                        {
                            <div class="ht-ai-notice"
                                 role="status">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>@Model.ThongBao</span>
                            </div>
                        }

                        @if (!Model.DaTimKiem)
                        {
                            <div class="ht-ai-empty">
                                <div class="ht-ai-empty-visual">
                                    <i class="fa-solid fa-paper-plane"></i>

                                    <span class="ht-ai-empty-spark">
                                        <i class="fa-solid fa-sparkles"></i>
                                    </span>
                                </div>

                                <span class="ht-ai-empty-label">
                                    HÀNH TRÌNH CỦA BẠN
                                </span>

                                <h3>
                                    Mọi chuyến đi đều bắt đầu từ một ý tưởng.
                                </h3>

                                <p>
                                    Hãy kể Tripi nghe mong muốn của bạn,
                                    hoặc chọn trực tiếp các tiêu chí bên trái
                                    để khám phá tour phù hợp.
                                </p>

                                <div class="ht-ai-empty-tags">
                                    <span>
                                        <i class="fa-solid fa-location-dot"></i>
                                        Điểm đến
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-heart"></i>
                                        Sở thích
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-wallet"></i>
                                        Ngân sách
                                    </span>
                                </div>
                            </div>
                        }
                        else if (hasResults)
                        {
                            <div class="ht-ai-success">
                                <span class="ht-ai-success-icon">
                                    <i class="fa-solid fa-circle-check"></i>
                                </span>

                                <div>
                                    <strong>
                                        Tripi đã tìm thấy @Model.KetQua.Count tour cho bạn!
                                    </strong>

                                    <p>
                                        Các tour được xếp hạng theo điểm phù hợp.
                                    </p>
                                </div>
                            </div>

                            <div class="ht-ai-list">
                                @foreach (var tour in Model.KetQua)
                                {
                                    <article class="ht-ai-tour-card">

                                        <div class="ht-ai-tour-image">
                                            <img src="@TourImagePathHelper.ToTourImageSrc(tour.HinhAnh)"
                                                 alt="Tour @tour.TenTour"
                                                 loading="lazy" />

                                            <span class="ht-ai-match-badge">
                                                <i class="fa-solid fa-sparkles"></i>
                                                @tour.MatchingScore/100 điểm
                                            </span>
                                        </div>

                                        <div class="ht-ai-tour-content">

                                            <div class="ht-ai-tour-meta">
                                                <span>
                                                    <i class="fa-solid fa-location-dot"></i>
                                                    @tour.DiaDiem
                                                </span>

                                                <span>
                                                    <i class="fa-regular fa-clock"></i>
                                                    @tour.ThoiGian
                                                </span>
                                            </div>

                                            <h3>@tour.TenTour</h3>

                                            <div class="ht-ai-score-breakdown">
                                                <div>
                                                    <span>Sở thích</span>
                                                    <strong>@tour.DiemSoThich/50</strong>
                                                </div>

                                                <div>
                                                    <span>Điểm đến</span>
                                                    <strong>@tour.DiemDiemDen/30</strong>
                                                </div>

                                                <div>
                                                    <span>Ngân sách</span>
                                                    <strong>@tour.DiemNganSach/20</strong>
                                                </div>
                                            </div>

                                            <div class="ht-ai-score-track">
                                                <div style="width:@(tour.MatchingScore)%"></div>
                                            </div>

                                            <div class="ht-ai-reasons">
                                                @foreach (var reason in tour.LyDoGoiY)
                                                {
                                                    <p>
                                                        <i class="fa-solid fa-check"></i>
                                                        @reason
                                                    </p>
                                                }
                                            </div>

                                            <div class="ht-ai-tour-footer">
                                                <div class="ht-ai-price">
                                                    <span>GIÁ TOUR TỪ</span>

                                                    <strong>
                                                        @tour.GiaBan.ToString("N0")đ
                                                    </strong>
                                                </div>

                                                <a asp-controller="Tour"
                                                   asp-action="ChiTiet"
                                                   asp-route-id="@tour.IdTour"
                                                   class="ht-ai-detail">
                                                    Xem chi tiết
                                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                </a>
                                            </div>

                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        else if (hasNoResults)
                        {
                            <div class="ht-ai-empty ht-ai-no-results">
                                <div class="ht-ai-empty-visual">
                                    <i class="fa-regular fa-face-frown-open"></i>
                                </div>

                                <h3>
                                    Tripi chưa tìm được tour phù hợp
                                </h3>

                                <p>
                                    Bạn thử tăng ngân sách,
                                    thay đổi điểm đến hoặc
                                    chọn số ngày nhiều hơn nhé!
                                </p>

                                <a href="#htAiForm"
                                   class="ht-ai-try-again">
                                    <i class="fa-solid fa-sliders"></i>
                                    Điều chỉnh lựa chọn
                                </a>
                            </div>
                        }

                        <p class="ht-ai-disclaimer">
                            Điểm phù hợp được tính theo tiêu chí và
                            trọng số của hệ thống, không phải xác suất
                            dự đoán sở thích. Lịch khởi hành và chỗ trống
                            cần kiểm tra tại trang chi tiết tour.
                        </p>
                    </div>
                </section>
            </div>
        </section>

    </div>
</main>

<script src="~/js/gemini-travel.js"
        asp-append-version="true"
        defer></script>
