</style>

@section Scripts {

    <script src="~/js/countdown.js"
            asp-append-version="true"></script>

    <script>
        (function () {
            "use strict";

            // Giữ nguyên hàm countdown.js đang dùng trong website
            if (typeof startCountdown === "function") {
                startCountdown(
                    "@Model.HanThanhToan",
                    "countdown"
                );
            }

            // Sao chép mã booking
            const copyButton =
                document.getElementById("htCopyBooking");

            if (copyButton) {
                copyButton.addEventListener("click", async function () {
                    const code =
                        document.getElementById(
                            "htPaymentBookingCode"
                        )?.textContent?.trim();

                    if (!code) return;

                    try {
                        await navigator.clipboard.writeText(code);

                        this.innerHTML =
                            '<i class="fa-solid fa-check"></i>';

                        this.title = "Đã sao chép";
                    } catch {
                        this.title = "Không thể sao chép";
                    }
                });
            }

            // Chặn bấm liên tục để tránh tạo nhiều yêu cầu VNPay
            const form = document.getElementById("htVnpayForm");
            const button = document.getElementById("htVnpayButton");

            if (form && button) {
                form.addEventListener("submit", function (event) {
                    if (form.dataset.submitted === "true") {
                        event.preventDefault();
                        return;
                    }

                    form.dataset.submitted = "true";
                    button.disabled = true;
                    button.style.opacity = "0.7";
                    button.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Đang chuyển đến VNPay...';
                });
            }
        })();
    </script>
}
