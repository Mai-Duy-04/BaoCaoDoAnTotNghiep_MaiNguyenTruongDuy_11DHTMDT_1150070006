<script>
    (function () {
        "use strict";

        const copyButton = document.getElementById("scrapCopyV2");
        const codeElement = document.getElementById("scrapCodeV2");

        if (!copyButton || !codeElement) return;

        copyButton.addEventListener("click", async function () {
            const bookingCode = codeElement.textContent.trim();

            try {
                await navigator.clipboard.writeText(bookingCode);

                copyButton.innerHTML =
                    '<i class="fa-solid fa-check"></i>';

                copyButton.title = "Đã sao chép";
            } catch {
                copyButton.title = "Không thể sao chép";
            }
        });
    })();
</script>
