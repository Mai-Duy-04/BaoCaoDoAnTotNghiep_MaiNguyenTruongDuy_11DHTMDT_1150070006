
@model TourWebApp.Data.Models.DonDatTour
@using System

@{
    ViewData["Title"] = "Vé hành trình | HappyTrip";

    var tenTour = Model.IdTourNavigation?.TenTour ?? "Tour du lịch";
    var diaDiem = Model.IdTourNavigation?.DiaDiem ?? "Việt Nam";

    var anhTour = TourImagePathHelper.ToTourImageSrc(
        Model.IdTourNavigation?.HinhAnh
    );

    var ngayDi = Model.IdLichNavigation?
        .NgayKhoiHanh.ToString("dd/MM/yyyy")
        ?? "Đang cập nhật";

    var tongKhach = Model.NguoiLon + Model.TreEm + Model.TreNho;

    var tongGoc = Model.TongTien;
    var giamGia = Model.SoTienGiam ?? 0m;
    var thanhToan = Math.Max(
        0m,
        Model.TongTienSauGiam ?? (tongGoc - giamGia)
    );

    var daThanhToan = Model.DaThanhToan;
    var token = ViewBag.CheckInToken as string;

    var checkinUrl = daThanhToan && !string.IsNullOrWhiteSpace(token)
        ? Url.Action(
            "ScanCheckIn",
            "QuanLyDon",
            new { token },
            Context.Request.Scheme)
        : null;

    var qrUrl = !string.IsNullOrWhiteSpace(checkinUrl)
        ? "https://api.qrserver.com/v1/create-qr-code/" +
          "?size=320x320&margin=10&data=" +
          Uri.EscapeDataString(checkinUrl)
        : null;
}

<div class="scrap-v2">

    <!-- TRANG TRÍ NỀN -->
    <div class="scrap-decor leaves-left" aria-hidden="true">
        <i class="fa-solid fa-leaf"></i>
        <i class="fa-solid fa-leaf"></i>
        <i class="fa-solid fa-leaf"></i>
    </div>

    <div class="scrap-decor leaves-right" aria-hidden="true">
        <i class="fa-solid fa-leaf"></i>
        <i class="fa-solid fa-leaf"></i>
    </div>

    <div class="scrap-stamp-v2" aria-hidden="true">
        <i class="fa-solid fa-plane"></i>
        <span>HAPPYTRIP</span>
        <strong>CONFIRMED</strong>
    </div>

    <!-- HEADER -->
    <header class="scrap-hero-v2">
        <div class="scrap-logo-v2">
            <i class="fa-solid fa-paper-plane"></i>
            HappyTrip
        </div>

        <div class="scrap-eyebrow-v2">
            BOOKING CONFIRMATION
        </div>

        <h1>
            @(daThanhToan
                ? "THANH TOÁN THÀNH CÔNG"
                : "THÔNG TIN ĐẶT TOUR")
        </h1>

        <div class="scrap-brush-v2"></div>

        <p>
            <i class="fa-solid fa-circle-check"></i>
            @(daThanhToan
                ? "Hành trình của bạn đã được xác nhận!"
                : "Đơn đang chờ xác nhận thanh toán.")
        </p>
    </header>

    <!-- BỘ SƯU TẬP SCRAPBOOK -->
    <div class="scrap-stage-v2">

        <!-- POSTCARD BÊN TRÁI -->
        <aside class="scrap-side-v2 left">

            <div class="scrap-polaroid-v2">
                <div class="scrap-tape-v2"></div>

                <div class="scrap-polaroid-photo">
                    @if (!string.IsNullOrWhiteSpace(anhTour))
                    {
                        <img src="@anhTour"
                             alt="Ảnh postcard hành trình"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="scrap-photo-placeholder">
                            <i class="fa-solid fa-umbrella-beach"></i>
                        </div>
                    }
                </div>

                <strong>Travel memories ♡</strong>
                <span>HAPPYTRIP POSTCARD</span>
            </div>

            <div class="scrap-sticker-v2 left-sticker">
                <i class="fa-solid fa-camera-retro"></i>
                <span>CAPTURE THE MOMENT</span>
            </div>

            <div class="scrap-sticker-v2 beach-sticker">
                <span class="beach-emoji">🌴</span>
                <strong>VACATION MODE</strong>
            </div>

        </aside>

        <!-- VÉ CHÍNH -->
        <main class="scrap-main-ticket-v2">

            <div class="scrap-ticket-head-v2">
                <div class="scrap-ticket-brand-v2">
                    <i class="fa-solid fa-paper-plane"></i>
                    HappyTrip
                </div>

                <div class="scrap-ticket-name-v2">
                    BOARDING PASS
                </div>
            </div>

            <div class="scrap-ticket-content-v2">

                <!-- TÊN TOUR -->
                <div class="scrap-tour-top-v2">
                    <div class="scrap-tour-name-v2">
                        <span>TOUR DU LỊCH</span>
                        <h2>@tenTour</h2>
                    </div>

                    <div class="scrap-booking-v2">
                        <span>BOOKING REF.</span>

                        <strong id="scrapCodeV2">
                            @Model.MaBooking
                        </strong>

                        <button type="button"
                                id="scrapCopyV2"
                                aria-label="Sao chép mã booking">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>
                </div>

                <!-- ẢNH HÀNH TRÌNH -->
                <div class="scrap-tour-photo-v2">
                    @if (!string.IsNullOrWhiteSpace(anhTour))
                    {
                        <img src="@anhTour"
                             alt="@tenTour"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="scrap-photo-placeholder">
                            <i class="fa-solid fa-umbrella-beach"></i>
                            <span>Khám phá Việt Nam cùng HappyTrip</span>
                        </div>
                    }

                    <div class="scrap-photo-gradient"></div>

                    <span class="scrap-photo-location">
                        <i class="fa-solid fa-location-dot"></i>
                        @diaDiem
                    </span>

                    <div class="scrap-photo-corner">
                        <i class="fa-solid fa-plane"></i>
                        LET'S GO!
                    </div>
                </div>

                <!-- THÔNG TIN CHUYẾN ĐI -->
                <div class="scrap-detail-grid-v2">

                    <div>
                        <i class="fa-regular fa-calendar-days"></i>
                        <span>
                            <small>NGÀY KHỞI HÀNH</small>
                            <strong>@ngayDi</strong>
                        </span>
                    </div>

                    <div>
                        <i class="fa-solid fa-users"></i>
                        <span>
                            <small>HÀNH KHÁCH</small>
                            <strong>@tongKhach khách</strong>
                            <em>
                                @Model.NguoiLon NL,
                                @Model.TreEm TE,
                                @Model.TreNho EB
                            </em>
                        </span>
                    </div>

                    <div>
                        <i class="fa-solid fa-location-dot"></i>
                        <span>
                            <small>ĐIỂM ĐẾN</small>
                            <strong>@diaDiem</strong>
                        </span>
                    </div>

                </div>

                <!-- GIÁ -->
                <div class="scrap-price-grid-v2">

                    <div>
                        <small>TỔNG TIỀN GỐC</small>
                        <strong>@tongGoc.ToString("N0") đ</strong>
                    </div>

                    <div>
                        <small>GIẢM GIÁ</small>
                        <strong>-@giamGia.ToString("N0") đ</strong>
                    </div>

                    <div class="scrap-price-final-v2">
                        <small>TỔNG THANH TOÁN</small>
                        <strong>@thanhToan.ToString("N0") đ</strong>
                    </div>

                </div>

                <!-- THÔNG TIN THANH TOÁN -->
                <div class="scrap-payment-grid-v2">

                    <div>
                        <i class="fa-regular fa-credit-card"></i>
                        <span>
                            <small>THANH TOÁN LÚC</small>
                            <strong>
                                @(Model.NgayThanhToan?.ToString(
                                    "HH:mm dd/MM/yyyy"
                                ) ?? "Chưa xác nhận")
                            </strong>
                        </span>
                    </div>

                    <div>
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>
                            <small>PHƯƠNG THỨC</small>
                            <strong>
                                @(Model.PhuongThucTT ?? "Chưa cập nhật")
                            </strong>
                        </span>
                    </div>

                </div>

                <!-- ĐƯỜNG XÉ VÉ -->
                <div class="scrap-cut-v2">
                    <span></span>
                    <i class="fa-solid fa-plane"></i>
                    <span></span>
                </div>

                <!-- CHECK-IN -->
                <div class="scrap-checkin-v2">

                    <div class="scrap-checkin-info-v2">
                        <span class="scrap-checkin-label">
                            YOUR ELECTRONIC TRAVEL PASS
                        </span>

                        <h3>THE CHECK-IN</h3>

                        <p>
                            Xuất trình mã QR tại điểm tập trung
                            để nhân viên xác nhận tham gia tour.
                        </p>

                        <div class="scrap-booking-bottom-v2">
                            <small>BOOKING NUMBER</small>
                            <strong>@Model.MaBooking</strong>
                        </div>

                        <div class="scrap-travel-stamps">
                            <span>
                                <i class="fa-solid fa-plane-departure"></i>
                                READY TO GO
                            </span>

                            <span>
                                <i class="fa-solid fa-suitcase-rolling"></i>
                                HAPPY JOURNEY
                            </span>
                        </div>
                    </div>

                    <div class="scrap-qr-area-v2">
                        <div class="scrap-qr-box-v2">
                            @if (!string.IsNullOrWhiteSpace(qrUrl))
                            {
                                <img src="@qrUrl"
                                     alt="QR Check-in @Model.MaBooking" />
                            }
                            else
                            {
                                <div class="scrap-qr-unavailable">
                                    <i class="fa-solid fa-lock"></i>
                                    <span>QR chưa khả dụng</span>
                                </div>
                            }
                        </div>

                        <small>SCAN TO CHECK IN</small>
                    </div>

                </div>

            </div>

            <div class="scrap-ticket-foot-v2">
                <span>
                    <i class="fa-solid fa-paper-plane"></i>
                    READY FOR YOUR NEXT JOURNEY
                </span>

                <span>HAPPYTRIP · VIETNAM</span>
            </div>

        </main>

        <!-- POSTCARD BÊN PHẢI -->
        <aside class="scrap-side-v2 right">

            <div class="scrap-polaroid-v2 second">
                <div class="scrap-tape-v2"></div>

                <div class="scrap-passport-art">
                    <div class="scrap-passport-circle">
                        <i class="fa-solid fa-plane"></i>
                        <span>HAPPYTRIP</span>
                        <strong>EXPLORE</strong>
                    </div>

                    <div class="scrap-flight-path"></div>

                    <i class="fa-solid fa-compass scrap-compass-art"></i>
                </div>

                <strong>Explore more ✈</strong>
                <span>COLLECT MOMENTS</span>
            </div>

            <div class="scrap-luggage-tag">
                <div class="scrap-tag-hole"></div>
                <i class="fa-solid fa-suitcase-rolling"></i>
                <strong>ADVENTURE</strong>
                <span>IS CALLING!</span>
            </div>

            <div class="scrap-sticker-v2 right-sticker">
                <span>☀️</span>
                <strong>HELLO SUNSHINE</strong>
            </div>

        </aside>

    </div>

    <!-- NÚT -->
    <div class="scrap-actions-v2">

        <a href="/" class="scrap-action-v2 outline">
            <i class="fa-solid fa-house"></i>
            Về trang chủ
        </a>

        <a asp-controller="TaiKhoan"
           asp-action="DonCuaToi"
           class="scrap-action-v2 primary">
            <i class="fa-solid fa-ticket"></i>
            Xem đơn đặt tour của tôi
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </div>

    <p class="scrap-ending-v2">
        <i class="fa-solid fa-heart"></i>
        Mỗi hành trình là một câu chuyện.
        Cảm ơn bạn đã chọn HappyTrip!
    </p>

</div>

<style>
    .scrap-v2 {
        --sc-green: #07513e;
        --sc-deep: #053c30;
        --sc-gold: #e6b449;
        --sc-paper: #fff7e8;
        font-family: "Be Vietnam Pro", Arial, sans-serif;
        color: #153e31;
        position: relative;
        isolation: isolate;
        background:
            radial-gradient(circle at 0 15%,
                rgba(241,207,135,.28),transparent 30%),
            radial-gradient(circle at 100% 75%,
                rgba(26,156,138,.25),transparent 34%),
            repeating-linear-gradient(
                30deg,
                rgba(42,81,52,.017) 0 1px,
                transparent 1px 5px
            ),
            linear-gradient(140deg,#f7efe0,#d0ebe3);
        padding: 30px 18px 45px;
        overflow: hidden;
    }

    .scrap-v2 * {
        box-sizing: border-box;
    }

    /* HEADER */

    .scrap-hero-v2 {
        position: relative;
        z-index: 2;
        text-align: center;
        margin: 0 auto 30px;
        max-width: 1000px;
    }

    .scrap-logo-v2 {
        color: #064333;
        font-size: 29px;
        font-weight: 900;
        margin-bottom: 14px;
    }

    .scrap-logo-v2 i {
        margin-right: 8px;
        color: #167e53;
    }

    .scrap-eyebrow-v2 {
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 3px;
        color: #4a7660;
        margin-bottom: 13px;
    }

    .scrap-hero-v2 h1 {
        color: #074633;
        font-family: "Be Vietnam Pro", Arial, sans-serif;
        font-size: clamp(30px,4vw,52px);
        font-weight: 900;
        letter-spacing: -1px;
        line-height: 1.25;
        margin: 0;
        overflow-wrap: normal;
        word-break: normal;
    }

    .scrap-brush-v2 {
        width: 240px;
        height: 7px;
        background: #efb637;
        border-radius: 70%;
        transform: rotate(-2deg);
        margin: 14px auto;
    }

    .scrap-hero-v2 p {
        font-size: 15px;
        color: #315f48;
        font-weight: 700;
        margin: 0;
    }

    .scrap-hero-v2 p i {
        color: #16834b;
        margin-right: 7px;
    }

    /* NỀN STICKER */

    .scrap-decor {
        position: absolute;
        z-index: -1;
        display: flex;
        gap: 3px;
        pointer-events: none;
        color: #2a805a;
        opacity: .35;
    }

    .scrap-decor i {
        font-size: 105px;
    }

    .leaves-left {
        top: 0;
        left: -80px;
        transform: rotate(145deg);
    }

    .leaves-right {
        right: -80px;
        bottom: 120px;
        transform: rotate(-35deg);
    }

    .scrap-stamp-v2 {
        position: absolute;
        z-index: 0;
        top: 80px;
        right: 7%;
        width: 112px;
        height: 112px;
        border: 4px double #1d6a51;
        border-radius: 50%;
        transform: rotate(17deg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        color: #1d6a51;
        opacity: .45;
    }

    .scrap-stamp-v2 i {
        font-size: 23px;
    }

    .scrap-stamp-v2 span,
    .scrap-stamp-v2 strong {
        font-size: 9px;
    }

    /* VÙNG VÉ */

    .scrap-stage-v2 {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns:
            minmax(0,1fr)
            minmax(0,850px)
            minmax(0,1fr);
        align-items: center;
        max-width: 1450px;
        margin: 0 auto;
    }

    .scrap-main-ticket-v2 {
        min-width: 0;
        background:
            repeating-linear-gradient(
                0deg,
                rgba(87,69,39,.015) 0 1px,
                transparent 1px 4px
            ),
            linear-gradient(130deg,#fffaf0,#f6ecda);
        box-shadow: 0 20px 45px rgba(41,57,42,.19);
        border-radius: 3px;
        position: relative;
        z-index: 2;
    }

    .scrap-main-ticket-v2::after {
        content: "";
        display: block;
        position: absolute;
        left: 0;
        right: 0;
        bottom: -11px;
        height: 12px;
        background:
            linear-gradient(-45deg,
                transparent 8px,
                #e4e8d9 0) 0 0/16px 16px,
            linear-gradient(45deg,
                transparent 8px,
                #e4e8d9 0) 0 0/16px 16px;
        pointer-events: none;
    }

    .scrap-ticket-head-v2 {
        min-height: 76px;
        background: linear-gradient(100deg,#054739,#0b6b53);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        color: white;
        padding: 19px 29px;
    }

    .scrap-ticket-brand-v2 {
        font-size: 24px;
        font-weight: 900;
    }

    .scrap-ticket-brand-v2 i {
        color: #ffdb8d;
        margin-right: 6px;
    }

    .scrap-ticket-name-v2 {
        font-size: 16px;
        font-weight: 900;
        letter-spacing: 3px;
        color: #ffe7b0;
    }

    .scrap-ticket-content-v2 {
        padding: 26px 29px 20px;
        min-width: 0;
    }

    /* SỬA TRIỆT ĐỂ LỖI TÊN TOUR */

    .scrap-tour-top-v2 {
        display: grid;
        grid-template-columns: minmax(0,1fr) 185px;
        gap: 20px;
        align-items: start;
        margin-bottom: 21px;
    }

    .scrap-tour-name-v2 {
        min-width: 0;
    }

    .scrap-tour-name-v2 > span {
        display: block;
        font-size: 11px;
        font-weight: 800;
        color: #5b8067;
        letter-spacing: 1.5px;
        margin-bottom: 10px;
    }

    .scrap-tour-name-v2 h2 {
        display: block;
        font-family: "Be Vietnam Pro", Arial, sans-serif !important;
        font-size: clamp(20px,2.1vw,27px) !important;
        font-weight: 800 !important;
        line-height: 1.55 !important;
        letter-spacing: normal !important;
        word-spacing: normal !important;
        text-align: left !important;
        text-transform: none !important;
        word-break: normal !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
        color: #073e30;
        margin: 0 !important;
        max-width: 100%;
    }

    .scrap-booking-v2 {
        min-width: 0;
        padding-left: 15px;
        border-left: 2px dashed #b9bba8;
    }

    .scrap-booking-v2 > span {
        display: block;
        font-size: 10px;
        font-weight: 800;
        color: #64826c;
        margin-bottom: 8px;
    }

    .scrap-booking-v2 strong {
        display: block;
        background: #f6dc9e;
        color: #084b36;
        font-size: 12px;
        padding: 9px;
        overflow-wrap: anywhere;
    }

    .scrap-booking-v2 button {
        margin-top: 8px;
        background: transparent;
        border: 0;
        color: #147c51;
        cursor: pointer;
    }

    /* ẢNH TOUR */

    .scrap-tour-photo-v2 {
        height: 260px;
        width: 100%;
        min-width: 0;
        overflow: hidden;
        position: relative;
        border: 8px solid #fffdf7;
        box-shadow: 0 6px 18px rgba(27,63,45,.15);
        background: #dcefe7;
    }

    .scrap-tour-photo-v2 > img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .scrap-photo-placeholder {
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 11px;
        align-items: center;
        justify-content: center;
        background: #daeee5;
        color: #3d8864;
        text-align: center;
        font-size: 12px;
    }

    .scrap-photo-placeholder i {
        font-size: 45px;
    }

    .scrap-photo-gradient {
        position: absolute;
        inset: 45% 0 0;
        background: linear-gradient(
            transparent,rgba(2,45,35,.57)
        );
        pointer-events: none;
    }

    .scrap-photo-location {
        position: absolute;
        left: 18px;
        right: 18px;
        bottom: 15px;
        color: white;
        font-size: 15px;
        font-weight: 800;
        text-shadow: 0 2px 7px #063a2e;
    }

    .scrap-photo-corner {
        position: absolute;
        top: 13px;
        right: 13px;
        border-radius: 20px;
        background: #ffda75;
        color: #14563c;
        font-size: 9px;
        font-weight: 900;
        padding: 8px 11px;
        transform: rotate(7deg);
    }

    /* THÔNG TIN */

    .scrap-detail-grid-v2 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        padding: 24px 0;
        border-bottom: 1px dashed #b0b8a6;
    }

    .scrap-detail-grid-v2 > div {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        min-width: 0;
    }

    .scrap-detail-grid-v2 > div + div {
        border-left: 1px dashed #b0b8a6;
        padding-left: 12px;
    }

    .scrap-detail-grid-v2 i {
        color: #08674a;
        font-size: 21px;
        margin-top: 4px;
        flex-shrink: 0;
    }

    .scrap-detail-grid-v2 span {
        display: block;
        min-width: 0;
    }

    .scrap-detail-grid-v2 small {
        display: block;
        font-size: 9px;
        font-weight: 800;
        color: #65816e;
        margin-bottom: 6px;
    }

    .scrap-detail-grid-v2 strong {
        display: block;
        font-size: 14px;
        line-height: 1.5;
        color: #0b4735;
        overflow-wrap: break-word;
    }

    .scrap-detail-grid-v2 em {
        display: block;
        font-size: 9px;
        color: #879488;
        margin-top: 4px;
        font-style: normal;
    }

    /* GIÁ */

    .scrap-price-grid-v2 {
        display: grid;
        grid-template-columns: 1fr 1fr 1.35fr;
        margin: 21px 0 10px;
        background: #f3f3e7;
        border-radius: 8px;
        overflow: hidden;
    }

    .scrap-price-grid-v2 > div {
        text-align: center;
        padding: 17px 8px;
        min-width: 0;
    }

    .scrap-price-grid-v2 > div + div {
        border-left: 1px dashed #d3d7c5;
    }

    .scrap-price-grid-v2 small {
        display: block;
        color: #64806c;
        font-size: 10px;
        font-weight: 800;
        margin-bottom: 9px;
    }

    .scrap-price-grid-v2 strong {
        display: block;
        color: #104935;
        font-size: 16px;
        overflow-wrap: anywhere;
    }

    .scrap-price-grid-v2 .scrap-price-final-v2 {
        background: linear-gradient(100deg,#105c44,#087054);
    }

    .scrap-price-final-v2 small {
        color: #e5d79e;
    }

