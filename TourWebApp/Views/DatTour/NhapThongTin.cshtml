@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            "use strict";

            const prices = {
                NguoiLon: Number(
                    "@Model.GiaNguoiLon.ToString(inv)"
                ),
                TreEm: Number(
                    "@Model.GiaTreEm.ToString(inv)"
                ),
                EmBe: Number(
                    "@Model.GiaEmBe.ToString(inv)"
                )
            };

            const ids = ["NguoiLon", "TreEm", "EmBe"];

            const formatter = new Intl.NumberFormat("vi-VN", {
                maximumFractionDigits: 0
            });

            function money(amount) {
                return formatter.format(amount) + " đ";
            }

            function count(id) {
                const input = document.getElementById(id);
                const min = id === "NguoiLon" ? 1 : 0;

                if (!input) return min;

                const raw = Number(input.value);

                if (!Number.isFinite(raw)) return min;

                return Math.max(min, Math.trunc(raw));
            }

            function updateSummary() {
                const adult = count("NguoiLon");
                const child = count("TreEm");
                const baby = count("EmBe");

                const guests = adult + child + baby;

                const amount =
                    adult * prices.NguoiLon +
                    child * prices.TreEm +
                    baby * prices.EmBe;

                document.getElementById(
                    "htTourGuestCount"
                ).textContent = guests;

                document.getElementById(
                    "htSummaryGuests"
                ).textContent = guests + " khách";

                document.getElementById(
                    "htGuestDescription"
                ).textContent =
                    adult + " người lớn, " +
                    child + " trẻ em, " +
                    baby + " em bé";

                document.getElementById(
                    "htSubtotal"
                ).textContent = money(amount);

                document.getElementById(
                    "htGrandTotal"
                ).textContent = money(amount);

                document.getElementById(
                    "htDiscount"
                ).textContent = "0 đ";

                const totalInput = document.getElementById("TongTien");

                if (totalInput) {
                    totalInput.value = String(amount);
                }

                const voucher = document.getElementById(
                    "MaPhieuGiamGia"
                );

                const hasVoucher =
                    voucher && voucher.value.trim().length > 0;

                document.getElementById(
                    "htPriceNote"
                ).textContent = hasVoucher
                    ? "Tạm tính chưa trừ voucher. Hệ thống sẽ kiểm tra mã và tính lại tổng tiền khi tạo đơn."
                    : "Giá được tính theo số khách và xác nhận lại khi tạo đơn.";

                document.querySelectorAll(
                    "[data-count]"
                ).forEach(button => {
                    const id = button.dataset.count;
                    const min = id === "NguoiLon" ? 1 : 0;

                    button.disabled =
                        Number(button.dataset.delta) < 0 &&
                        count(id) <= min;
                });
            }

            document.querySelectorAll(
                "[data-count]"
            ).forEach(button => {
                button.addEventListener("click", function () {
                    const id = this.dataset.count;
                    const input = document.getElementById(id);
                    const delta = Number(this.dataset.delta);

                    if (!input) return;

                    const min = id === "NguoiLon" ? 1 : 0;

                    input.value = Math.max(
                        min,
                        count(id) + delta
                    );

                    updateSummary();
                });
            });

            ids.forEach(id => {
                const input = document.getElementById(id);
                if (!input) return;

                input.addEventListener("input", updateSummary);

                input.addEventListener("change", function () {
                    this.value = count(id);
                    updateSummary();
                });
            });

            document.getElementById(
                "MaPhieuGiamGia"
            )?.addEventListener("input", updateSummary);

            document.getElementById(
                "htBookingForm"
            )?.addEventListener("submit", function () {
                ids.forEach(id => {
                    const input = document.getElementById(id);

                    if (input) {
                        input.value = count(id);
                    }
                });

                updateSummary();
            });

            updateSummary();
        })();
    </script>
}
