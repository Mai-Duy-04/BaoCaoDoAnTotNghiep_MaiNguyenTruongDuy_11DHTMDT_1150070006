
@model TourWebApp.Models.ViewModels.NhapThongTinVM
@using System.Globalization

@{
    ViewData["Title"] = "Thông tin đặt tour | HappyTrip";

    var user = ViewBag.User as TourWebApp.Data.Models.TaiKhoan;

    var danhSachVoucher =
        ViewBag.DanhSachMaPhieuDaLuu as List<string>
        ?? new List<string>();

    var tenTour = Model.TenTour ?? "Tour du lịch";

    var anhTour = ViewBag.AnhTour as string;

    var anhTourSrc = string.IsNullOrWhiteSpace(anhTour)
        ? ""
        : TourImagePathHelper.ToTourImageSrc(anhTour);

    var hoTen = !string.IsNullOrWhiteSpace(Model.HoTen)
        ? Model.HoTen
        : user?.HoTen ?? "";

    var sdt = !string.IsNullOrWhiteSpace(Model.SDT)
        ? Model.SDT
        : user?.SoDienThoai ?? "";

    var email = !string.IsNullOrWhiteSpace(Model.Email)
        ? Model.Email
        : user?.Email ?? "";

    var tongKhach =
        Model.NguoiLon + Model.TreEm + Model.EmBe;

    var inv = CultureInfo.InvariantCulture;
}

<div class="ht-booking-v2">

    <!-- HERO + TIEN TRINH DAT TOUR -->
    <section class="htb-hero">
        <div class="container">

            <div class="htb-heading">
                <div>
                    <span class="htb-eyebrow">
                        HAPPYTRIP · BƯỚC 2/3
                    </span>

                    <h1>Thông tin đặt tour</h1>

                    <p>
                        Điền thông tin liên hệ và kiểm tra
                        số lượng khách trước khi thanh toán.
                    </p>
                </div>
            </div>

            <div class="htb-steps" aria-label="Tiến trình đặt tour">

                <div class="htb-step completed">
                    <span class="htb-step-number">
                        <i class="fa-solid fa-check"></i>
                    </span>

                    <span>1. Chọn tour</span>
                </div>

                <span class="htb-step-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <div class="htb-step active"
                     aria-current="step">
                    <span class="htb-step-number">2</span>
                    <span>2. Thông tin đặt tour</span>
                </div>

                <span class="htb-step-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <div class="htb-step upcoming">
                    <span class="htb-step-number">3</span>
                    <span>3. Thanh toán</span>
                </div>

            </div>
        </div>
    </section>

    <div class="container htb-container">

        @if (TempData["Error"] != null)
        {
            <div class="htb-alert error" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i>
                @TempData["Error"]
            </div>
        }

        <form asp-controller="DatTour"
              asp-action="TaoDonVaChuyenSangThanhToan"
              method="post"
              id="htBookingForm">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdTour" />
            <input type="hidden" asp-for="IdLich" />

            <input type="hidden" asp-for="GiaNguoiLon" />
            <input type="hidden" asp-for="GiaTreEm" />
            <input type="hidden" asp-for="GiaEmBe" />
            <input type="hidden" asp-for="TongTien" />

            <div asp-validation-summary="ModelOnly"
                 class="htb-validation text-danger"></div>

            <div class="htb-layout">

                <!-- COT TRAI -->
                <main class="htb-main">

                    <!-- THONG TIN TOUR -->
                    <section class="htb-card htb-tour-section">

                        <div class="htb-card-heading">
                            <span class="htb-heading-icon">
                                <i class="fa-solid fa-suitcase-rolling"></i>
                            </span>

                            <div>
                                <h2>Tour đã chọn</h2>
                            </div>
                        </div>

                        <div class="htb-tour-box">

                            <div class="htb-tour-image">
                                @if (!string.IsNullOrWhiteSpace(anhTourSrc))
                                {
                                    <img src="@anhTourSrc"
                                         alt="@tenTour"
                                         loading="lazy"
                                         onerror="this.style.display='none';this.parentElement.classList.add('htb-image-empty');" />
                                }
                                else
                                {
                                    <div class="htb-fallback">
                                        <i class="fa-solid fa-umbrella-beach"></i>
                                    </div>
                                }
                            </div>

                            <div class="htb-tour-info">
                                <span class="htb-overline">
                                    HÀNH TRÌNH ĐÃ CHỌN
                                </span>

                                <h3>@tenTour</h3>

                                <div class="htb-tour-meta">

                                    <span>
                                        <i class="fa-regular fa-calendar-days"></i>
                                        @Model.NgayKhoiHanh.ToString("dd/MM/yyyy")
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-users"></i>
                                        <strong id="htTourGuestCount">
                                            @tongKhach
                                        </strong>
                                        khách
                                    </span>

                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- THONG TIN LIEN HE -->
                    <section class="htb-card">

                        <div class="htb-card-heading">
                            <span class="htb-heading-icon">
                                <i class="fa-regular fa-address-card"></i>
                            </span>

                            <div>
                                <h2>Thông tin liên hệ</h2>
                                <p>Thông tin người đại diện đặt tour</p>
                            </div>
                        </div>

                        <div class="htb-fields">

                            <div class="htb-field">
                                <label for="HoTen">
                                    Họ và tên <em>*</em>
                                </label>

                                <div class="htb-input-wrap">
                                    <i class="fa-regular fa-user"></i>

                                    <input asp-for="HoTen"
                                           value="@hoTen"
                                           placeholder="Nhập họ và tên"
                                           autocomplete="name"
                                           required />
                                </div>

                                <span asp-validation-for="HoTen"
                                      class="text-danger small"></span>
                            </div>

                            <div class="htb-field">
                                <label for="SDT">
                                    Số điện thoại <em>*</em>
                                </label>

                                <div class="htb-input-wrap">
                                    <i class="fa-solid fa-phone"></i>

                                    <input asp-for="SDT"
                                           type="tel"
                                           value="@sdt"
                                           placeholder="Nhập số điện thoại"
                                           autocomplete="tel"
                                           required />
                                </div>

                                <span asp-validation-for="SDT"
                                      class="text-danger small"></span>
                            </div>

                            <div class="htb-field">
                                <label for="Email">
                                    Email <em>*</em>
                                </label>

                                <div class="htb-input-wrap">
                                    <i class="fa-regular fa-envelope"></i>

                                    <input asp-for="Email"
                                           type="email"
                                           value="@email"
                                           placeholder="Nhập email nhận thông báo"
                                           autocomplete="email"
                                           required />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>
                            </div>

                            <div class="htb-field">
                                <label for="DiaChiLienHe">
                                    Địa chỉ liên hệ
                                    <small>(không bắt buộc)</small>
                                </label>

                                <div class="htb-input-wrap">
                                    <i class="fa-solid fa-location-dot"></i>

                                    <input asp-for="DiaChiLienHe"
                                           maxlength="255"
                                           placeholder="Số nhà, đường, phường/xã..."
                                           autocomplete="street-address" />
                                </div>

                                <span asp-validation-for="DiaChiLienHe"
                                      class="text-danger small"></span>
                            </div>

                            <div class="htb-field full">
                                <label for="GhiChu">
                                    Ghi chú
                                    <small>(không bắt buộc)</small>
                                </label>

                                <textarea asp-for="GhiChu"
                                          rows="2"
                                          placeholder="Ăn chay, hỗ trợ trẻ nhỏ hoặc yêu cầu đặc biệt..."></textarea>

                                <span asp-validation-for="GhiChu"
                                      class="text-danger small"></span>
                            </div>

                        </div>
                    </section>

                    <!-- SO LUONG KHACH -->
                    <section class="htb-card">

                        <div class="htb-card-heading">
                            <span class="htb-heading-icon">
                                <i class="fa-solid fa-users"></i>
                            </span>

                            <div>
                                <h2>Số lượng hành khách</h2>
                                <p>Điều chỉnh số khách trước khi xác nhận đặt tour</p>
                            </div>
                        </div>

                        <div class="htb-counter-grid">

                            <div class="htb-counter-card">
                                <div class="htb-counter-label">
                                    <strong>Người lớn</strong>

                                    <small>
                                        @Model.GiaNguoiLon.ToString("N0") đ/người
                                    </small>
                                </div>

                                <div class="htb-counter-control">
                                    <button type="button"
                                            data-count="NguoiLon"
                                            data-delta="-1"
                                            aria-label="Giảm người lớn">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>

                                    <input asp-for="NguoiLon"
                                           type="number"
                                           min="1"
                                           inputmode="numeric"
                                           aria-label="Số người lớn" />

                                    <button type="button"
                                            data-count="NguoiLon"
                                            data-delta="1"
                                            aria-label="Tăng người lớn">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="htb-counter-card">
                                <div class="htb-counter-label">
                                    <strong>Trẻ em</strong>

                                    <small>
                                        @Model.GiaTreEm.ToString("N0") đ/người
                                    </small>
                                </div>

                                <div class="htb-counter-control">
                                    <button type="button"
                                            data-count="TreEm"
                                            data-delta="-1"
                                            aria-label="Giảm trẻ em">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>

                                    <input asp-for="TreEm"
                                           type="number"
                                           min="0"
                                           inputmode="numeric"
                                           aria-label="Số trẻ em" />

                                    <button type="button"
                                            data-count="TreEm"
                                            data-delta="1"
                                            aria-label="Tăng trẻ em">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="htb-counter-card">
                                <div class="htb-counter-label">
                                    <strong>Em bé</strong>

                                    <small>
                                        @Model.GiaEmBe.ToString("N0") đ/người
                                    </small>
                                </div>

                                <div class="htb-counter-control">
                                    <button type="button"
                                            data-count="EmBe"
                                            data-delta="-1"
                                            aria-label="Giảm em bé">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>

                                    <input asp-for="EmBe"
                                           type="number"
                                           min="0"
                                           inputmode="numeric"
                                           aria-label="Số em bé" />

                                    <button type="button"
                                            data-count="EmBe"
                                            data-delta="1"
                                            aria-label="Tăng em bé">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                        </div>

                        <div class="htb-hint">
                            <i class="fa-solid fa-circle-info"></i>

                            Giá thay đổi theo số khách.
                            Số chỗ còn lại sẽ được kiểm tra
                            trước khi tạo đơn.
                        </div>
                    </section>

                    <!-- UU DAI VA THANH TOAN -->
                    <section class="htb-card">

                        <div class="htb-card-heading">
                            <span class="htb-heading-icon">
                                <i class="fa-solid fa-tags"></i>
                            </span>

                            <div>
                                <h2>Ưu đãi & thanh toán</h2>
                                <p>Chọn mã ưu đãi và phương thức thanh toán</p>
                            </div>
                        </div>

                        <div class="htb-fields">

                            <div class="htb-field">
                                <label for="MaPhieuGiamGia">
                                    Mã giảm giá
                                </label>

                                <div class="htb-input-wrap">
                                    <i class="fa-solid fa-ticket"></i>

                                    <input asp-for="MaPhieuGiamGia"
                                           list="htSavedVoucherList"
                                           placeholder="Nhập mã, VD: HAPPY20"
                                           autocomplete="off"
                                           style="text-transform:uppercase" />
                                </div>

                                <datalist id="htSavedVoucherList">
                                    @foreach (var ma in danhSachVoucher)
                                    {
                                        <option value="@ma"></option>
                                    }
                                </datalist>

                                <span asp-validation-for="MaPhieuGiamGia"
                                      class="text-danger small"></span>

                                <a class="htb-voucher-link"
                                   href="/TaiKhoan/KhoPhieuGiamGia"
                                   target="_blank"
                                   rel="noopener">
                                    <i class="fa-solid fa-gift"></i>
                                    Mở kho voucher của tôi
                                </a>
                            </div>

                            <div class="htb-field">
                                <label for="PhuongThucThanhToan">
                                    Phương thức thanh toán <em>*</em>
                                </label>

                                <div class="htb-input-wrap">
                                    <i class="fa-regular fa-credit-card"></i>

                                    <select asp-for="PhuongThucThanhToan"
                                            required>
                                        <option value="VNPAY">
                                            VNPay (thanh toán online)
                                        </option>

                                        <option value="TienMat">
                                            Tiền mặt (chờ xác nhận)
                                        </option>
                                    </select>
                                </div>
                            </div>

                        </div>

                        <div class="htb-hint">
                            <i class="fa-solid fa-shield-halved"></i>

                            VNPay hỗ trợ thanh toán trực tuyến.
                            Với tiền mặt, đơn sẽ chờ xác nhận thu tiền.
                        </div>

                    </section>
                </main>

                <!-- COT PHAI: TOM TAT -->
                <aside class="htb-sidebar">
                    <section class="htb-summary">

                        <div class="htb-summary-header">
                            <i class="fa-solid fa-clipboard-list"></i>
                            <h2>Tóm tắt đơn đặt tour</h2>
                        </div>

                        <div class="htb-summary-body">

                            <div class="htb-summary-tour">
                                <div class="htb-summary-photo">
                                    @if (!string.IsNullOrWhiteSpace(anhTourSrc))
                                    {
                                        <img src="@anhTourSrc"
                                             alt="@tenTour"
                                             loading="lazy"
                                             onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-umbrella-beach"></i>
                                    }
                                </div>

                                <div>
                                    <strong>@tenTour</strong>

                                    <small>
                                        <i class="fa-regular fa-calendar"></i>
                                        @Model.NgayKhoiHanh.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>

                            <div class="htb-summary-row">
                                <span>Ngày khởi hành</span>
                                <strong>
                                    @Model.NgayKhoiHanh.ToString("dd/MM/yyyy")
                                </strong>
                            </div>

                            <div class="htb-summary-row">
                                <span>Số lượng khách</span>
                                <strong id="htSummaryGuests">
                                    @tongKhach khách
                                </strong>
                            </div>

                            <div class="htb-summary-guests"
                                 id="htGuestDescription">
                                @Model.NguoiLon người lớn,
                                @Model.TreEm trẻ em,
                                @Model.EmBe em bé
                            </div>

                            <div class="htb-summary-divider"></div>

                            <div class="htb-summary-row">
                                <span>Tạm tính</span>
                                <strong id="htSubtotal">
                                    @Model.TongTien.ToString("N0") đ
                                </strong>
                            </div>

                            <div class="htb-summary-row">
                                <span>Giảm giá</span>
                                <strong id="htDiscount">0 đ</strong>
                            </div>

                            <div class="htb-total">
                                <span>Tổng thanh toán dự kiến</span>

                                <strong id="htGrandTotal">
                                    @Model.TongTien.ToString("N0") đ
                                </strong>
                            </div>

                            <p class="htb-summary-note"
                               id="htPriceNote">
                                Voucher sẽ được kiểm tra và
                                tính lại khi tạo đơn.
                            </p>

                            <button type="submit"
                                    class="htb-submit"
                                    id="htSubmitBooking">
                                <i class="fa-solid fa-lock"></i>
                                Tiếp tục thanh toán
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>

                            <div class="htb-trust-row">
                                <span>
                                    <i class="fa-solid fa-shield-halved"></i>
                                    Bảo mật
                                </span>

                                <span>
                                    <i class="fa-solid fa-headset"></i>
                                    Hỗ trợ
                                </span>

                                <span>
                                    <i class="fa-solid fa-receipt"></i>
                                    Minh bạch
                                </span>
                            </div>

                        </div>
                    </section>
                </aside>

            </div>
        </form>
    </div>
</div>

<style>
    .ht-booking-v2 {
        --ht-green: #176b43;
        --ht-deep: #1e4834;
        --ht-cream: #f7f5ee;
        --ht-border: #e5e9df;
        --ht-muted: #819184;
        background: var(--ht-cream);
        color: #2b4737;
        font-family: "Be Vietnam Pro", Arial, sans-serif;
        padding-bottom: 34px;
    }

    .ht-booking-v2 *,
    .ht-booking-v2 *::before,
    .ht-booking-v2 *::after {
        box-sizing: border-box;
    }

    .htb-hero {
        padding: 27px 0 48px;
        background:
            radial-gradient(
                ellipse at 90% 0%,
                rgba(139, 200, 164, .22),
                transparent 50%
            ),
            linear-gradient(120deg, #fbf8f1, #eef4eb);
    }

    .htb-eyebrow {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #26804e;
    }

    .htb-heading h1 {
        margin: 9px 0 6px;
        font-size: clamp(25px, 2.8vw, 36px);
        font-weight: 800;
        color: var(--ht-deep);
    }

    .htb-heading p {
        margin: 0;
        font-size: 12px;
        line-height: 1.7;
        color: #667f6e;
    }

    .htb-steps {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
        max-width: 1120px;
    }

    .htb-step {
        flex: 1;
        min-width: 0;
        min-height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 10px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }

    .htb-step-number {
        width: 23px;
        height: 23px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: 1px solid currentColor;
        font-size: 11px;
        flex-shrink: 0;
    }

    .htb-step.completed {
        background: #e1f1e5;
        color: #15713e;
    }

    .htb-step.completed .htb-step-number {
        background: #168149;
        border-color: #168149;
        color: white;
    }

    .htb-step.active {
        background: #177348;
        color: white;
        box-shadow: 0 6px 15px rgba(23, 115, 72, .15);
    }

    .htb-step.active .htb-step-number {
        background: white;
        color: #177348;
        border-color: white;
    }

    .htb-step.upcoming {
        background: #e8eee9;
        color: #687c6e;
    }

    .htb-step-arrow {
        color: #698271;
        font-size: 12px;
        flex-shrink: 0;
    }

    .htb-container {
        margin-top: 0;
        padding-top: 20px;
    }

    .htb-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.58fr) minmax(300px, 1fr);
        gap: 20px;
        align-items: start;
    }

    .htb-main {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 0;
    }

    .htb-card,
    .htb-summary {
        background: #fff;
        border: 1px solid var(--ht-border);
        border-radius: 17px;
        box-shadow: 0 7px 23px rgba(42, 73, 45, .045);
    }

    .htb-card {
        padding: 19px;
    }

    .htb-card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 17px;
    }

    .htb-card-heading h2 {
        margin: 0;
        color: #214b36;
        font-size: 15px;
        font-weight: 800;
    }

    .htb-card-heading p {
        margin: 4px 0 0;
        font-size: 10px;
        color: #91a095;
    }

    .htb-heading-icon {
        width: 37px;
        height: 37px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 10px;
        color: #267f4d;
        background: #eaf4eb;
        font-size: 15px;
    }

    .htb-tour-section {
        padding: 15px;
    }

    .htb-tour-section .htb-card-heading {
        margin-bottom: 12px;
    }

    .htb-tour-box {
        display: flex;
        gap: 17px;
        align-items: center;
        border: 1px solid #edf0e8;
        border-radius: 12px;
        padding: 9px;
    }

    .htb-tour-image {
        width: 215px;
        height: 120px;
        flex-shrink: 0;
        border-radius: 10px;
        overflow: hidden;
        background: #e8f1e8;
    }

    .htb-tour-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .htb-image-empty::after {
        content: "Ảnh tour";
        display: grid;
        place-items: center;
        height: 100%;
        font-size: 12px;
        color: #6b957b;
    }

    .htb-fallback {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        font-size: 36px;
        color: #79ae8a;
    }

    .htb-tour-info {
        flex: 1;
        min-width: 0;
    }

    .htb-overline {
        font-size: 9px;
        color: #4c9165;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .htb-tour-info h3 {
        font-size: 16px;
        font-weight: 800;
        line-height: 1.6;
        color: #214b36;
        margin: 9px 0 12px;
    }

    .htb-tour-meta {
